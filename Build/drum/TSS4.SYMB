	LDA 0,X; JAZ W3; STA UNO,B
	LDA CNT,B; AAA 1; SAT 12; SAX 1; COPY DD SX; SAX 2
	JPL I (SPACE; LDX (MS1; JPL I (MSG
	LDA UNO,B; JAN W4; LDX PTR,B; JPL I (USARR; JMP W3
	JPL I (SOUT; JPL I (CRLF
W3,	MIN CNT,B; LDA CNT,B; AAA -NTTY; JAN W2
	MIN LREG,B; RET
W4,	LDX (MS2; JPL I (MSG; JMP W3
	)FILL
	)PCL WHOS


