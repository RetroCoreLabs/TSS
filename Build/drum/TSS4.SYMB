%RETURN

	PROGM

	GOVER OV8,E1,EXAM
	DATA FIL,1
	DATA V1,1
	DATA V2,1
E1,	ENTER
	COPY DB SX; LDT I 9CMD; SAA 20; JPL I (PCF; JMP ESS; STA V1,B
	LDT I 9CMD; JPL I (TRIM
	LDX I 9CMD; JPL I (LEN; SKP IF DD UEQ 0; JMP E4
	LDT I 9CMD; SAA 20; JPL I (PCF; JMP ESS; STA V2,B; JMP E2
E4,	LDA I V1,B; SAT 10; JPL I (IOUT; JPL I (CRLF
ESS,	MIN LREG,B; JMP EFF
E2,	LDX V1,B; LDT V2,B; SKP IF DT GRE SX; JMP EFF
	SAA 1; JPL I (PRETY; JMP ESS
EFF,	RET
9CMD,	CMDLN
	)FILL
	)PCL EXAM

	OVERX QOV8


	OVERL OV9


%DELFC
%DELETE A FILE FROM THE COMMAND TELETYPE
%DELETE-FILE  FILENAME
%RETURN

	PROGM

	GOVER OV9,D1,DELFC
	DATA PTR,1
	DATA XTR,5
	DATA XTRX,24
	DATA FPTR,1
	DATA UPTR,1
	DATA FSTR,5
	DATA USTR,5
	DATA FSTRX,14
	DATA USTRX,7
	DATA UNUM,1
	DATA MBUF,40
MS1,	'AMBIGUOUS$\ '

D1,	ENTER
	COPY DB SX; JPL I (WHUSR; STA UNUM,B
	STSET FPTR,FSTR,FSTRX,30
	STSET UPTR,USTR,USTRX,16
	STSET PTR,XTR,XTRX,50
	LDT I (CMDLN; LDX PTR,B; SAA 1; JPL I (PCF; JMP DSS
	LDX PTR,B; JPL I (GCI; JMP DFF
	SAT ##(; SKP IF DA EQL ST; JMP D6
D2,	LDX PTR,B; JPL I (GCI; JMP DFF
	SAT ##); SKP IF DA UEQ ST; JMP D3
	LDX UPTR,B; JPL I (WCI; JMP DFF; JMP D2
D3,	LDX UPTR,B; JPL I (LEN; SKP IF DD EQL 0; JMP D4
	SAA 1; STA UNUM,B; JMP D5
D4,	LDX UPTR,B; LDT (USARR; SAA 1; COPY DD SA
	JPL I (ABLKP; JMP DF1; STA UNUM,B
D5,	LDX PTR,B; JPL I (GCI; JMP D7
D6,	SAT ##:; SKP IF DA UEQ ST; SAA ##-
	LDX FPTR,B; JPL I (WCI; JMP DFF; JMP D5
D7,	LDX FPTR,B; LDA UNUM,B; COPY DD SA; SAA 1
	SAT MBUF; RADD DT SB; JPL I (FILE; JMP DF2
	COPY DX ST; SAA 0; JPL I (DLFIL; JMP DFX
DSS,	MIN LREG,B
DFF,	RET
DF1,	AAA -2; JAZ DF3; SAA 4; JMP DFX
DF2,	AAA -2; JAZ DF3; SAA 10; JMP DFX
DFX,	JPL I (ERMSG; JMP DSS
DF3,	LDX (MS1; JPL I (MSG; JMP DSS
	)FILL
	)PCL DELFC


%DKSP
%LIST AMOUNT OF DISK SPACE LEFT
%RETURN

	PROGM

	GOVER OV9,D1,DKSP
	DATA CNT,1
	DATA MCNT,1
	DATA TCNT,1
	DATA CNTX,1
MS1,	' TRACKS (\ '
MS2,	'K WORDS)\ '
MS3,	' LEFT OUT OF \ '

D1,	ENTER
	COPY DB SX; STZ CNT,B; STZ TCNT,B
	SAA 0; JPL I (BSIZ; STA MCNT,B
	SAA 0; JPL I (RBITB; JMP *-2
D2,	LDX (BITBL; LDT I CNT,B,X; STZ CNTX,B
D3,	BSKP ZRO 0 DT; MIN TCNT,B; SHT SHR 1
	MIN CNTX,B; LDA CNTX,B; AAA -20; JAN D3
	MIN CNT,B; LDA CNT,B; SUB MCNT,B; JAN D2
	STZ I (BITBL-3
	LDA TCNT,B; SAT 12; JPL I (IOUT
	LDX (MS1; JPL I (MSG
	LDA TCNT,B; SHA 1; SAT 12; JPL I (IOUT
	LDX (MS2; JPL I (MSG; LDX (MS3; JPL I (MSG
	LDA MCNT,B; SHA 4; SAT 12; JPL I (IOUT
	LDX (MS1; JPL I (MSG
	LDA MCNT,B; SHA 5; SAT 12; JPL I (IOUT
	LDX (MS2; JPL I (MSG; JPL I (CRLF
	MIN LREG,B; RET
	)FILL
	)PCL DKSP


%ALKAT
%ALLOCATE AN ABSOLUTE FILE
%ALLOCATE  FILENAME,TRACK ADDRESS,NUMBER OF TRACKS (OCTAL)
%RETURN

	PROGM

	GOVER OV9,A1,ALKAT
	DATA PTR,1
	DATA XTR,5
	DATA XTRX,20
	DATA FNUM,1
	DATA DKAD,1
	DATA DKSZ,1
MS1,	'YOU ARE NOT AUTHORIZED TO DO THIS$\ '

A1,	ENTER
	COPY DB SX; JPL I (LOCK
	JPL I (WHUSR; AAA -1; JAF AF1
	STSET PTR,XTR,XTRX,40
	LDT I (CMDLN; LDX PTR,B; SAA 1; JPL I (PCF; JMP ASS
	LDT I (CMDLN; SAA 21; JPL I (PCF; JMP ASS; STA DKAD,B
	LDT I (CMDLN; SAA 22; JPL I (PCF; JMP ASS; STA DKSZ,B
	LDX PTR,B; LDA (MTP5; SAT 2; JPL I (OPEN; JMP AF2; STA FNUM,B
	COPY DT SA; AAT -70; LDA DKSZ,B; ORA (140000; COPY DX SA
	LDA DKAD,B; JPL I (CRTRK; JMP AF3
	LDT FNUM,B; JPL I (CFILE; JMP AF2
ASS,	MIN LREG,B
AFF,	JPL I (UNLOK; RET
AF1,	LDX (MS1; JPL I (MSG; JMP ASS
AF2,	JPL I (ERMSG; JMP ASS
AF3,	LDT FNUM,B; JPL I (CFILE; JMP AF2; JMP AF2
	)FILL
	)PCL ALKAT


%LOBJ
%LIST OBJECT TABLE ENTRIES
%RETURN

	PROGM

	GOVER OV9,L1,LOBJ
	DATA PTR,1
	DATA XTR,5
	DATA XTRX,10
	DATA CNT,1
	DATA MBUF,40
MS1,	'  (\ '

L1,	ENTER
	COPY DB SX; STZ CNT,B
L2,	LDT CNT,B; AAT 10; SAA 40; SAX MBUF; RADD DX SB
	JPL I (RDOFT; JMP L2C
	LDA CNT,B; AAA 100; SAT 10; JPL I (IOUT
	LDX (MS1; JPL I (MSG; SAX XTR; RADD DX SB; STX PTR,B
	SAT XTRX; RADD DT SB; SAA 20; SAD SHR 20; JPL I (SETUP
	LDA MBUF+32,B; SHA SHR 10; LDX PTR,B
	JPL I (GUNAM; JMP L2C; JPL I (SOUT; SAA ##); JPL I (TCO
	LDX PTR,B; SAT MBUF+1; RADD DT SB; SAA 20
	SAD SHR 20; JPL I (SETUP
	LDX PTR,B; SAA 20; SAD SHR 20; JPL I (SETW
L3,	LDX PTR,B; JPL I (GCI; JMP L4; JAZ L4
	JPL I (TCO; JMP L3
L4,	LDA MBUF+11,B; JAZ L6; SAA ##:; JPL I (TCO
	LDX PTR,B; SAT MBUF+11; RADD DT SB; SAA 4
	SAD SHR 20; JPL I (SETUP
	LDX PTR,B; SAA 4; SAD SHR 20; JPL I (SETW
L5,	LDX PTR,B; JPL I (GCI; JMP L6; JAZ L6
	JPL I (TCO; JMP L5
L6,	SAA ## ; JPL I (TCO; LDA MBUF,B; SAT 10; JPL I (IOUT
	SAA ## ; JPL I (TCO; LDA MBUF+17,B; SAT 10; JPL I (IOUT
	SAA ## ; JPL I (TCO; LDA MBUF+21,B; SAT 10; JPL I (IOUT
	SAA ## ; JPL I (TCO; LDA MBUF+22,B; SAT 10; JPL I (IOUT
	SAA ## ; JPL I (TCO; LDA MBUF+23,B; SAT 10; JPL I (IOUT
	SAA ## ; JPL I (TCO; LDA MBUF+24,B; SAT 10; JPL I (IOUT
	SAA ## ; JPL I (TCO; LDA MBUF+32,B; SAT 10; JPL I (IOUT
	JPL I (CRLF
L2C,	MIN CNT,B; LDA CNT,B; AAA -NOFT; JAN L2
	MIN LREG,B; RET
	)FILL
	)PCL LOBJ


	OVERX QOV9


	OVERL OV9A


