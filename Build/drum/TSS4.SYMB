%RETURN

	PROGM

	GOVER OV8,T1,TUSED
MS1,	'TIME USED IS \'
MS2,	'$OUT OF \'

T1,	ENTER
	COPY DB SX; LDX (MS1; JPL I (MSG
	LDX I (PRT; LDD 2,X; SAT 1; JPL I (OTIMF
	LDX (MS2; JPL I (MSG
	LDA I (CINF; AAA -1
	SHA 1; ADD (CSTIM; COPY DX SA; LDD 0,X
	SAT 1; JPL I (OTIMF; JPL I (CRLF
	MIN LREG,B; RET
	)FILL
	)PCL TUSED


%PRETY
%LIST CORE LOCATIONS
%X = START ADDRESS
%T = END ADDRESS
%A = FILE NUMBER
%RETURN

	PROGM

	GOVER OV8,P1,PRETY
	DATA ADR,1
	DATA VAL,1
	DATA II,1
	DATA JJ,1
	DATA KK,1
	DATA XX,1
PMS1,	'I/O ERROR$\ '

P1,	ENTER
	COPY DB SX; LDA XREG,B; STA ADR,B
P1A,	LDA I ADR,B; STA VAL,B
	LDA TREG,B; SUB ADR,B; JAP *+2; JMP I (PSS
	AAA -5; JAP *+2; JMP I 9P10
	SAX 1; LDF I ADR,B,X; LDX VAL,B
	SKP IF DT EQL SX; JMP I 9P10
	SKP IF DA EQL SX; JMP I 9P10
	SKP IF DD EQL SX; JMP I 9P10
	SAX 4; LDA I ADR,B,X; LDX VAL,B
	SKP IF DA EQL SX; JMP I 9P10
	LDA ADR,B; AAA 4; STA II,B
P2,	COPY DX SA AD1; LDA 0,X; SUB VAL,B; JAF P3
	MIN II,B; LDA II,B; LDT TREG,B; SKP IF DA GRE ST; JMP P2
P3,	LDA TREG,B; SAT 10; JPL I (NLEN; AAA 1; STA XX,B
	LDA AREG,B; COPY DD SA; LDA ADR,B
	SAT 10; LDX XX,B; JPL I (SPACE
	SAA ##:; LDT AREG,B; JPL I 9OUTB; JMP PFF
	LDA AREG,B; COPY DD SA; LDA VAL,B
	SAT 10; SAX 11; JPL I (SPACE
	LDA (215; LDT AREG,B; JPL I 9OUTB; JMP PFF
	SAA 12; JPL I 9OUTB; JMP PFF
	SAA 1; STA KK,B; JMP P4
	)FILL
9P10,	P10
9OUTB, OUTBT
P4,	SAA 1; STA JJ,B; SAA ## ; LDT AREG,B; JPL I 9OUTB; JMP PFF
	MIN JJ,B; LDA JJ,B; SUB XX,B; AAA 2; JAN P4+2
	SAA ##.; JPL I 9OUTB; JMP PFF
P5,	SAA 1; STA JJ,B; SAA ## ; LDT AREG,B; JPL I 9OUTB; JMP PFF
	MIN JJ,B; LDA JJ,B; AAA -12; JAN P5+2
	SAA ##.; LDT AREG,B; JPL I 9OUTB; JMP PFF
	LDA (215; JPL I 9OUTB; JMP PFF
	SAA 12; JPL I 9OUTB; JMP PFF
	MIN KK,B; LDA KK,B; AAA -4; JAN P4
	LDA AREG,B; COPY DD SA; LDA II,B
	SAT 10; LDX XX,B; JPL I (SPACE
	SAA ##:; LDT AREG,B; JPL I 9OUTB; JMP PFF
	LDA VAL,B; SAT 10; SAX 11; JPL I (SPACE
	LDA (215; LDT AREG,B; JPL I 9OUTB; JMP PFF
	SAA 12; JPL I 9OUTB; JMP PFF
	LDA II,B; AAA 1; STA ADR,B; JMP I (P1A
P10,	LDA TREG,B; SAT 10; JPL I (NLEN; AAA 1; STA XX,B
	LDA AREG,B; COPY DD SA; LDA ADR,B
	SAT 10; LDX XX,B; JPL I (SPACE
	SAA ##:; LDT AREG,B; JPL I 9OUTB; JMP PFF
	LDA VAL,B; SAT 10; SAX 11; JPL I (SPACE
	LDA (215; LDT AREG,B; JPL I 9OUTB; JMP PFF
	SAA 12; JPL I 9OUTB; JMP PFF
	MIN ADR,B; JMP I (P1A
PSS,	RET
PFF,	LDX (PMS1; JPL I (MSG; JMP I (START
	)FILL
	)PCL PRETY



%EXAM
