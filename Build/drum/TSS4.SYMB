	OVERL OV4


%DUMP
%DUMP USER'S ADDRESS SPACE ON A FILE
%RETURN

	PROGM

	GOVER OV4,D1,DUMP

%FILE NUMBER
	DATA CN,1
%START LOCATION
	DATA PREG,1
%FILE STRING POINTER
	DATA XTR,5
%POINTER TO STR
	DATA PTR,1
%FILE STRING
	DATA XTRX,20
%BUFFER ADDRESS
	DATA OBJ,1
%CORE TABLE POINTER
	DATA CTBL,1
%OBT POINTER
	DATA FOBJ,1
%MISC. VARIABLES
	DATA II,1
	DATA II2,1
	DATA J,1

D1,	ENTER
	COPY DB SX; JPL I (LOCK; STZ CN,B
	STSET PTR,XTR,XTRX,40
	LDT I (CMDLN; LDX PTR,B; SAA 1; JPL I (PCF; JMP I (DS
D6,	LDX PTR,B; LDA (MTP2; SAT 2; JPL I (OPEN
	JMP I (DF1; STA CN,B; COPY DT SA; SAA 0
	SAX 0; JPL I (GETPG; JMP I (DF1; STX OBJ,B
	LDT I (CMDLN; SAA 3; JPL I (PCF; JMP I (DS; STA PREG,B
	JMP D7
	)FILL
D7,	LDT I (CMDLN; SAA 13; JPL I (PCF; JMP I (DS
D7A,	SAX 20; STA I OBJ,B,X
	LDA (131313; SAX 17; STA I OBJ,B,X
	LDA I (RUBAD; SAX 16; STA I OBJ,B,X
"NN10
	LDT OBJ,B; AAT 1
	LDX (RBLOK+1; SAA 10; JPL I (BCOPY
"N10
	LDX OBJ,B; SRB 10
"
	LDA PREG,B; STA I OBJ,B
	LDX (OFT; LDA CN,B; AAA -100; RADD DX SA
	LDA 0,X; JPL I (OFTX; AAA 41; STA FOBJ,B
	LDA OBJ,B; AAA 100; STA CTBL,B; STZ II,B
D10,	JMP *+1; LDA II,B; SHA 1; STA II2,B
	LDX CTBL,B; RCLR DA; RCLR DD; STD I II2,B,X
	LDX (VCTBL; LDA I II2,B,X; SHA ZIN SHR 16; JAZ D10C
	LDT CN,B; AAT -70; SAX 1; LDA II,B; AAA 1
	JPL I (CRTRK; JMP DF2; STZ J,B
D11,	JMP *+1; LDT CN,B; AAT -70; LDA J,B; SHA 10; COPY DD SA
	LDA II,B; SHA 13; RADD DA SD; ADD (MSTRT; COPY DX SA
	LDA II,B; AAA 1; SHA 3; ADD J,B; RCLR DD
	JPL I (WPAGE; JMP DF1
D11C,	JMP *+1; MIN J,B; LDA J,B; AAA -10; JAN D11
	LDX FOBJ,B; LDA I II,B,X; COPY DD SA
	LDA (160000; LDX CTBL,B; STD I II2,B,X
D10C,	JMP *+1; MIN II,B; LDA II,B; AAA -NPGS; JAN D10
DS,	MIN LREG,B
DF,	LDT CN,B; JPL I (CFILE; JMP *+1; JPL I (UNLOK; RET
DF1,	JPL I (ERMSG; JMP DS
DF2,	AAA -21; JAZ *+3; AAA 21; JMP DF1; STZ J,B; JMP D11
	)FILL
	)PCL DUMP


%RECV
%RESTART USER FROM A FILE
%RETURN

	PROGM

	GOVER OV4,C1,RECV

%CORELOAD ADDRESS
	DATA CN,1
%CORE ADDRESS
	DATA CADR,1
%COUNTER
	DATA CNT,1
%BUFFER ADDRESS
	DATA OBJ,1
%BUFFER COUNTER
	DATA BCNT,1
%FILE STRING POINTER
	DATA XTR,5
%POINTER TO STR
	DATA PTR,1
%FILE STRING
	DATA XTRX,20
%MEMORY POINTERS
	DATA MSTR,2
MS1,	'NOT A DUMP FILE$\ '

C1,	ENTER
	COPY DB SX; STZ CN,B
	STSET PTR,XTR,XTRX,40
	LDT I (CMDLN; LDX PTR,B; SAA 1; JPL I (PCF; JMP I (CS
	LDX I (CMDLN; SAA 15; JPL I (WCI; JMP *+1
	INTEN; INTDS; LDA I (DABLE; JAN *-3
	LDA (-1000; STA I (DABLE; INTEN
	LDX PTR,B; LDA (MTP2; SAT 3; JPL I (OPEN
	JMP I (CF2; STA CN,B; COPY DT SA; SAA 0
	SAX -1; JPL I (GETPG; JMP I (CF2; STX OBJ,B
	SAX 17; LDA I OBJ,B,X; SUB (25252; JAF C10
	SAX 20; LDA I OBJ,B,X; STA I (RSTRT
	SAX 14; LDD I OBJ,B,X; STD MSTR,B; STA CADR,B
	SAX 16; LDA I OBJ,B,X; STA I (RUBAD
	JPL I (RESET; JPL I (FTLER
	LDX MSTR,B; LDT MSTR+1,B; SHT 13; RADD DT SX
	AAT -1; JPL I (CKMEM; JMP CF
	LDX OBJ,B; LDT (RBLOK; SAA 11; JPL I (BCOPY
	SAA 1; STA BCNT,B
	LDA MSTR+1,B; SHA 3; COPY CM2 DA SA; STA CNT,B; JAZ C5; JMP C4
	)FILL
C4,	LDT CN,B; AAT -70; LDA BCNT,B; LDX CADR,B; RCLR DD; JPL I (RPAGE
	JMP CF2; LDA CADR,B; ADD (400; STA CADR,B
	MIN BCNT,B; MIN CNT,B; JMP C4
C5,	LDT CN,B; JPL I (CFILE; JMP *+1
	LDA I (RBLOK; JAZ CS; COPY DT SA
	STZ I (DABLE; JPL I (GOTOX; JMP CF
CS,	MIN LREG,B
CF,	STZ I (DABLE; LDT CN,B; JPL I (CFILE; JMP *+1; RET
C10,	SAX 17; LDA I OBJ,B,X; SUB (131313; JAF CF1
	SAX 20; LDA I OBJ,B,X; STA I (RSTRT
	SAX 16; LDA I OBJ,B,X; STA I (RUBAD
"NN10
	LDX OBJ,B; LDT (RBLOK; SAA 11; JPL I (BCOPY
"N10
	LDX OBJ,B; LRB 10
	IRR 10 DP; STA I (RBLOK
"
	JPL I (RESET; JPL I (FTLER; STZ CNT,B
C20,	LDA CNT,B; SHA 1; ADD OBJ,B; AAA 100; COPY AD1 DX SA
	LDA 0,X; ADD (DKS; STA 0,X
	MIN CNT,B; LDA CNT,B; AAA -NPGS; JAN C20
	LDT (VCTBL; LDX OBJ,B; AAX 100
	SAA NPGS+NPGS; INTDS; JPL I (BCOPY; INTEN
	SAA 40; MST PID; COPY DA SA; JMP C5
CF1,	LDX (MS1; JPL I (MSG; JMP CS
CF2,	JPL I (ERMSG; JMP CS
	)FILL
	)PCL RECV


	OVERX QOV4


	OVERL OV4A


%BROAD
%SEND BROADCAST TO ALL ACTIVE TELETYPES
%X = MESSAGE STRING
%RETURN

	PROGM

	GOVER OV4A,B1,BROAD

	DATA CNT,1
	DATA CHR,1
	DATA XTR,5
	DATA PTR,1

B1,	ENTER
	COPY DB SX; SAT XTR; RADD DT SB; STT PTR,B
	LDX XREG,B; SAA 5; JPL I (BCOPY; JPL I (LOCK
	INTEN; INTDS; LDA I (TTYLK; JAN *-3
	SAA -1; STA I (TTYLK; STA I (KTTYL
	INTEN; INTDS; LDA I (DABLE; JAN *-3
	LDA (-3000; STA I (DABLE; INTEN
B2,	LDX PTR,B; JPL I (GCI; JMP B5; STA CHR,B; STZ CNT,B
B3,	LDX (TTYTB+1; LDA I CNT,B,X; JAZ B4; JAN B4
	LDT CNT,B; AAT 1; LDA CHR,B; JPL I (WTTYB; JMP *-4
B4,	MIN CNT,B; LDA CNT,B; AAA -NTTY; JAN B3; JMP B2
B5,	STZ I (TTYLK; STZ I (KTTYL; JPL I (UNLOK; STZ I (DABLE
	RET
	)FILL
	)PCL BROAD


%GUNUM
%CONVERT USER NAME TO USER NUMBER
%X = USER NAME STRING
%RETURN A
%A = USER NUMBER
%FAILURE RETURN IF NU SUCH USER

	PROGM

	GOVER OV4A,G1,GUNUM
	DATA XTR,5
	DATA PTR,1

G1,	ENTER
	COPY DB SX; SAT XTR; RADD DT SB; STT PTR,B
	LDX XREG,B; SAA 5; JPL I (BCOPY
	LDX PTR,B; LDT (USARR; SAA 1; COPY DD SA; JPL I (ABLKP
	JMP GFF; STA AREG,B; MIN LREG,B; RET
GFF,	RET
	)FILL
	)PCL GUNUM


%GUNAM
%CONVERT USER NUMBER TO USER NAME
%A = USER NUMBER
%X = STRING TO WHICH USER NAME IS TO BE APPENDED
%RETURN
%FAILURE RETURN IF NO SUCH USER

	PROGM

	GOVER OV4A,G1,GUNAM
	DATA XTR,5
	DATA PTR,1

G1,	ENTER
	COPY DB SX; SAX XTR; RADD DX SB; STX PTR,B
	LDA AREG,B; LDX PTR,B; JPL I (USARR; JMP GFF
G2,	LDX PTR,B; JPL I (GCI; JMP GSS
	LDX XREG,B; JPL I (WCI; JMP GSS; JMP G2
GSS,	MIN LREG,B; RET
GFF,	RET
	)FILL
	)PCL GUNAM


%IMAIL
%INITIALIZE MAILBOX
%RETURN

	PROGM

	GOVER OV4A,I1,IMAIL
	DATA CNT,1
MS1,	'YOU MAY NOT DO THIS$\ '

I1,	ENTER
	COPY DB SX; JPL I (LOCK; JPL I (WHUSR; AAA -1; JAF IFF
	INTEN; INTDS; LDA I (MAILK; JAN *-3
	SAA -1; STA I (MAILK; STA I (KMAIL; INTEN
	COPY DD SA; LDX (QBUF; STD 0,X
	LDT (MAILD; SAA 3; JPL I (XDISK; JMP *-1
	STZ I (MAILK; STZ I (KMAIL; JMP IFF+2
IFF,	LDX (MS1; JPL I (MSG; JPL I (UNLOK; RET
	)FILL
	)PCL IMAIL


%PMSG
%PUT A MESSAGE INTO THE USER'S MAILBOX
%A = USER NUMBER
%X = CORE ADDRESS OF MESSAGE
%RETURN
%FAILURE RETURN IF NO MORE ROOM IN MAILBOX

	PROGM

	GOVER OV4A,P1,PMSG
	DATA CNT,1

P1,	ENTER
	COPY DB SX; JPL I (LOCK
	INTEN; INTDS; LDA I (MAILK; JAN *-3
	SAA -1; STA I (MAILK; STA I (KMAIL; INTEN; STZ CNT,B
P2,	LDA (MAILD; ADD CNT,B; COPY DT SA; LDX (QBUF
	SAA 1; JPL I (XDISK; JMP *-1
	LDA I (QBUF+1; JAP P3; LDA AREG,B
	STA I (QBUF+1; JMP PPX
P3,	LDA I (QBUF; JAP P4; STZ I (QBUF
	LDA (MAILD; ADD CNT,B; COPY DT SA; LDX (QBUF
	SAA 3; JPL I (XDISK; JMP *-1; MIN CNT,B
	SAA -1; STA I (QBUF; LDA AREG,B; STA I (QBUF+1
	JMP PPX
P4,	MIN CNT,B; LDA CNT,B; SUB (MAILS-1; JAN P2
	STZ I (MAILK; STZ I (KMAIL; JMP PFF
PPX,	LDX XREG,B; LDT (QBUF+2; LDA (376; JPL I (BCOPY
	LDA (MAILD; ADD CNT,B; COPY DT SA; LDX (QBUF
	SAA 3; JPL I (XDISK; JMP *-1
	STZ I (MAILK; STZ I (KMAIL; MIN LREG,B
PFF,	JPL I (UNLOK; RET
	)FILL
	)PCL PMSG


%GMAIL
%GET USER'S MAIL
%X = CORE ADDRESS OF MESSAGE BUFFER
%RETURN

	PROGM

	GOVER OV4A,G1,GMAIL
	DATA CNT,1
	DATA BUFF,1

G1,	ENTER
	COPY DB SX; JPL I (LOCK
	INTEN; INTDS; LDA I (MAILK; JAN *-3
	SAA -1; STA I (MAILK; STA I (KMAIL; INTEN; STZ CNT,B
	LDA XREG,B; AND (77777; SUB (30000; JAN GFF
	LDA XREG,B; STA BUFF,B
G2,	LDA (MAILD; ADD CNT,B; COPY DT SA; LDX (QBUF
	SAA 1; JPL I (XDISK; JMP *-1; JPL I (WHUSR
	SUB I (QBUF+1; JAF G3-2; RCLR DA; RCLR DD
	STD I BUFF,B; SAA -1; STA I (QBUF+1
	LDA (MAILD; ADD CNT,B; COPY DT SA
	LDX (QBUF; SAA 3; JPL I (XDISK; JMP *-1
	LDT BUFF,B; AAT 2; LDX (QBUF+2
	LDA (376; JPL I (BCOPY; LDA (400; ADD BUFF,B
	STA BUFF,B; LDA I (QBUF; JAN GSS
G3,	MIN CNT,B; LDA CNT,B; SUB (MAILS; JAN G2
GSS,	SAA -1; COPY DD SA; STD I BUFF,B
	STZ I (KMAIL; STZ I (MAILK; JPL I (UNLOK; RET
GFF,	STZ I (MAILK; STZ I (KMAIL; JMP I (TRAP
	)FILL
	)PCL GMAIL


%CMAIL
%DOES THE USER HAVE MAIL?
%RETURN IF HE HAS MAIL
%FAILURE RETURN IF HE DOES NOT HAVE MAIL

	PROGM

	GOVER OV4A,C1,CMAIL
	DATA CNT,1

C1,	ENTER
	COPY DB SX; JPL I (LOCK; INTEN; INTDS; LDA I (MAILK; JAN *-3
	SAA -1; STA I (MAILK; STA I (KMAIL; INTEN; STZ CNT,B
C2,	LDA (MAILD; ADD CNT,B; COPY DT SA; LDX (QBUF
	SAA 1; JPL I (XDISK; JMP *-1; JPL I (WHUSR
	SUB I (QBUF+1; JAZ CSS; LDA I (QBUF; JAN CFF
	MIN CNT,B; LDA CNT,B; SUB (MAILS; JAN C2
CFF,	STZ I (MAILK; STZ I (KMAIL; JPL I (UNLOK; RET
CSS,	MIN LREG,B; JMP CFF
	)FILL
	)PCL CMAIL


	OVERX QOV4A


	OVERL OV5


%RESRV
%RESERVE PERIPHERAL DEVICE
%RETURN

	PROGM

	GOVER OV5,R1,RESRV
	DATA DVNO,1
	DATA TEMP,1
	DATA CSTR,5
	DATA CPTR,1
	DATA XTR,20
MS1,	'ALREADY RESERVED BY USER \'
MS2,	'DIABLO LOGGING IN$\'
R1,	ENTER
	COPY DB SX; STSET CPTR,CSTR,XTR,40
	LDT I (CMDLN; LDX CPTR,B; SAA 14; JPL I (PCF; JMP RSS
	LDX CPTR,B; LDT (STARR; SAA 1; COPY DD SA
	LDA (PDEVS; JPL I (ABLKP; JMP RFF
	SHA 1; ADD (DDEVS; COPY DT SA; COPY DX SA AD1
	LDA -1,X; STA DVNO,B; LDX 0,X; JXZ RSS
	LDA 0,X; JAZ R2; SUB I (CINF; JAZ RSS
	LDX (MS1; JPL I (MSG; ADD I (CINF; ADD (TTYTB; COPY DX SA
	LDA 0,X; LDX CPTR,B; JPL I (USARR; JMP *+2
	JPL I (SOUT; JPL I (CRLF; JMP RSS
R2,	LDA I (CINF; STA 0,X
	COPY DX ST; LDT 0,X; JPL I (CFILE; JMP *+1
	LDA DVNO,B; AAA -14; JAF RSS
	SAA DIABT-1; SHA 3; ADD (PRT1; COPY DX SA
	LDA  5,X; JAN R3; SAA 0; STA I (LDIAB
	LDX (MS2; JPL I (MSG; JMP RSS
R3,	STZ I (DIAFN; STZ I (DIABS; SAA 2; STA 7,X
	SAT DIABT; SAA 0; JPL I (SBRKS; JPL I (SECHS
RSS,	MIN LREG,B
RFF,	RET
	)FILL
	)PCL RESRV


%RELSE
%RELEASE PERIPHERAL DEVICE
%RETURN

	PROGM

	GOVER OV5,R1,RELSE
	DATA DVNO,1
	DATA CSTR,5
	DATA CPTR,1
	DATA XTR,20
R1,	ENTER
	COPY DB SX; STSET CPTR,CSTR,XTR,40
	LDT I (CMDLN; LDX CPTR,B; SAA 14; JPL I (PCF; JMP RSS
	LDX CPTR,B; LDT (STARR; SAA 1; COPY DD SA
	LDA (PDEVS; JPL I (ABLKP; JMP RFF; STA DVNO,B
	SHA 1; ADD (DDEVS; COPY DX SA AD1; LDX 0,X; JXZ RSS
	LDA 0,X; JAZ RFF; SUB I (CINF; JAF RFF
	STZ 0,X
	LDA DVNO,B; SHA 1; ADD (DDEVS; COPY DX SA
	LDA 0,X; AAA -14; JAF RSS
	LDA I (CINF; AAA -DIABT; JAF RSS
	SAA DIABT; STA I (LDIAB; JMP RFF
RSS,	MIN LREG,B
RFF,	RET
	)FILL
	)PCL RELSE


%WHERE
%WHERE IS SPECIFIED PERIPHERAL DEVICE
%RETURN

	PROGM

	GOVER OV5,W1,WHERE
	DATA CSTR,5
	DATA CPTR,1
	DATA XTR,20
MS1,	'RESERVED BY USER \ '
MS2,	'FREE TO USE$\ '
W1,	ENTER
	COPY DB SX; STSET CPTR,CSTR,XTR,40
	LDT I (CMDLN; LDX CPTR,B; SAA 14; JPL I (PCF; JMP WSS
	LDX CPTR,B; LDT (STARR; SAA 1; COPY DD SA
	LDA (PDEVS; JPL I (ABLKP; JMP WFF
	SHA 1; ADD (DDEVS; COPY DX SA AD1; LDX 0,X; JXZ WSS
	LDA 0,X; JAZ W2; LDX (MS1; JPL I (MSG
	ADD (TTYTB; COPY DX SA; LDA 0,X
	LDX CPTR,B; JPL I (USARR; JMP *+2
	JPL I (SOUT; JPL I (CRLF; JMP WSS
W2,	LDX (MS2; JPL I (MSG
WSS,	MIN LREG,B
WFF,	RET
	)FILL
	)PCL WHERE


%LINKS
%LINK TO USER
%RETURN
%FAILURE RETURN IF NOT POSSIBLE

	PROGM

	GOVER OV5,L1,LINKS
	DATA ADR1,1
	DATA ADR2,1
	DATA XTDEV,1
	DATA CNT,1
	DATA CSTR,5
	DATA CPTR,1
	DATA XTR,7
L1,	ENTER
	COPY DB SX; JPL I (LOCK; STSET CPTR,CSTR,XTR,16
	LDT I (CMDLN; LDX CPTR,B; SAA 15; JPL I (PCF; JMP XSS
	LDX CPTR,B; SAT 12; JPL I (CSN; JMP L5
L2,	STA XTDEV,B
	LDA I (CINF; ADD (BUFTB; COPY DX SA; LDA 0,X
	AAA 31; STA ADR1,B
	LDA XTDEV,B; JAN LFF; JAZ LFF; SAT NTTY
	SKP IF DT GRE SA; JMP LFF; ADD (BUFTB; COPY DX SA
	LDA 0,X; AAA 31; STA ADR2,B
	LDA XTDEV,B; AAA -1; SHA 3; ADD (PRT1; COPY DX SA
	LDA 5,X; JAN LFF; JAZ LFF; INTDS
	LDA XTDEV,B; SUB I (CINF; JAZ LFF
	LDA I ADR1,B; JAF LFF; LDA I ADR2,B; JAF LFF
	LDA I (CINF; STA I ADR2,B; LDA XTDEV,B; STA I ADR1,B
XSS,	MIN LREG,B
LFF,	INTEN; JPL I (UNLOK; RET
L5,	LDX CPTR,B; LDT (USARR; SAA 1; COPY DD SA; JPL I (ABLKP
	JMP LFF; COPY DT SA; SAA 1; STA CNT,B
L6,	LDX (TTYTB; LDA I CNT,B,X; SKP IF DA EQL ST; JMP L7
	LDA CNT,B; JMP L2
L7,	MIN CNT,B; LDA CNT,B; AAA -NTTY; AAA -1; JAN L6; JMP LFF
	)FILL
	)PCL LINKS


%BRKLK
%BREAK LINKS
%RETURN

	PROGM

	GOVER OV5,B1,BRKLK
B1,	ENTER
	COPY DB SX; JPL I (LOCK; INTDS
	LDA I (CINF; ADD (BUFTB; COPY DX SA; LDX 0,X
	LDA 31,X; JAZ BRSS; STZ 31,X; JAN BRSS
	SAT NTTY; SKP IF DT GRE SA; JMP BRSS
	ADD (BUFTB; COPY DX SA; LDX 0,X; STZ 31,X
BRSS,	INTEN; JPL I (UNLOK; SRET
	)FILL
	)PCL BRKLK


	OVERX QOV5


	OVERL OV6


%LOGON
%ROUTINE TO LOG ON A USER
%RETURN

	PROGM

	GOVER OV6,L1,LOGON
	DATA CSTR,5
	DATA CPTR,1
	DATA XTR,7
	DATA XPTR,1
	DATA XSTR,5
	DATA PASSW,1
	DATA UNO,1
	DATA OBJ,1
MS1,	'$$@ENTER \ '
MS2,	'$PASSWORD \ '
MS3,	'OK\ '
MS4,	'$PROJECT NUMBER P-\ '
MS5,	'$$*****YOU HAVE MAIL*****$\ '
MS6,	'()SCRATCH\ '

L1,	ENTER
	COPY DB SX; SAA -1; STA I (RMODE; STZ I (PASLK
	LDA I (TIME0+1; JAZ *+5; SAT 1; JPL I (PDATE; JMP *+1
	STZ I (KMAIL; STZ I (KTTYL; STZ I (KACCL
	LDA I (CINF; ADD (TTYTB; COPY DX SA; SAA -1; STA 0,X
L2,	LDA I (CINF; ADD (TIMTB; COPY DX SA
	LDA (-13414; STA 0,X; LDX (MS1; JPL I (MSG
	SAX CSTR; RADD DX SB; STX CPTR,B; SAT XTR
	RADD DT SB; SAA 16; SAD ZIN SHR 20; JPL I (SETUP
L3,	JPL I (TCI; AND (177; SAT 15; SKP IF DA UEQ ST; JMP L4
	LDX CPTR,B; JPL I (WCI; JMP L2; JMP L3
L4,	LDX (USRTB; LDT (USRDK; SAA 1; JPL I (XDISK; JMP *-4
	LDX CPTR,B; LDT (USARR; SAA 1; COPY DD SA; JPL I (ABLKP
	JMP L2; STA UNO,B; AAA -1
	RCLR DD; SAD SHR 5; COPY DX SA; SAA 0
	SAD 10; ADD (USRTB; RSUB DA SX; STA OBJ,B
	SAX 7; LDA I OBJ,B,X; JAZ LOGS
	SAT 3; JPL I (SXBRK
	LDX (MS2; JPL I (MSG; STZ PASSW,B
L5,	JPL I (TCI; AND (177; SAT 15; SKP IF DA UEQ ST; JMP L6
	LDT PASSW,B; SHT 3; RADD DA ST; STA PASSW,B; JMP L5
	)FILL
L6,	LDA PASSW,B; SUB (636; JAZ L6A
	SAX 7; LDA I OBJ,B,X; SUB PASSW,B; JAF L7
L6A,	LDX (MS3; JPL I (MSG; SAT 1; JPL I (SXBRK
LOGS,	LDX (MS4; JPL I (MSG
	LDX CPTR,B; RCLR DA; RCLR DD; JPL I (SETR
	LDX CPTR,B; RCLR DA; RCLR DD; JPL I (SETW
L8,	JPL I (TCI; AND (177; SAT 15; SKP IF DA UEQ ST; JMP L9
	LDX CPTR,B; JPL I (WCI; JMP LOGS; JMP L8
	)FILL
L9,	LDX CPTR,B; SAT 12; JPL I (CSN; JMP LOGS
	JAN LOGS; JAZ LOGS; STA I (PRNUM
	LDA I (CINF; ADD (TTYTB; COPY DX SA; LDA UNO,B; STA 0,X
	LDA I (CINF; ADD (TIMTB; COPY DX SA; STZ 0,X
	JPL I (CMAIL; JMP *+3; LDX (MS5; JPL I (MSG
	RCLR DA; RCLR DD; LDX CPTR,B; JPL I (SETR
	RCLR DA; RCLR DD; LDX CPTR,B; JPL I (SETW
	SAX XSTR; RADD DX SB; STX XPTR,B; LDT (MS6
	SAA 16; SAD SHR 20; JPL I (SETUP
	LDX XPTR,B; SAA 16; SAD SHR 20; JPL I (SETW
L10,	LDX XPTR,B; JPL I (GCI; JMP L11
	SAT ##\; SKP IF DA UEQ ST; JMP L11
	LDX CPTR,B; JPL I (WCI; JMP L9A; JMP L10
L11,	LDX CPTR,B; LDA I (CINF; SAT 12; JPL I (CNS
	LDX CPTR,B; LDA (MTP5; SAT 2; JPL I (OPEN; JPL I (ERMSG
L9A,	STZ I (LOGLK; STZ I (RMODE
"-DIAB
	RET
"DIAB
	SAA DIABT; SUB I (CINF; JAF L20
	SAA DIABT; STA I (LDIAB
	STZ I (DIABS; STZ I (DIAFN
L20,	RET
"
L7,	SAT 1; JPL I (SXBRK; JMP I (L2
	)FILL
	)PCL LOGON


%PASWD
