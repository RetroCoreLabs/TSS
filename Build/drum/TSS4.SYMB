%DELETE-MEMORY $(ADDRESS)
%RETURN

	PROGM

	GOVER OV7,D1,DLMEM
	DATA II2,1

D1,	ENTER
	COPY DB SX; JPL I (LOCK
D2,	LDT I (CMDLN; SAA 17; JPL I (PCF; JMP DSS; JAZ DSS
	SHA ZIN SHR 13; LDT (MSTRT; SHT ZIN SHR 13
	RSUB DA ST; JAN DFF; SAT NPGS
	SKP IF DA LST ST; JMP DFF; SHA 1; STA II2,B
	LDX (VCTBL; LDA I II2,B,X; JAZ D2
	AND (1777; ORA (20000; STA I II2,B,X
	SAA 40; MST PID; COPY DA SA; JMP D2
DSS,	MIN LREG,B
DFF,	JPL I (UNLOK; RET
	)FILL
	)PCL DLMEM


	OVERX QOV7


	OVERL OV8


%QUIT
%LOGOUT
%RETURN

	PROGM

	GOVER OV8,Q1,QUIT
	DATA T1,2
MS1,	'$TIME USED IS \'
MS2,	'$OUT OF \'
MS3,	'$****YOU HAVE MAIL****$$\'

Q1,	ENTER
	COPY DB SX; JPL I (LOCK
	INTDS; LDX I (PRT; LDD 2,X; INTEN; STD T1,B
	LDA I (LOGLK; JAF Q2; SAA -1; STA I (LOGLK
	JPL I (CMAIL; JMP Q2; LDX (MS3; JPL I (MSG
	JPL I (UNLOK; MIN LREG,B; RET
Q2,	JPL I (UACCT; SAT 1; JPL I (PDATE; JMP *+1
	LDX (MS1; JPL I (MSG
	LDD T1,B; SAT 1; JPL I (OTIMF
	LDX (MS2; JPL I (MSG; LDA I (CINF; AAA -1
	SHA 1; ADD (CSTIM; COPY DX SA; LDD 0,X
	SAT 1; JPL I (OTIMF; JPL I (CRLF
	JPL I (BRKLK; JMP *+1
	LDA I (CINF; ADD (TTYTB; COPY DX SA; STZ 0,X
	LDT I (CINF; LDA I (LRDR; SKP IF DA UEQ ST; STZ I (LRDR
	LDA I (LPNCH; SKP IF DA UEQ ST; STZ I (LPNCH
	LDA I (LCRD; SKP IF DA UEQ ST; STZ I (LCRD
	LDA I (LPNT; SKP IF DA UEQ ST; STZ I (LPNT
	LDA I (LSPNC; SKP IF DA UEQ ST; STZ I (LSPNC
	LDA I (LMOD; SKP DA UEQ ST; STZ I (LMOD
	LDA I (LACM; SKP DA UEQ ST; STZ I (LACM
	LDA I (LPLOT; SKP DA UEQ ST; STZ I (LPLOT
"DIAB
	LDA I (LDIAB; SKP IF DA EQL ST; JMP Q8
	STZ I (LDIAB; AAA -DIABT; JAZ Q8
	SAA DIABT-1; SHA 3; ADD (PRT1; COPY DX SA
	SAA -1; STA 5,X
"
Q8,	SAT -1; JPL I (CFILE; JMP *+1
	SAA 17; STA T1,B
Q3,	SAT 10; LDA T1,B; JPL I (GNXTR; JMP Q4A; STA T1,B; JAN Q4A
	SAT 10; SAX 1; JPL I (DLTRK; JMP *+1; JMP Q3
Q4A,	SAT 100; JPL I (CFILE; JMP Q4
Q4,	JPL I (RESET; JMP *+1
	INTDS; LDX I (PRT; LDA 0,X; SHA 1; ADD (PDTBL
	COPY DX SA; STZ 0,X
	LDX I (PRT; SAA -1; STA 5,X; STA 1,X
	SAA 40; MST PID; INTEN
	JMP *
	)FILL
	)PCL QUIT



%TUSED
