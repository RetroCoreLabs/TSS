%UACCT
%UPDATE ACCOUNTING FILE
%RETURN

	PROGM

	GOVER OV6A,U1,UACCT

	DATA INFO,5
	DATA FLAG1,1
	DATA FLAG2,1
	DATA CNT1,1
	DATA CNT2,1
	DATA CNT3,1
	DATA PRADR,1
	DATA USENT,1

U1,	ENTER
	COPY DB SX; JPL I (LOCK; JPL I (WHUSR; STA INFO,B
	LDX I (PRT; LDD 2,X; STD INFO+1,B
	LDA I (CINF; AAA -1; SHA 1; ADD (CSTIM
	COPY DX SA; LDD 0,X; STD INFO+3,B
	SAA -1; STA FLAG1,B; STA FLAG2,B; STZ CNT1,B
	INTEN; INTDS; LDA I (ACCLK; JAN *-3
	SAA -1; STA I (ACCLK; STA I (KACCL; INTEN
U2,	LDA CNT1,B; ADD (ACCTD; COPY DT SA
	LDX (QBUF; SAA 1; JPL I (XDISK; JMP U2; STZ CNT2,B
U3,	LDA CNT2,B; SHA 6; ADD (QBUF; STA PRADR,B
	LDA FLAG2,B; JAN U4; SAA -1; STA I PRADR,B; JMP USS
U4,	LDA I PRADR,B; JAP U5; SAA -1; COPY DD SA
	LDA I (PRNUM; STD I PRADR,B; STZ FLAG2,B; JMP U6
U5,	SUB I (PRNUM; JAF U3C
U6,	STZ CNT3,B
U7,	LDA CNT3,B; MPY (5; ADD PRADR,B; AAA 1; STA USENT,B
	LDA FLAG1,B; JAN U8; SAA -1; STA I USENT,B
	LDA FLAG2,B; JAP U3C; JMP USS
	)FILL
U8,	LDA I USENT,B; JAP U9; STZ FLAG1,B; LDX USENT,B
	RCLR DA; RCLR DD; STD 1,X; STD 3,X; LDA INFO,B; STA 0,X
U9,	SUB INFO,B; JAF U7C; LDF I USENT,B; SWAP DD SA
	ADD INFO+2,B; SWAP DD SA; COPY ADC DA SA
	ADD INFO+1,B; LDT INFO,B; STF I USENT,B; LDX USENT,B
	LDD 3,X; SWAP DD SA; ADD INFO+4,B; SWAP DD SA
	COPY ADC DA SA; ADD INFO+3,B; STD 3,X
	LDA FLAG1,B; JAP U7C; LDA FLAG2,B; JAP U3C
	JMP USS
U7C,	MIN CNT3,B; LDA CNT3,B; AAA -14; JAN U7; JMP UFF
U3C,	MIN CNT2,B; LDA CNT2,B; AAA -4; JAN U3
U2C,	LDA FLAG2,B; JAN *+10; LDA CNT1,B; ADD (ACCTD; COPY DT SA
	LDX (QBUF; SAA 3; JPL I (XDISK; JMP *-6
	MIN CNT1,B; LDA CNT1,B; AAA -200; JAN U2; JMP UFF
USS,	LDA CNT1,B; ADD (ACCTD; COPY DT SA
	LDX (QBUF; SAA 3; JPL I (XDISK; JMP USS
UFF,	STZ I (ACCLK; STZ I (KACCL; JPL I (UNLOK; RET
	)FILL
	)PCL UACCT


