%PCFX
%GET A PARAMETER PATTERN STRING
%X = STRING
%A = PARAMETER PATTERN NUMBER
%RETURN
%FAILURE RETURN IF NO SUCH STRING

	PROGM

	GOVER OV9B,P1,PCFX
	DATA PTR,1
	DATA XTR,5

P1,	ENTER
	COPY DB SX; LDX XREG,B; JPL I (STRST
	LDA AREG,B; ADD (PARPT; COPY DX SA; LDT 0,X
	SAX XTR; RADD DX SB; STX PTR,B
	SAA 100; SAD SHR 20; JPL I (SETUP
	LDX PTR,B; SAA 100; SAD SHR 20; JPL I (SETW
P2,	LDX PTR,B; JPL I (GCI; JMP PFF
	SAT ##\; SKP IF DA UEQ ST; JMP PSS
	LDX XREG,B; JPL I (WCI; JMP PFF; JMP P2
PSS,	MIN LREG,B
PFF,	RET
	)FILL
	)PCL PCFX


%PARAMETER PATTERN STRING ARRAY

PARPT, NPPS; SC1; SC2; SC3; SC4; SC5; SC6; SC7; SC8
	SC9; SC10; SC11; SC12; SC13; SC14; SC15; SC16
	SC17; SC18; SC19; SC20; SC21; SC22; SC23; SC24
	SC25; SC26; SC27; SC28; SC29; SC30; SC31; SC32
	SC33; SC34; SC35; SC36
NPPS=*-PARPT-1

SC1,	'S[FILE NAME: ]\ '
SC2,	'IB[FILE NUMBER: ]\ '
SC3,	'IB[START ADDRESS: ]\ '
SC4,	'S[REGISTER NAME OR CORE ADDRESS: ]\ '
SC5,	'IB[VALUE: ]\ '
SC6,	'S[INPUT FILE: ]\ '
SC7,	'S[OUTPUT FILE: ]\ '
SC8,	'IB[LOWER BOUND: ]\ '
SC9,	'IB[UPPER BOUND: ]\ '
SC10,	'S[R,W,RX OR WX: ]\ '
SC11,	'IB[RESTART ADDRESS: ]\ '
SC12,	'S[DEVICE NAME: ]\ '
SC13,	'S[USER NAME OR TTY NUMBER: ]\ '
SC14,	'S[USER NAME: ]\ '
SC15,	'IB[CORE ADDRESS OF BLOCK: ]\ '
SC16,	'IB[CORE ADDRESS: ]\ '
SC17,	'IB[TRACK ADDRESS: ]\ '
SC18,	'IB[NUMBER OF TRACKS: ]\ '
SC19,	'S[(USER NAME)FRIEND NAME: ]\ '
SC20,	'S[(USER NAME): ]\ '
SC21,	'IB[ACCESS WORD: ]\ '
SC22,	'S[OLD FILE NAME: ]\ '
SC23,	'S[NEW FILE NAME: ]\ '
SC24,	'IB[END ADDRESS: ]\ '
SC25,	'IB[DEVICE NUMBER: ]\ '
SC26,	'S[TITLE: ]\ '
SC27,	'ID[DAY: ]\ '
SC28,	'ID[MONTH: ]\ '
SC29,	'ID[YEAR (E.G. 1973): ]\ '
SC30,	'ID[HOUR: ]\ '
SC31,	'ID[MINUTE: ]\ '
SC32,	'ID[SECOND: ]\ '
SC33,	'S[TO USER: ]\ '
SC34,	'S[FROM USER: ]\ '
SC35,	'ID[NUMBER OF TRACKS: ]\ '
SC36,	'S[VERSION (A OR B): ]\ '

	)PCL PARPT


	OVERX QOV9B


	OVERL OV9C


%PCF
%PARAMETER COLLECTION FUNCTION
%T = COMMAND STRING
%X = STRING IN WHICH PARAMETER IS RETURNED
%A = PARAMETER PATTERN NUMBER
%RETURN A OR X
%A = INTEGER PARAMETER
%X = STRING PARAMETER
%FAILURE RETURN IF ANY ERROR (RETURN TO COMMAND PROCESSOR)

	PROGM

	GOVER OV9C,P1,FPCF
	DATA PPTR,1
	DATA PSTR,5
	DATA PSTRX,40
	DATA PTR1,1
	DATA PTR2,1
	DATA XTR1,5
	DATA XTR2,5
	DATA XTR1X,20
	DATA XTR2X,20
	DATA IPTR,1
	DATA ISTR,5
	DATA ISTRX,10
	DATA RADX,1
	DATA NBLK,1
MS1,	'$BAD PARAMETER PATTERN STRING$\ '
MS2,	'^$BAD PARAMETER$\ '

P1,	ENTER
	COPY DB SX; STSET PPTR,PSTR,PSTRX,100
	LDA TREG,B; STA PTR1,B
	LDX PPTR,B; LDA AREG,B; JPL I (PCFX; JMP I (PF1
	STSET PTR2,XTR2,XTR2X,40
P2,	LDT PTR1,B; JPL I (TRIM; STZ NBLK,B
	LDX PTR1,B; JPL I (LEN; SKP IF DD UEQ 0; JMP I (P20
P2Q,	LDX PPTR,B; RCLR DA; RCLR DD; JPL I (SETR
	LDX PPTR,B; JPL I (GCI; JMP I (PF1
	AAA -##I; JAZ P3; AAA ##I-##S; JAZ *+2; JMP I (PF1
P2A,	LDX PTR1,B; JPL I (GCI; JMP P10
	SAT ## ; SKP IF DA UEQ ST; JMP P10
	SAT ##,; SKP IF DA UEQ ST; JMP P10G
	LDX XREG,B; JPL I (WCI; JMP P2A; JMP P2A
P3,	STSET IPTR,ISTR,ISTRX,20
	LDX PPTR,B; JPL I (GCI; JMP I (PF1
	AAA -##D; JAZ *+5; AAA ##D-##B; JAF *-4
	SAA 10; JMP *+2; SAA 12; STA RADX,B
P3Q,	LDX PTR1,B; JPL I (GCI; JMP P3A
	SAT ## ; SKP IF DA UEQ ST; JMP P3A
	SAT ##,; SKP IF DA UEQ ST; JMP P3G
	LDX IPTR,B; JPL I (WCI; JMP P3Q; JMP P3Q
P3A,	LDX IPTR,B; JPL I (GCD; JMP P3Z
	SAT ##B; SKP IF DA UEQ ST; JMP P3B
	SAT ##D; SKP IF DA UEQ ST; JMP P3BB
	LDX IPTR,B; JPL I (WCI; JMP P3C; JMP P3C
	)FILL
P3G,	LDX PTR1,B; JPL I (WCD; JMP P3A; JMP P3A
P10G,	LDX PTR1,B; JPL I (WCD; JMP P10; JMP P10
P3Z,	STZ AREG,B; JMP P10
P3BB,	SAA 12; JMP P3B+1
P3B,	SAA 10; STA RADX,B
P3C,	LDX IPTR,B; LDT RADX,B; JPL I (CSN; JMP PF2
	STA AREG,B; LDX IPTR,B; JPL I (LEN
	SKP IF DD EQL 0; JMP PF2
P10,	LDX PTR1,B; JPL I (LEN; SKP IF DD UEQ 0; JMP PSS
	LDT PTR1,B; JPL I (TRIM
	LDX PTR1,B; JPL I (GC; AAA -##,; JAF PSS
	LDX PTR1,B; JPL I (GCI; JMP *+1
	LDT PTR1,B; JPL I (TRIM; JMP PSS
P20,	LDX PPTR,B; JPL I (GCI; JMP PF1
	AAA -##[; JAF P20
P11,	LDX PPTR,B; JPL I (GCI; JMP PF1
	SAT ##]; SKP IF DA UEQ ST; JMP P12
	JPL I (TCO; MIN NBLK,B; JMP P11
P12,	LDX PTR2,B; JPL I (STRST; SAA -1; ADD NBLK,B; STA NBLK,B
	LDX PTR1,B; LDT PTR2,B; JPL I (EDIT; JMP *+1
	LDT PTR1,B; LDA PTR2,B; STA PTR1,B; STT PTR2,B
	JMP P30
PSS,	MIN LREG,B
PFF,	RET
PF1,	LDX (MS1; JPL I (MSG; JMP PFF
PF2,	LDX PTR1,B; JPL I (LEN; COPY DA SD; STA RADX,B
	LDX PTR1,B; RCLR DA; RCLR DD; JPL I (SETR
	LDX PTR1,B; JPL I (LEN; COPY DA SD; SUB RADX,B
	ADD NBLK,B; COPY CM2 DX SA
	SAA ## ; JPL I (TCO; JNC *-2
	LDX (MS2; JPL I (MSG; JMP PFF
P30,	LDT PTR1,B; JPL I (TRIM; SAA 12; STA RADX,B; JMP I (P2Q
	)FILL
	)PCL FPCF



%RENAM
%RENAME [(USER)] OLD-NAME  NEW-NAME
%RETURN

	PROGM


	GOVER OV9C,R1,RENAM
	DATA CPTR,1
	DATA CSTR,5
	DATA CSTRX,23
	DATA PTR,1
	DATA XTR,5
	DATA XTRX,14
	DATA MBUF,20
	DATA NBUF,20

R1,	ENTER
	COPY DB SX; STSET CPTR,CSTR,CSTRX,46
	STSET PTR,XTR,XTRX,30
	JPL I (WHUSR; STA MBUF,B
	LDT I (CMDLN; LDX CPTR,B; SAA 26; JPL I (PCF; JMP I (RSS
	LDX CPTR,B; JPL I (GCI; JMP I (RFF
	SAT ##(; SKP IF DA EQL ST; JMP R5
R2,	LDX CPTR,B; JPL I (GCI; JMP I (RFF
	SAT ##); SKP IF DA UEQ ST; JMP R3
	LDX PTR,B; JPL I (WCI; JMP I (RFF; JMP R2
R3,	LDX PTR,B; JPL I (LEN; SKP IF DD EQL 0; JMP *+4
	SAA 1; STA MBUF,B; JMP R4
	LDX PTR,B; JPL I (GUNUM; JMP I (RF4; STA MBUF,B
	LDX PTR,B; JPL I (STRST
R4,	LDX CPTR,B; JPL I (GCI; JMP R6
R5,	SAT ## ; SKP IF DA UEQ ST; JMP R6
	SAT ##:; SKP IF DA UEQ ST; SAA ##-
	LDX PTR,B; JPL I (WCI; JMP RFF; JMP R4
	)FILL
R6,	SAA -1; STA I (ACTLK
	LDA MBUF,B; COPY DD SA; LDX PTR,B; SAA 1
	SAT MBUF; RADD DT SB; JPL I (FILE; JMP RFY
	LDX CPTR,B; JPL I (STRST
	LDT I (CMDLN; LDX CPTR,B; SAA 27; JPL I (PCF; JMP RSS
	SAX NBUF; RADD DX SB; SAT 0; SAA 20; JPL I (SETB
	LDX PTR,B; SAT NBUF; RADD DT SB
	SAA 20; SAD SHR 20; JPL I (SETUP
R7,	LDX CPTR,B; JPL I (GCI; JMP RFF
	SAT ##:; SKP IF DA UEQ ST; JMP R8
	LDX PTR,B; JPL I (WCI; JMP RFF; JMP R7
R8,	LDX PTR,B; SAT NBUF+10; RADD DT SB
	SAA 4; SAD SHR 20; JPL I (SETUP
R9,	LDX CPTR,B; JPL I (GCI; JMP R10
	LDX PTR,B; JPL I (WCI; JMP RFF; JMP R9
R10,	SAX MBUF; RADD DX SB; SAT NBUF; RADD DT SB
	SAA 0; JPL I (CNAME; JMP RFX
RSS,	MIN LREG,B
RFF,	STZ I (ACTLK; RET
RF4,	SAA 4
RFX,	JPL I (ERMSG; JMP RSS
RFY,	AAA 1; JAF *+3; SAA 10; JMP RFX; SAA 37; JMP RFX
	)FILL
	)PCL RENAM



%DELUS
%DELETE-USER  USERNAME
%RETURN

	PROGM

	GOVER OV9C,D1,DELUS
	DATA CPTR,1
	DATA CSTR,5
	DATA CSTRX,7

D1,	ENTER
	COPY DB SX; STSET CPTR,CSTR,CSTRX,16
	JPL I (WHUSR; AAA -1; JAF DF46
	LDT I (CMDLN; LDX CPTR,B; SAA 16; JPL I (PCF; JMP DSS
	LDX CPTR,B; JPL I (GUNUM; JMP DF4
	COPY DT SA; SAA 0; JPL I (DLUSR; JMP DFX
DSS,	MIN LREG,B; RET
DF4,	SAA 4; JMP DFX
DF46,	SAA 56
DFX,	JPL I (ERMSG; JMP DSS
	)FILL
	)PCL DELUS


	OVERX QOV9C


	OVERL OV9D


%SAVE
%SAVE CORE ON CORE IMAGE FILE
%SAVE-CORE  FILENAME, START ADDRESS, END ADDRESS
%RETURN

	PROGM

	GOVER OV9D,S1,SAVE
	DATA CPTR,1
	DATA CSTR,5
	DATA CSTRX,23
	DATA ADR0,1
	DATA ADRN,1
	DATA FNO,1
	DATA CNT,1
	DATA ACNT,1

S1,	ENTER
	COPY DB SX; STSET CPTR,CSTR,CSTRX,46
	LDT I (CMDLN; LDX CPTR,B; SAA 1; JPL I (PCF; JMP SSS
	LDA (MTP6; SAT 2; JPL I (OPEN; JMP SFX; STA FNO,B
	LDT I (CMDLN; SAA 3; JPL I (PCF; JMP SSS; STA ADR0,B
	LDT I (CMDLN; SAA 30; JPL I (PCF; JMP SSS; STA ADRN,B
	SHA ZIN SHR 1; LDT ADR0,B; SHT ZIN SHR 1
	RSUB DA ST; JAN SF36
	LDA ADR0,B; SHA ZIN SHR 10; STA CNT,B
	LDA ADRN,B; SHA ZIN SHR 10; AAA 1; STA ACNT,B
S2,	LDA CNT,B; SHA 10; COPY DX SA; LDT FNO,B
	LDA CNT,B; JPL I (WPAG; JMP SFX
	MIN CNT,B; LDA CNT,B; SUB ACNT,B; JAN S2
SSS,	LDT FNO,B; JPL I (CFILE; JMP *+1; MIN LREG,B; RET
SFX,	JPL I (ERMSG; JMP SSS
SF36,	SAA 44; JMP SFX
	)FILL
	)PCL SAVE



%GET
%GET-CORE  FILENAME, START ADDRESS, END ADDRESS
%RETRIEVE CORE FROM CORE IMAGE FILE
%RETURN

	PROGM

	GOVER OV9D,G1,GET
	DATA CPTR,1
	DATA CSTR,5
	DATA CSTRX,23
	DATA ADR0,1
	DATA ADRN,1
	DATA FNO,1
	DATA CNT,1
	DATA ACNT,1

G1,	ENTER
	COPY DB SX; STSET CPTR,CSTR,CSTRX,46
	LDT I (CMDLN; LDX CPTR,B; SAA 1; JPL I (PCF; JMP GSS
	LDA (MTP6; SAT 3; JPL I (OPEN; JMP GFX; STA FNO,B
	LDT I (CMDLN; SAA 3; JPL I (PCF; JMP GSS; STA ADR0,B
	LDT I (CMDLN; SAA 30; JPL I (PCF; JMP GSS; STA ADRN,B
	SHA ZIN SHR 1; LDT ADR0,B; SHT ZIN SHR 1
	RSUB DA ST; JAN GF36
	LDX ADR0,B; LDT ADRN,B; JPL I (CKMEM; JMP GF36
	LDA ADR0,B; SHA ZIN SHR 10; STA CNT,B
	LDA ADRN,B; SHA ZIN SHR 10; AAA 1; STA ACNT,B
G2,	LDA CNT,B; SHA 10; COPY DX SA; LDT FNO,B
	LDA CNT,B; JPL I (RPAG; JMP *+2; JMP G2C
	SAT 22; SKP IF DA EQL ST; JMP GFX
G2C,	MIN CNT,B; LDA CNT,B; SUB ACNT,B; JAN G2
GSS,	LDT FNO,B; JPL I (CFILE; JMP *+1; MIN LREG,B; RET
GFX,	JPL I (ERMSG; JMP GSS
GF36,	SAA 44; JMP GFX
	)FILL
	)PCL GET



%PINC
%PIN DEVICE-NUMBER
%PIN THE SPECIFIED DEVICE
%RETURN

	PROGM

	GOVER OV9D,P1,PINC
"NCR
XXX=44
"CDC
XXX=DCHN+44
"

"NN10
P1,	ENTER
	COPY DB SX; LDT I (CMDLN; SAA 31
	JPL I (PCF; JMP PSS; LDT (XXX
	SKP IF DA UEQ ST; JMP PSS
	ADD (IOT PIN; INTDS; STA *+1; 0; INTEN
PSS,	MIN LREG,B; RET
	)FILL
	)PCL PINC
"N10
P1,	ENTER
	COPY DB SX; MIN LREG,B; RET
	)PCL PINC
"


	OVERX QOV9D

	)LINE