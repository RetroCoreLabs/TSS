%RETURN

	PROGM

	GOVER OV6,P1,PASWD
	DATA OBJ,1
	DATA PASSW,1
MS0,	'OLD PASSWORD IS \ '
MS1,	'NEW PASSWORD IS \ '

P1,	ENTER
	COPY DB SX; SAT 3; JPL I (SXBRK
	LDX (USRTB; LDT (USRDK; SAA 1; JPL I (XDISK; JMP *-4
	JPL I (WHUSR; AAA -1
	RCLR DD; SAD SHR 5; COPY DX SA; SAA 0
	SAD 10; ADD (USRTB; RSUB DA SX; STA OBJ,B
PAA,	LDX (MS0; JPL I (MSG; STZ PASSW,B
PYY,	JPL I (TCI; AND (177; SAT 15; SKP IF DA UEQ ST; JMP PXX
	LDT PASSW,B; SHT 3; RADD DA ST; STA PASSW,B; JMP PYY
PXX,	JPL I (CRLF; SAX 7; LDA I OBJ,B,X; SUB PASSW,B; JAF PAA
	LDX (MS1; JPL I (MSG; STZ PASSW,B
P2,	JPL I (TCI; AND (177; SAT 15; SKP IF DA UEQ ST; JMP P3
	LDT PASSW,B; SHT 3; RADD DA ST; STA PASSW,B; JMP P2
P3,	SAT 1; JPL I (SXBRK; JPL I (CRLF
	LDA PASSW,B; SAX 7; STA I OBJ,B,X
	LDX (USRTB; LDT (USRDK; SAA 3; JPL I (XDISK; JMP *-4
	MIN LREG,B; RET
	)FILL
	)PCL PASWD


%WHOS
