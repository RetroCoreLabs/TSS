%PACCT
%PRINT ACCOUNT FILE
%RETURN

	PROGM

	GOVER OV6B,P1,PACCT

	DATA PTR,1
	DATA XTR,5
	DATA XTRX,40
	DATA XPTR,1
	DATA XSTR,5
	DATA XSTRX,23
	DATA FNUM,1
	DATA CNT1,1
	DATA CNT2,1
	DATA CNT3,1
	DATA PRADR,1
	DATA USENT,1
	DATA INFO,5
	DATA TCOM,2
	DATA TCON,2
	DATA PCOM,2
	DATA PCON,2

MS1,	'TIMESHARING SYSTEM USAGE REPORT$$\ '
MS2,	'$$$	 PROJECT NUMBER P-\ '
MS3,	'COMPUTE TIME: \ '
MS4,	'CONSOLE TIME: \ '
MS5,	'$   TOTAL \ '
MS6,	'$\ '
MS7,	'$$\ '
MS8,	'$$$\ '
MS9,	'UNKNOWN USER \ '

P1,	ENTER
	COPY DB SX; STSET PTR,XTR,XTRX,100
	STSET XPTR,XSTR,XSTRX,46
	JPL I (WHUSR; AAA -1; JAZ *4; SAA 56; JPL I (ERMSG; JMP I (PSS3
	LDT I (CMDLN; LDX XPTR,B; SAA 1; JPL I (PCF; JMP I (PSS
	LDA (MTP4; SAT 0; JPL I (OPEN; JMP I (PF1; STA FNUM,B
	LDT I (CMDLN; LDX PTR,B; SAA 32; JPL I (PCF; JMP I (PSS
	SAA 14; LDT FNUM,B; JPL I (OUTBT; JMP *+1
	SAA 12; LDT FNUM,B; JPL I (OSPF; LDX (MS1; JPL I (MSGF
	SAA 16; JPL I (OSPF; LDX PTR,B; JPL I (SOUTF
	LDX (MS6; JPL I (MSGF; STZ CNT1,B
	RCLR DA; RCLR DD; STD TCOM,B; STD TCON,B; JMP P2
	)FILL
P2,	LDA CNT1,B; ADD (ACCTD; COPY DT SA
	LDX (QBUF; SAA 1; JPL I (XDISK; JMP P2; STZ CNT2,B
P3,	LDA CNT2,B; SHA 6; ADD (QBUF; STA PRADR,B
	LDA I PRADR,B; JAP *+2; JMP I (P7; STZ CNT3,B
	RCLR DA; RCLR DD; STD PCOM,B; STD PCON,B
	LDX (MS2; LDT FNUM,B; JPL I (MSGF; LDA I PRADR,B; SAT 12
	LDX FNUM,B; JPL I (IOUTF; JMP *+1; LDX (MS7
	LDT FNUM,B; JPL I (MSGF
P4,	LDA CNT3,B; MPY (5; ADD PRADR,B; AAA 1; STA USENT,B
	LDA I USENT,B; JAN P5; LDX USENT,B; SAT INFO
	RADD DT SB; SAA 5; JPL I (BCOPY
	LDT INFO+1,B; LDX INFO+2,B; LDD PCOM,B
	JPL I (DADD; STD PCOM,B
	LDT INFO+3,B; LDX INFO+4,B; LDD PCON,B
	JPL I (DADD; STD PCON,B
P4C,	MIN CNT3,B; LDA CNT3,B; AAA -14; JAN P4
P5,	LDT PCOM,B; LDX PCOM+1,B; LDD TCOM,B; JPL I (DADD; STD TCOM,B
	LDT PCON,B; LDX PCON+1,B; LDD TCON,B; JPL I (DADD; STD TCON,B
	SAA 7; LDT FNUM,B; JPL I (OSPF; LDX (MS3; JPL I (MSGF
	LDD PCOM,B; JPL I (OTIMF; LDX (MS6; JPL I (MSGF
	SAA 7; JPL I (OSPF; LDX (MS4; JPL I (MSGF
	LDD PCON,B; JPL I (OTIMF; LDX (MS8; JPL I (MSGF
	STZ CNT3,B; JMP P6
	)FILL
P6,	LDA CNT3,B; MPY (5; ADD PRADR,B; AAA 1; STA USENT,B
	LDA I USENT,B; JAN P3C; LDX USENT,B; SAT INFO
	RADD DT SB; SAA 5; JPL I (BCOPY
	SAA 7; LDT FNUM,B; JPL I (OSPF; LDA INFO,B
	LDX PTR,B; JPL I (USARR; JMP *+4
	LDT FNUM,B; JPL I (SOUTF; JMP *+4
	LDX (MS9; LDT FNUM,B; JPL I (MSGF
	LDX (MS7; JPL I (MSGF; SAA 13; JPL I (OSPF
	LDX (MS3; JPL I (MSGF; LDD INFO+1,B; JPL I (OTIMF
	LDX (MS6; JPL I (MSGF; SAA 13; JPL I (OSPF
	LDX (MS4; JPL I (MSGF; LDD INFO+3,B; JPL I (OTIMF
	LDX (MS7; JPL I (MSGF
P6C,	MIN CNT3,B; LDA CNT3,B; AAA -14; JAN P6
P3C,	MIN CNT2,B; LDA CNT2,B; AAA -4; JAP *+2; JMP I (P3
P2C,	MIN CNT1,B; LDA CNT1,B; AAA -200; JAP *+2; JMP I (P2
P7,	LDX (MS7; LDT FNUM,B; JPL I (MSGF; LDX (MS5; JPL I (MSGF
	LDX (MS3; JPL I (MSGF; LDD TCOM,B; JPL I (OTIMF
	LDX (MS5; JPL I (MSGF; LDX (MS4; JPL I (MSGF
	LDD TCON,B; JPL I (OTIMF; LDX (MS6; JPL I (MSGF
	SAA 14; JPL I (OUTBT; JMP *+1
	JPL I (OUTBT; JMP *+1
PSS,	LDT FNUM,B; JPL I (CFILE; JMP *+1
PSS3,	MIN LREG,B; RET
PF1,	JPL I (ERMSG; JMP PSS
	)FILL
	)PCL PACCT


	OVERX QOV6B


	OVERL OV7


%CRUSR
%CREATE USER
%RETURN
%CALLING USER MUST BE 'SYSTEM'

	PROGM

	GOVER OV7,C1,CRUSR
	DATA CSTR,5
	DATA CPTR,1
	DATA XTR,7
	DATA CNT,1
	DATA OBJ,1
MS0,	'USER NUMBER = \ '
MS1,	'YOU MAY NOT DO THIS$\ '
MS2,	'AMBIGUOUS$\ '
MS3,	'ALREADY EXISTS$\ '
MS4,	'TOO LONG$\ '
MS5,	'NO MORE ROOM$\ '

C1,	ENTER
	COPY DB SX; JPL I (LOCK
	LDA I (CINF; ADD (TTYTB; COPY DX SA
	LDA 0,X; AAA -1; JAF CF1
	SAX XTR; RADD DX SB; SAT 0; SAA 7; JPL I (SETB
	LDX (USRTB; LDT (USRDK; SAA 1; JPL I (XDISK; JMP *-4
	STSET CPTR,CSTR,XTR,16
	LDT I (CMDLN; LDX CPTR,B; SAA 16; JPL I (PCF; JMP CFF+1
C2,	LDX CPTR,B; LDT (USARR; SAA 1; COPY DD SA
	LDA (USRTB; JPL I (ABLKP; JMP *+2; JMP CF3
	AAA 2; JAZ CF2
	RCLR DD; SAX XTR; RADD DX SB; JPL I (CRUSE; JMP CF3
	AAA -1; STA CNT,B; SHA 3; ADD (USRTB; STA OBJ,B
	LDX OBJ,B; SAT 0; SAA 10; JPL I (SETB
	LDX (USRTB; LDT (USRDK; SAA 3; JPL I (XDISK; JMP *-4
	LDX (MS0; JPL I (MSG; LDA CNT,B; AAA 1
	SAT 12; JPL I (IOUT; JPL I (CRLF; JMP CFF+1
CF1,	LDX (MS1; JMP CFF
CF2,	LDX (MS2; JMP CFF
CF3,	LDX (MS3; JMP CFF
CF4,	LDX (MS4; JMP CFF
CF5,	LDX (MS5
CFF,	JPL I (MSG; JPL I (UNLOK; SRET
	)FILL
	)PCL CRUSR


%LUSR
%LIST AUTHORIZED USERS
%RETURN

	PROGM

	GOVER OV7,L1,LUSR
	DATA CSTR,5
	DATA CPTR,1
	DATA CNT,1

L1,	ENTER
	COPY DB SX; SAX CSTR; RADD DX SB; STX CPTR,B
	SAA 1; STA CNT,B
L2,	LDA CNT,B; LDX CPTR,B; JPL I (USARR; JMP L4
	JPL I (LEN; SKP IF DD UEQ 0; JMP L3
	LDA CNT,B; SAT 12; SAX 1; COPY DD SX
	SAX 3; JPL I (SPACE; SAA 3; SAT 1; JPL I (OSPF
	LDX CPTR,B; JPL I (SOUT; JPL I (CRLF
L3,	MIN CNT,B; JMP L2
L4,	SRET
	)FILL
	)PCL LUSR


%MRENT
%MAKE SPECIFIED FILE REENTRANT
%MAKE-REENTRANT FILENAME $(ADDRESS)
%RETURN

	PROGM

	GOVER OV7,M1,MRENT
	DATA FNUM,1
	DATA XTR,5
	DATA PTR,1
	DATA XTRX,23
	DATA OBJ,1
	DATA CTBL,1
	DATA II2,1
MS1,	'NOT A DUMP FILE$\ '

M1,	ENTER
	COPY DB SX; JPL I (LOCK
	STSET PTR,XTR,XTRX,46
	LDT I (CMDLN; LDX PTR,B; SAA 1; JPL I (PCF; JMP MSS
	LDX PTR,B; LDA (MTP2; SAT 2; JPL I (OPEN; JMP MF2
	STA FNUM,B; COPY DT SA; SAA 0
	SAX 0; JPL I (GETPG; JMP MF2
	STX OBJ,B; AAX 100; STX CTBL,B
	SAX 17; LDA I OBJ,B,X; SUB (131313; JAF MF1
M2,	LDT I (CMDLN; JPL I (TRIM
	LDX I (CMDLN; JPL I (LEN; SKP IF DD UEQ 0; JMP MSS
	LDT I (CMDLN; SAA 17; JPL I (PCF; JMP MSS
	SHA ZIN SHR 13; LDT (MSTRT; SHT ZIN SHR 13
	RSUB DA ST; JAN MFX; SHA 1; STA II2,B
	LDX CTBL,B; LDA I II2,B,X; BSET ZRO 160 DA
	STA I II2,B,X; JMP M2
MFX,	LDT FNUM,B; JPL I (CFILE; JMP *+1
MFF,	JPL I (UNLOK; RET
MSS,	MIN LREG,B; JMP MFX
MF1,	LDX (MS1; JPL I (MSG; JMP MSS
MF2,	JPL I (ERMSG; JMP MSS
	)FILL
	)PCL MRENT


%DLMEM
