%TSS DUMPER
IOT=160000;ACT=400;SKA=1000;PIN=2000;SNI=0;     % Added by CVS
TDBI=410; TDBO=40             % Added by CVS
DIABD=156; TT3=162; TT4=DIABD; DIABT=4; DLP=143 % Added by CVS

%LIBRARY MARKS
%
% NCR (DEFAULT)
% CDC
%
% NN10 (DEFAULT)
% N10
%
% DCHN=100 IF NN10 ELSE 500 IF N10
%
% A (DEFAULT)
% B
%

40000/

NCR
"CDC
)KILL NCR
"

NN10
"N10
)KILL NN10
"

DCHN
"DCHN NN10
DCHN=100
"DCHN N10
DCHN=500
"

"NCR
DISC=44
RST=45
LCA=2045
LBA=2445
"CDC NN10
DISC=DCHN+44
DCT=DCHN+45
LCA=DCT+SNI
LBA=DCT+ACT
LMR=DCT+SKA
RST=DCT+PIN
"CDC N10
LCA=DCHN+1
LBA=DCHN+3
LMR=DCHN+5
RST=DCHN+4
LWC=DCHN+7
"

MSTRT=40000

A
"B
)KILL A
"

"NCR A
CORLD=10
"NCR B
CORLD=210
"CDC A
CORLD=60
"CDC B
CORLD=260
"



%HARDWARE BOOTSTRAP

"NN10
HLOAD, RCLR DD; IOT ACT SKA REA; JMP *-1
       SAD SHR 10; IOT ACT SKA REA; JMP *-1
       RADD DA SD; STA I HCORA; MIN HCORA
       MIN HCNT; LDA HCNT; SUB HSIZ; JAN HLOAD
       JMP I HSTRT
"N10
HLOAD, SAA 20; IOX 505; SAA 4; IOX 403
HL1,   RCLR DD; IOX 402; BSKP ONE 30 DA; JMP *-2
       IOX 400; STA ASAV; SAA 4; IOX 403
       LDA ASAV; SAD SHR 10
       IOX 402; BSKP ONE 30 DA; JMP *-2
       IOX 400; STA ASAV; SAA 4; IOX 403
       LDA ASAV; RADD DA SD; STA I HCORA; MIN HCORA
       MIN HCNT; LDA HCNT; SUB HSIZ; JAN HL1
       JMP I HSTRT
ASAV,  0
"
HCNT,  0
HCORA, TBOOT
HSIZ,  8TBE-TBOOT
HSTRT, TBOOT
       )PCL HLOAD
HLDE=*

%TSS LOADER

TBOOT, JPL 8WORD; SUB (125252; JAF TBOOT
TBLP,  JPL 8WORD; AAA 1; JAF TB1
       JPL 8WORD; AAA 1; JAF *+2; WAIT
       JPL 8WORD; COPY DX SA; JAN *+2; JMP 0,X; WAIT
TB1,   AAA -1; STA HCORE; STA HCORX
       JPL 8WORD; STA HDKA
       JPL 8WORD; STA HSIZ; STZ HCNT; STZ HCHK
TB2,   JPL 8WORD; STA I HCORE; ADD HCHK; STA HCHK
       MIN HCORE; MIN HCNT; LDA HCNT; SUB HSIZ; JAN TB2
       JPL 8WORD; SUB HCHK; JAZ *+2; WAIT 377
       LDA HDKA; AAA 1; JAZ TBLP
TB3,   LDX HCORX; LDT HDKA; JPL HDKOP; JMP TBLP
HCORE, 0
HCORX, 0
HDKA,  0
HCNT,  0
HCHK,  0
HSIZ,  0
       )FILL
       )PCL TBOOT

"NN10
8WORD, RCLR DD; IOT ACT SKA REA; JMP *-1; SAD SHR 10
       IOT ACT SKA REA; JMP *-1; RADD DA SD
       EXIT
"N10
8WORD, RCLR DD; IOX 402; BSKP ONE 30 DA; JMP *-2
       IOX 400; STA ASAV; SAA 4; IOX 403
       LDA ASAV; SAD SHR 10
       IOX 402; BSKP ONE 30 DA; JMP *-2
       IOX 400; STA ASAV; SAA 4; IOX 403
       LDA ASAV; RADD DA SD
       EXIT
ASAV,  0
"

"NCR
HDKOP, IOT SKA DISC; JMP *-1
HDK1,  COPY DA SX; IOT LCA; COPY DA ST; IOT LBA
       SAA 3; IOT ACT DISC; IOT SKA DISC; JMP *-1
       IOT RST; AND (130160; BSET BCM 170 DA; JAF HDK1
HDK2,  COPY DA SX; ADD (400; IOT LCA
       COPY DA ST AD1; IOT LBA
       SAA 3; IOT ACT DISC; IOT SKA DISC; JMP *-1
       IOT RST; AND (130160; BSET BCM 170 DA; JAF HDK2; EXIT
       )FILL
       )PCL HDKOP
"

"CDC
8DKLM=616
"CDC NN10
HDKOP, IOT SKA DISC; JMP *-1
"CDC N10
HDKOP, IOX RST
       BSKP ZRO 20 DA; JMP HDKOP
"CDC
       COPY DA ST; SAT 0; BLDA 150 DA; BSTA 170 DT
       AND (17777; COPY DD SA
"CDC NN10
       COPY CM2 DA SA; MPY (52525
       BSKP ONE 160 DA; JMP *+3; ADD (125252; JMP *+3
       BSKP ZRO 170 DA; ADD (52525; SHA ZIN SHR 2
"CDC N10
       STF DKTT; SAD ZIN SHR 20; SAT 14
       RDIV ST; COPY DT SA; LDD DKTA
       COPY DA ST; LDT DKTT
"CDC
       SHT ZIN SHR 5; RORA DT SA; SHT 5
       MPY (14; RSUB DD SA; RADD DD SD; RADD DT SD
       COPY DA ST; BSET ZRO 170 DA; SHA SHR 6
       SUB (8DKLM; JAN *+2; WAIT 37
"CDC NN10
HDK1,  COPY DA ST; IOT LBA; COPY DA SX; IOT LCA
       LDA (401; IOT LMR; IOT ACT DISC
       IOT SKA DISC; JMP *-1; IOT RST; JMP HDK1
       EXIT
"CDC N10
HDK1,  COPY DA ST; IOX LBA; COPY DA SX; IOX LCA
       LDA (400; IOX LWC
       LDA (4004; IOX LMR
       IOX RST
       BSKP ZRO 20 DA; JMP *-2
       IOX RST; BSKP ZRO 40 DA; JMP HDK1
       BSKP ONE 160 DA; JMP *-4; EXIT
"CDC
DKTT,  0
DKTA,  0
DKTD,  0
       )FILL
       )PCL HDKOP
"

8TBE=*


8FCN,  0     %FUNCTION
             %0: PRODUCE HARDWARE BOOTSTRAP AND TSS LOADER
             %1: PRODUCE TSS LOAD BLOCK

8CADR, 0     %-1: TRAILER
             %ELSE CORE ADDRESS OF LOAD BLOCK

8DKA,  0     %-1: IGNORED
             %ELSE DISK ADDRESS OF BINARY LOAD BLOCK
             %OR START ADDRESS

8NWD,  0     %NUMBER OF WORDS IN BINARY BLOCK


%8DUMP
%DUMP ONTO TSS BINARY FORMAT TAPE
%RETURNS TO MAC VIA JMP I 8DL

8DUMP, COPY DA SL; STA 8DL
       LDA 8FCN; JAF 8D1; SAX -177; SAA 0
       JPL PUNCK; JNC *-2
       LDA (HLOAD; JPL 8NOUT
       SAA ##/; JPL PUNCK
       LDA (HLOAD; STA 8CORE
8LOOP, LDA I 8CORE; JPL 8NOUT
       SAA 15; JPL PUNCK
       SAA 12; JPL PUNCK
       MIN 8CORE; LDA 8CORE; SUB (HLDE; JAN 8LOOP
       LDA (HLOAD; JPL 8NOUT
       SAA ##!; JPL PUNCK
8LP1,  LDA I 8CORE; JPL 8WOUT
       MIN 8CORE; LDA 8CORE; SUB (8TBE; JAN 8LP1
       LDA (125252; JPL 8WOUT; JMP I 8DL
8D1,   LDA 8CADR; AAA 1; JAZ 8D1A; LDA (BUFF; STA 8CORE; JMP 8D2
8D1A,  SAA -1; JPL 8WOUT
       LDA 8DKA; JPL 8WOUT; JPL 8WOUT; SAX -177; SAA 0
       JPL PUNCK; JNC *-2; JMP I 8DL
8D2,   LDA 8CADR; JPL 8WOUT; LDA 8DKA; JPL 8WOUT
       LDA 8NWD; JPL 8WOUT; STZ 8CNT; STZ 8CHK
8LP2,  LDA I 8CORE; JPL 8WOUT; ADD 8CHK; STA 8CHK
       MIN 8CORE; MIN 8CNT; LDA 8CNT; SUB 8NWD; JAN 8LP2
       LDA 8CHK; JPL 8WOUT; JMP I 8DL

8CORE, 0
8CNT,  0
8CHK,  0
8DL,   0

8WOUT, SAD ZIN SHR 10; LDT I (TDEV; 161002; WAIT
       SAD 10; 161002; WAIT; EXIT

8NOUT, COPY DD SA; SAA 0; LDT I (TDEV
       SAD 1; AAA ##0; 161002; WAIT; SAX -5
       SAA 0; SAD 3; AAA ##0; 161002; WAIT
       JNC *-5; EXIT
       )FILL
       )PCL 8DUMP

PUNCK, LDT I (TDEV; 161002; WAIT; EXIT
       )FILL

"CDC
%
%DISK RESTART ROUTINE
%

DKRST, JMP *+2; CORLD
       SAT 2; LDX (RDKOP; JPL RDKOP; JMP I (DBOOT
       )FILL

"CDC NN10
RDKOP, IOT SKA DISC; JMP *-1
"CDC N10
RDKOP, IOX RST
       BSKP ZRO 20 DA; JMP RDKOP
"CDC
       COPY DA ST; SAT 0; BLDA 150 DA; BSTA 170 DT
       AND (17777; COPY DD SA
"CDC NN10
       COPY CM2 DA SA; MPY (52525
       BSKP ONE 160 DA; JMP *+3; ADD (125252; JMP *+3
       BSKP ZRO 170 DA; ADD (52525; SHA ZIN SHR 2
"CDC N10
       STF DKTT; SAD ZIN SHR 20; SAT 14
       RDIV ST; COPY DT SA; LDD DKTA
       COPY DA ST; LDT DKTT
"CDC
       SHT ZIN SHR 5; RORA DT SA; SHT 5
       MPY (14; RSUB DD SA; RADD DD SD; RADD DT SD
       COPY DA ST; BSET ZRO 170 DA; SHA SHR 6
       SUB (8DKLM; JAN *+2; WAIT 37
"CDC NN10
RDK1,  COPY DA ST; IOT LBA; COPY DA SX; IOT LCA
       LDA (400; IOT LMR; IOT ACT DISC
       IOT SKA DISC; JMP *-1; IOT RST; JMP RDK1
       EXIT
"CDC N10
RDK1,  COPY DA ST; IOX LBA; COPY DA SX; IOX LCA
       LDA (400; IOX LWC
       SAA 4; IOX LMR
       IOX RST
       BSKP ZRO 20 DA; JMP *-2
       IOX RST; BSKP ZRO 40 DA; JMP RDK1
       BSKP ONE 160 DA; JMP *-4
       EXIT
"CDC
DKTT,  0
DKTA,  0
DKTD,  0
       )FILL
       )PCL RDKOP

DKRE=*-DKRST

DBOOT, STZ DBCOR; LDA I (1; STA DBDKA
DBLOP, LDX DBCOR; LDT DBDKA; JPL RDKOP
       MIN DBDKA; LDA (400; ADD DBCOR; STA DBCOR
       SUB (MSTRT; JAN DBLOP; JMP I (301
DBCOR, 0
DBDKA, 0
       )FILL
       )PCL DBOOT

DBOE=*-RDKOP
"



%TSS DUMPER PROGRAM

TDUMP, LDX (MS1; 161032
       SAX 0; SAT 3; LDA (MTP1; 161042; JMP TERR; STA FNUM
       LDX (MS2; 161032
       SAX 0; SAT 0; LDA (MTP2; 161042; JMP TERR; STA TDEV
       STZ I (8FCN; JPL I (8DUMP
"CDC
       SAA 1; STA I (8FCN
       LDA (DKRST; STA I (8CADR; COPY DX SA
       STZ I (8DKA; LDA (DKRE; STA I (8NWD
       LDT (BUFF; 161041
       JPL I (8DUMP; LDA (RDKOP; STA I (8CADR; COPY DX SA
       SAA 2; STA I (8DKA; LDA (DBOE; STA I (8NWD
       LDT (BUFF; 161041
       JPL I (8DUMP
"
       STZ CNT
LOOP,  LDA CNT; AAA 100; LDX (BUFF; LDT FNUM; 161007; JMP XL10
       LDA CNT; ADD (CORLD+100; STA I (8DKA
       LDA (BUFF; STA I (8CADR; LDA (400; STA I (8NWD
       SAA 1; STA I (8FCN; JPL I (8DUMP
XLOPX, MIN CNT; LDA CNT; AAA -100; JAN LOOP
       STZ CNT
XLOP,  LDX (BUFF; LDA CNT
       LDT FNUM; 161007; JMP XL11
       LDA CNT; SHA 10; STA I (8CADR
       SAA 1; STA I (8FCN; SAA -1; STA I (8DKA
       LDA (400; STA I (8NWD; JPL I (8DUMP
XL2,   MIN CNT; LDA CNT; AAA -100; JAN XLOP
       SAA 1; STA I (8FCN; SAA -1; STA I (8CADR
       SAA 7; STA I (8DKA; JPL I (8DUMP
       LDX (MS4; 161032; 161000
TERR,  161064; 161000
XL10,  SAT 22; SKP DA UEQ ST; JMP XLOPX; JMP TERR
XL11,  SAT 22; SKP DA UEQ ST; JMP XL2; JMP TERR
TDEV,  0
FNUM,  0
CNT,   0

       )FILL


MS1,   '$TSS DUMP PROGRAM$$CORE IMAGE FILE: \ '
MS2,   '$OUTPUT FILE: \ '
MS4,   '$DUMP FINISHED$\ '
MTP1,  'CORE\ '
MTP2,  'BIN\ '

BUFF=*
?
