% XDRUM - NORD-10 SWAPPING DRUM DRIVER + TRSFR SWAP FRONT END
% EXTRACTED VERBATIM FROM TSS1:SYMB (NORD TSS BY BO LEWENDAL)
% SOURCE LINES 3695-3877 OF src/TSS1.SYMB
% ORIGINAL GUARDS: "CDC (TRXX), "CDC-DRUM / "DRUM N10 (TRSFR/XDRUM)
% REQUIRES SYMBOLS: DRMSZ, DKA1, DKTR (CDC DISK DRIVER), LIBRARY MARKS CDC DRUM N10
%
"CDC

TRXX,	STF TRSAV; COPY DA SL; STA TRSVL
TRSF1, SAA 7; COPY DD SA
	LDA TRSAV+1; SHA SHR 1
	JPL I (DKTR; JMP DKF1; JMP DKF2
DKF1,	LDF TRSAV; JMP TRSF1
DKF2,	MIN TRSVL; LDF TRSAV; JMP I TRSVL

TRSAV, BSS 3
TRSVL, 0
	)FILL
	)PCL TRXX



"CDC-DRUM
TRSFR=TRXX
"DRUM N10
TRSFR, STF TRSAV; STX TRSX; COPY DA SL; STA TRSVL
TRSF1, LDA TRSAV; SUB (DKA1; SHA 2; COPY DD SA
	SUB (DRMSZ+DRMSZ+DRMSZ+DRMSZ; JAN TRSF2
	LDA TRSAV; SUB (DRMSZ; COPY DT SA
	LDA TRSAV+1; JPL TRXX; JMP *+1; JMP TRSF3
TRSF2, LDT TRSAV+1; SHT ZIN SHR 1
	SAX 40; LDA TRSX
	JPL XDRUM; JMP TRSF1; JMP *-2
TRSF3, MIN TRSVL; LDF TRSAV; LDX TRSX; JMP I TRSVL

TRSAV, BSS 3
TRSX,	0
TRSVL, 0
	)FILL
	)PCL TRSFR

% D R U M   T R A N S F E R	 R O U T I N E
%
%THIS IS 1. APPROXIMATION TO A NORD-10 VERSION
%NJL 17/4/73
%
% CALLING SEQUENCE:
%	JPL I (XDRUM
%	JMP	ERROR	% ERROR EXIT
%	JMP	BUSY	% BUSY EXIT
%	JMP	FINIS	% FINISHED EXIT
%
% CALLED WITH:
%  X - NUMBER OF BLOCKS
%  T - FUNCTION CODE
%	O-READ
%	1-WRITE
%	2-READ TEST
%	3-COMPARE
%	20-READ STATUS ONLY
%	BITS[8,9]-CORE ADDRESS BITS[16,17]
%  A - CORE ADDRESS
%  D - BLOCK (DRUM) ADDRESS
%
% RETURN INFORMATION:
%   ERROR EXIT:  X-DRUM STATUS REGISTER
%   BUSY EXIT: THE ROUTINE MUST BE CALLED AGAIN AT ONCE OR AFTER
%		  INTERRUPT WITH X,T,A AND D UNCHANGED.
%   FINISHED EXIT: X-DRUM STATUS REGISTER, A-CORE ADDRESS
%
%   B IS NOT USED BY THE ROUTINE
%
% DRUM INSTRUCTION DISPLACEMENTS:

DRM=	540	%DRUM MAIN DEVICE NUMBER
RCX=	0	%READ CORE ADDRESS
LCX=	1	%LOAD CORE ADDRESS
LBX=	3	%LOAD BLOCK ADDRESS
RSX=	4	%READ STATUS REGISTER
LCR=	5	%LOAD CONTROL REGISTER
LWX=	7	%LOAD WORD COUNT

%DRUM STATUS BITS:

DVA=	020	%DEVICE ACTIVE
ERR=	040	%INCLUSIVE OR OF ERRORS



% HDEV,B  MUST HOLD THE HARDWARE DEV. NUMBER (THE RCX DEVICE NUMBER)

XDRUM, STT	DTREG	% SAVE T,X AND A
	STX	DXREG
	STA	DAREG
DRDO1, IOX	DRM RSX	%READ STATUS REGISTER
	BSKP	ZRO DVA DA
	JMP	DBUSY	%DRUM BUSY
	BSKP	ZRO ERR DA
	JMP	DERRO	%ERROR
	SAA	37
	RAND	ST DA	%TRANSFER COMPLETE, FUNCTION TO A-REG
	AAA	-20	% READ STATUS ?
	JAZ	DRDS1	% YES, FINISHED
	AAA	14	% NO, LEGAL FUNCTION CODE ?
	JAP	DRILL	% NO, ERROR EXIT
	JXZ	DRDS1	% YES, FINISHED (ALL TRANSFERED ) ?
	SAT	37	%  NO, FIND EXTRA BLOCKS
	RAND	SD DT	% T=D-C/32*32 (SECTOR NUMBER)
	SAA	40
	RSUB	ST DA	% A=32-T (NUMBER OF SECTORS LEFT IN CURRENT TRACK)
	SKP	IF DA LST SX	% TRANSFER NUMBER OF BLOCKS OR NUMBER OF SECTORS
	COPY	SX DA	% LEFT IN ONE OPERATION
	SHA	ZIN 6

DRLWC, IOX	DRM LWX	%LOAD WORD COUNTER
	LDA	DAREG

DRDLC, IOX	DRM LCX	% LOAD CORE ADDRESS
	COPY	SD DT	% SAVE D
	SAD	ZIN 13	% A(10-0): TRACK D(15-11): SECTOR
	SHA	ROT 13	% A(15-11): LEAST- A(5-0): MOST SIGN. BITS OF TRACK
	RADD	SA DD	% D(15-11): MODIFIED SECTOR ADDRESS
	SHA	ROT 5	% A(10-0): TRACK
	SAD	5	% A: HARDWARE BLOCK ADDRESS
	COPY	ST DD	% UNSAVE D

DRDLB, IOX	DRM LBX	    % LOAD BLOCK ADDRESS
	SAA	37	% COMPUTE NEW REGISTER VALUES
	RAND	SD DA
	SAT	40
	RSUB	SA DT
	SKP	IF DT LST SX
	COPY	SX DT
	RSUB	ST DX	% X: NUMBER OF BLOCKS LEFT
	RADD	ST DD	% D: NEW BLOCK ADDRESS
	COPY	ST DA
	SHA	ZIN 6
	ADD	DAREG	% A: NEW CORE ADDRESS
	STA	DAREG
	SAA	3
	AND	DTREG
	SHA	ZIN 13	%DEVICE OPERATION
	COPY	SA DT
	LDA	(1400
	AND	DTREG
	SHA	ZIN SHR 3	%ADDRESS BITS 16 AND 17
	RORA	ST DA
	AAA	7	%ENABLE INTERRUP AND ACTIVATE DEVICE

DRDCO, IOX	DRM LCR	%LOAD CONTROL REGISTER

DBUSY, LDA	DAREG	%UNSAVE
	LDT	DTREG
	EXIT	AD1	% BUSY EXIT

% TRANSFER FINSIHED. READ STATUS AND RETURN

DRDS1, IOX	DRM RSX	% READ STATUS
	COPY	SA DX	% X=STATUS WORD
	LDA	DAREG
	RINC	DL
	EXIT	AD1	% FINISHED EXIT

% FUNCTION ERROR

DRILL, SAA	-1

% ERROR IN TRANSFER. OP. STATUS IN A.

DERRO, COPY SA DX
	SAA	4
	IOX	545
	LDA	DAREG
	LDT	DTREG
	EXIT

)FILL

DAREG, 0
DTREG, 0
DXREG, 0

	)PCL	XDRUM
	)KILL RCX DRM LCX LBX RSX LCR LWX
	)KILL DVA ERR
"


	)KILL DKA1 DKA2 DKA3 DKA4 DKA5 DKA6 DKA7 DKA8
