%RENTR
%READ FILE ENTRY
%D = DEVICE ID
%X = POINTER TO FILE ID (AS IN SFILA)
%T = POINTER TO ARRAY
%A = NUMBER OF WORDS (ALL IF NEGATIVE)
%RETURN
%FAILURE RETURN A
%A = 4 IF NO SUCH USER
%A = 8 IF NO SUCH FILE

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV12,R1,FRENT
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV12; R1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FRENT=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA DISP,1
DISP=ZYX
       )KILL ZYX
ZYX=DISP+1;
       
R1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; JPL I (LOCK
       LDA DREG,B; JPL I (KDEV; JPL I (DVERR
       LDA DREG,B; LDX XREG,B; JPL I (CKOBT; JMP RF27; JPL I (SUIB
       JMP RFF; STA DISP,B; LDA DREG,B; JPL I (RBLOC; JMP *-1
       LDA DREG,B; COPY DD SA; LDT I XREG,B; LDA (BTEMP
       ADD DISP,B; COPY DX SA; LDA 17,X; AND (777
       SAX 1; JPL I (CKACC; JMP RF12
       LDA (BTEMP; ADD DISP,B; COPY DX SA
       LDA AREG,B; JAP *+2; SAA 40; SAT 40
       SKP IF DT GRE SA; SAA 40
       LDT TREG,B; JPL I (BCOPY; STZ I (BTEMP-4
       MIN LREG,B; JMP RF4+2
RFF,   JAP RF8; AAA -2; JAZ RF8
RF4,   SAA 4; STA AREG,B; JPL I (UNLOK; RET

       RCLR DP AD1
       RF8,   SAA 10; JMP RF4+1
RF12,  SAA 14; STZ I (BTEMP-4; JMP RF4+1
RF27,  SAA 33; JMP RF4+1
       )FILL
       )PCL FRENT


%SOBT
%SEARCH OBT TABLE FOR THE GIVEN FILE
%A = DEVICE ID
%X = POINTER TO FILE ID (AS IN SFILA)
%RETURN A
%A = CORE ADDRESS OF OBJECT ENTRY (LOCKED)
%FAILURE RETURN A IF NOT IN OBT
%A = -1 IF NO MORE OBT ENTRIES
%A = CORE ADDRESS OF FREE ENTRY (LOCKED)

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV12,S1,FSOBT
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV12; S1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FSOBT=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA CNT,1
CNT=ZYX
       )KILL ZYX
ZYX=CNT+1;
       
       DATA OBJ,1
OBJ=ZYX
       )KILL ZYX
ZYX=OBJ+1;
       
       DATA ACNT,1
ACNT=ZYX
       )KILL ZYX
ZYX=ACNT+1;
       
S1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; JPL I (LOCK; STZ CNT,B; SAA -1; STA ACNT,B
S2,    LDA CNT,B; SHA 6; ADD (OBT; STA OBJ,B
       ENINT; DSINT; LDA I OBJ,B; JAN *-3
       BSET ONE 170 DA; STA I OBJ,B; ENINT
       AND (77777; JAF S3; LDA ACNT,B; AAA 1;  JAF S4
       LDA OBJ,B; STA ACNT,B; JMP S5
S3,    SAX 20; LDA I OBJ,B,X; SUB AREG,B; JAF S4
       SAX 32; LDA I OBJ,B,X; SHA ZIN SHR 10
       SUB I XREG,B; JAF S4; LDX XREG,B; AAX 1
       LDT OBJ,B; AAT 1; SAA 12; JPL I (BEQL; JMP S4
       LDA OBJ,B; STA AREG,B; JMP SSS
S4,    LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
S5,    MIN CNT,B; LDA CNT,B; AAA -NOBJ; JAN S2
       LDA ACNT,B; STA AREG,B
SFF,   JPL I (UNLOK; RET

       RCLR DP AD1
       SSS,   LDX ACNT,B; AAX 1; JXZ *+4; LDA -1,X
       BSET ZRO 170 DA; STA -1,X; MIN LREG,B; JMP SFF
       )FILL
       )PCL FSOBT


%CKOBT
%FIND OUT IF SPECIFIED FILE IS IN OBT
%A = DEVICE ID
%X = POINTER TO FILE ID (AS IN SFILA)
%RETURN IF FILE IS NOT IN OBT, ELSE
%FAILURE RETURN

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV12,C1,FCKOB
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV12; C1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FCKOB=BLOB
)KILL BLOB
)KILL GLOB
       

C1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; JPL I (LOCK; LDX XREG,B; JPL I (SOBT
       MIN LREG,B; AAA 1; JAZ CSS; AAA -1
       COPY DX SA; LDA 0,X; BSET ZRO 170 DA; STA 0,X
CSS,    JPL I (UNLOK; RET

       RCLR DP AD1
              )FILL
       )PCL FCKOB


%PDATE
%PRINT DATE AND TIME ON A FILE
%T = FILE NUMBER
%RETURN
%FAILURE RETURN A IF ERROR
%A = ERROR CODE

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV12,P1,FPDAT
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV12; P1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FPDAT=BLOB
)KILL BLOB
)KILL GLOB
       

       DATA TEMP,3
TEMP=ZYX
       )KILL ZYX
ZYX=TEMP+3;
       
       DATA TXX,1
TXX=ZYX
       )KILL ZYX
ZYX=TXX+1;
       

P1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; JPL I (RDATE; STF TEMP,B
       LDA TEMP+1,B; SHA ZIN SHR 10
       LDX TREG,B; SAT 12; JPL I (IOUTF; JMP PFF
       LDA TEMP,B; AND (377
       SAT 15; SKP IF DA LST ST; SAA 0
       ADD (MONTB; COPY DX SA
       LDX 0,X; LDT TREG,B; JPL I (MSGF
       LDA TEMP,B; SHA ZIN SHR 10; ADD (3554
       LDX TREG,B; SAT 12; JPL I (IOUTF; JMP PFF
       LDX (MS13; LDT TREG,B; JPL I (MSGF
       LDA TEMP+1,B; AND (377; STA TXX,B
       SAT 12; SKP IF DA LST ST; JMP P2
       SAA ##0; LDT TREG,B; JPL I (OUTBT; JMP PFF
P2,    LDA TXX,B; LDX TREG,B; SAT 12; JPL I (IOUTF; JMP PFF
       LDA TEMP+2,B; SHA ZIN SHR 10; STA TXX,B
       SAT 12; SKP IF DA LST ST; JMP P3
       SAA ##0; LDT TREG,B; JPL I (OUTBT; JMP PFF
P3,    LDA TXX,B; LDX TREG,B; SAT 12; JPL I (IOUTF; JMP PFF
       SAA ##:; LDT TREG,B; JPL I (OUTBT; JMP PFF
       LDA TEMP+2,B; AND (377; STA TXX,B
       SAT 12; SKP IF DA LST ST; JMP P4
       SAA ##0; LDT TREG,B; JPL I (OUTBT; JMP PFF
P4,    LDA TXX,B; LDX TREG,B; SAT 12; JPL I (IOUTF; JMP PFF
PSS,   MIN LREG,B; RET

       RCLR DP AD1
       PFF,   STA AREG,B; RET

       RCLR DP AD1
              )FILL
MONTB, MS13; MS1; MS2; MS3; MS4; MS5; MS6
       MS7; MS8; MS9; MS10; MS11; MS12

MS1,   ' JANUARY  '
MS2,   ' FEBRUARY  '
MS3,   ' MARCH  '
MS4,   ' APRIL  '
MS5,   ' MAY  '
MS6,   ' JUNE  '
MS7,   ' JULY  '
MS8,   ' AUGUST  '
MS9,   ' SEPTEMBER  '
MS10,  ' OCTOBER  '
MS11,  ' NOVEMBER  '
MS12,  ' DECEMBER  '
MS13,  '    '

       )PCL FPDAT


%DEVER
%DEFINE WHICH TSS CORELOAD IS TO BE LOADED WITH THE LOAD BUTTON
%RETURN

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV12,D1,DEVER
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV12; D1; SAVX
)KILL BLUES
BLUES=*
GLOB/
DEVER=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA PTR,1
PTR=ZYX
       )KILL ZYX
ZYX=PTR+1;
       
       DATA XTR,5
XTR=ZYX
       )KILL ZYX
ZYX=XTR+5;
       
       DATA XTRX,5
XTRX=ZYX
       )KILL ZYX
ZYX=XTRX+5;
       
       DATA CHR,1
CHR=ZYX
       )KILL ZYX
ZYX=CHR+1;
       

D1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; STSET PTR,STR,STRX,12
       SAX STR;
% **** ERROR AT: 032262 **** RANGE EXCEEDED
 RADD DX SB; STX PTR,B; SAT STRX;
       RADD DT SB; SAA 12; SAD SHR 20; JPL I (SETUP
       
"CDC
       JPL I (WHUSR; AAA -1; JAF DFF
D2,    LDT I (CMDLN; LDX PTR,B; SAA 44; JPL I (PCF; JMP DSS
       LDX PTR,B; JPL I (GCI; JMP D2; STA CHR,B
       LDX PTR,B; JPL I (GCI; JMP *+2; JMP D2
       LDA CHR,B; AAA -##A; JAZ D3; AAA ##A-##B; JAF D2
       LDA (CORL2; STA CHR,B; JMP D4
D3,    LDA (CORL1; STA CHR,B
D4,    LDX (QBUF; SAT 0; SAA 1; JPL I (TDISK
       LDA CHR,B; STA I (QBUF+1
       LDX (QBUF; SAT 0; SAA 3; JPL I (TDISK
"
DSS,   MIN LREG,B; RET

       RCLR DP AD1
       DFF,   SAA 56; JPL I (ERMSG; JMP DSS
       )FILL
       )PCL DEVER


