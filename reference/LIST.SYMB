)KILL BLOB
)KILL GLOB
       
       DATA CSTR,5
CSTR=ZYX
       )KILL ZYX
ZYX=CSTR+5;
       
       DATA CPTR,1
CPTR=ZYX
       )KILL ZYX
ZYX=CPTR+1;
       
       DATA CNT,1
CNT=ZYX
       )KILL ZYX
ZYX=CNT+1;
       

L1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; SAX CSTR; RADD DX SB; STX CPTR,B
       SAA 1; STA CNT,B
L2,    LDA CNT,B; LDX CPTR,B; JPL I (USARR; JMP L4
       JPL I (LEN; SKP IF DD UEQ 0; JMP L3
       LDA CNT,B; SAT 12; SAX 1; COPY DD SX
       SAX 3; JPL I (SPACE; SAA 3; SAT 1; JPL I (OSPF
       LDX CPTR,B; JPL I (SOUT; JPL I (CRLF
L3,    MIN CNT,B; JMP L2
L4,    SRET

       LDX I *+3; MIN LREG,X; JPL I *+2
       SPTR; USTK
              )FILL
       )PCL LUSR


