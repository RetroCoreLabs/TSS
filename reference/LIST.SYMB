%RETURN

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV7,L1,LUSR
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV7; L1; SAVX
)KILL BLUES
