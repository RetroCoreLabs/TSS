%OPENF
%OPEN FILE
%A = DEVICE ID
%X = POINTER TO FILE ID (AS IN SFILA)
%T = READ-ONLY FLAG (NEG. IF READ-ONLY)
%RETURN A
%A = FILE NUMBER
%FAILURE RETURN A
%A = 4 IF NO SUCH USER
%A = 8 IF NO SUCH FILE
%A = 10 IF NO MORE SPACE IN OBT
%A = 11 IF NO MORE OFT ENTRIES
%A = 12 IF NO ACCESS
%A = 13 IF FILE ALREADY OPEN FOR WRITE

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV13,O1,FOPEN
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV13; O1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FOPEN=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA OBJ,1
OBJ=ZYX
       )KILL ZYX
ZYX=OBJ+1;
       
       DATA OFTN,1
OFTN=ZYX
       )KILL ZYX
ZYX=OFTN+1;
       
       DATA DISP,1
DISP=ZYX
       )KILL ZYX
ZYX=DISP+1;
       
O1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; JPL I (LOCK
       LDA AREG,B; JPL I (KDEV; JPL I (DVERR
       JPL I (GOFT; JMP I (OF11; STA OFTN,B
       LDA AREG,B; LDX XREG,B; JPL I (SOBT; JMP *+2; JMP O2
       AAA 1; JAF *+2; JMP I (OF10; AAA -1
       STA OBJ,B; LDX (OFT; SUB (OBT; STA I OFTN,B,X
       LDA AREG,B; LDX XREG,B; JPL I (SUIB; JMP I (OF4
       STA DISP,B; LDA AREG,B; JPL I (RBLOC; JMP *-1
       LDA (BTEMP; ADD DISP,B; COPY DX SA; LDA (100000
       STA 0,X; LDT OBJ,B; SAA 40; JPL I (BCOPY
       STZ I (BTEMP-4; SAX 20; LDA AREG,B; STA I OBJ,B,X; JMP O3
       )FILL
O2,    STA OBJ,B; LDX (OFT; SUB (OBT; STA I OFTN,B,X
O3,    LDA AREG,B; COPY DD SA; LDT I XREG,B
       SAX 17; LDA I OBJ,B,X; AND (777
       LDX TREG,B; JXN *+3; SAX 3; JMP *+2
       SAX 1; JPL I (CKACC; JMP OF12
       LDX (OFT; LDT I OFTN,B,X; LDA TREG,B
       JAP *+3; BSET ONE 160 DT; STT I OFTN,B,X
       JAN *+6; LDA I OBJ,B; BSKP ZRO 160 DA; JMP OF13
       BSET ONE 160 DA; STA I OBJ,B; MIN I OBJ,B
       LDX (OFT; LDA I OFTN,B,X; BSET ONE 170 DA; STA I OFTN,B,X
       SAX 25; MIN I OBJ,B,X; JMP *+1; LDA I OBJ,B
       AND (37777; AAA -1; JAF O4
       SAX 21; LDT I OBJ,B,X; LDA AREG,B; JPL I (RBLOC; JMP *-1
       LDT OBJ,B; AAT 40; LDX (BTEMP; SAA 40; JPL I (BCOPY
       STZ I (BTEMP-4; SAX 37; STZ I OBJ,B,X
O4,    LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
       LDA OFTN,B; AAA 10; STA AREG,B; MIN LREG,B; JMP OFF+1
OF4,   JAP OF8; SAA 4; STZ I OBJ,B; JMP OFF
OF8,   SAA 10; JMP OF4+2
OF10,  SAA 12; JMP OFF
OF11,  SAA 13; JMP OFF
OF12,  SAA 14; JMP OFF1
OF13,  SAA 15; JMP OFF1
OFF,   STA AREG,B; JPL I (UNLOK; RET

       RCLR DP AD1
       OFF1,  LDT I OBJ,B; BSET ZRO 170 DT; STT I OBJ,B; JMP OFF
       )FILL
       )PCL FOPEN


%CLOSE
%CLOSE FILE
