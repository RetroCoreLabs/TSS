       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV19,S1,XSTAR
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV19; S1; SAVX
)KILL BLUES
BLUES=*
GLOB/
XSTAR=BLOB
)KILL BLOB
)KILL GLOB
       

%STRING POINTER TO PREVIOUS COMMAND LINE
       DATA OSTR,5
OSTR=ZYX
       )KILL ZYX
