%RETURN
%FAILURE RETURN A
%A = 14 IF BAD FILE NUMBER

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV13,C1,FCLOS
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV13; C1; SAVX
)KILL BLUES
