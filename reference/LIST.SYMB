       OVERL OV9D
OV9D=RQR
       )KILL RQR
RQR=OV9D+1
ROVER/
       


%SAVE
%SAVE CORE ON CORE IMAGE FILE
%SAVE-CORE  FILENAME, START ADDRESS, END ADDRESS
%RETURN

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV9D,S1,SAVE
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV9D; S1; SAVX
)KILL BLUES
BLUES=*
GLOB/
SAVE=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA CPTR,1
CPTR=ZYX
       )KILL ZYX
ZYX=CPTR+1;
       
       DATA CSTR,5
CSTR=ZYX
       )KILL ZYX
ZYX=CSTR+5;
       
       DATA CSTRX,23
CSTRX=ZYX
       )KILL ZYX
ZYX=CSTRX+23;
       
       DATA ADR0,1
ADR0=ZYX
       )KILL ZYX
ZYX=ADR0+1;
       
       DATA ADRN,1
ADRN=ZYX
       )KILL ZYX
ZYX=ADRN+1;
       
       DATA FNO,1
FNO=ZYX
       )KILL ZYX
ZYX=FNO+1;
       
       DATA CNT,1
CNT=ZYX
       )KILL ZYX
ZYX=CNT+1;
       
       DATA ACNT,1
ACNT=ZYX
       )KILL ZYX
ZYX=ACNT+1;
       

S1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; STSET CPTR,CSTR,CSTRX,46
       SAX CSTR; RADD DX SB; STX CPTR,B; SAT CSTRX;
       RADD DT SB; SAA 46; SAD SHR 20; JPL I (SETUP
       
       LDT I (CMDLN; LDX CPTR,B; SAA 1; JPL I (PCF; JMP SSS
       LDA (MTP6; SAT 2; JPL I (OPEN; JMP SFX; STA FNO,B
       LDT I (CMDLN; SAA 3; JPL I (PCF; JMP SSS; STA ADR0,B
       LDT I (CMDLN; SAA 30; JPL I (PCF; JMP SSS; STA ADRN,B
       SHA ZIN SHR 1; LDT ADR0,B; SHT ZIN SHR 1
       RSUB DA ST; JAN SF36
       LDA ADR0,B; SHA ZIN SHR 10; STA CNT,B
       LDA ADRN,B; SHA ZIN SHR 10; AAA 1; STA ACNT,B
S2,    LDA CNT,B; SHA 10; COPY DX SA; LDT FNO,B
       LDA CNT,B; JPL I (WPAG; JMP SFX
       MIN CNT,B; LDA CNT,B; SUB ACNT,B; JAN S2
SSS,   LDT FNO,B; JPL I (CFILE; JMP *+1; MIN LREG,B; RET

       RCLR DP AD1
       SFX,   JPL I (ERMSG; JMP SSS
SF36,  SAA 44; JMP SFX
       )FILL
       )PCL SAVE



%GET
%GET-CORE  FILENAME, START ADDRESS, END ADDRESS
%RETRIEVE CORE FROM CORE IMAGE FILE
%RETURN

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV9D,G1,GET
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV9D; G1; SAVX
)KILL BLUES
BLUES=*
GLOB/
GET=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA CPTR,1
CPTR=ZYX
       )KILL ZYX
ZYX=CPTR+1;
       
       DATA CSTR,5
CSTR=ZYX
       )KILL ZYX
ZYX=CSTR+5;
       
       DATA CSTRX,23
CSTRX=ZYX
       )KILL ZYX
ZYX=CSTRX+23;
       
       DATA ADR0,1
ADR0=ZYX
       )KILL ZYX
ZYX=ADR0+1;
       
       DATA ADRN,1
ADRN=ZYX
       )KILL ZYX
ZYX=ADRN+1;
       
       DATA FNO,1
FNO=ZYX
       )KILL ZYX
ZYX=FNO+1;
       
       DATA CNT,1
CNT=ZYX
       )KILL ZYX
ZYX=CNT+1;
       
       DATA ACNT,1
ACNT=ZYX
       )KILL ZYX
ZYX=ACNT+1;
       

G1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; STSET CPTR,CSTR,CSTRX,46
       SAX CSTR; RADD DX SB; STX CPTR,B; SAT CSTRX;
       RADD DT SB; SAA 46; SAD SHR 20; JPL I (SETUP
       
       LDT I (CMDLN; LDX CPTR,B; SAA 1; JPL I (PCF; JMP GSS
       LDA (MTP6; SAT 3; JPL I (OPEN; JMP GFX; STA FNO,B
       LDT I (CMDLN; SAA 3; JPL I (PCF; JMP GSS; STA ADR0,B
       LDT I (CMDLN; SAA 30; JPL I (PCF; JMP GSS; STA ADRN,B
       SHA ZIN SHR 1; LDT ADR0,B; SHT ZIN SHR 1
       RSUB DA ST; JAN GF36
       LDX ADR0,B; LDT ADRN,B; JPL I (CKMEM; JMP GF36
       LDA ADR0,B; SHA ZIN SHR 10; STA CNT,B
       LDA ADRN,B; SHA ZIN SHR 10; AAA 1; STA ACNT,B
G2,    LDA CNT,B; SHA 10; COPY DX SA; LDT FNO,B
       LDA CNT,B; JPL I (RPAG; JMP *+2; JMP G2C
       SAT 22; SKP IF DA EQL ST; JMP GFX
G2C,   MIN CNT,B; LDA CNT,B; SUB ACNT,B; JAN G2
GSS,   LDT FNO,B; JPL I (CFILE; JMP *+1; MIN LREG,B; RET

       RCLR DP AD1
       GFX,   JPL I (ERMSG; JMP GSS
GF36,  SAA 44; JMP GFX
       )FILL
       )PCL GET



%PINC
%PIN DEVICE-NUMBER
%PIN THE SPECIFIED DEVICE
%RETURN

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV9D,P1,PINC
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV9D; P1; SAVX
)KILL BLUES
BLUES=*
GLOB/
PINC=BLOB
)KILL BLOB
)KILL GLOB
       
"CDC
XXX=DCHN+44
"

"NN10
P1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; LDT I (CMDLN; SAA 31
       JPL I (PCF; JMP PSS; LDT (XXX
       SKP IF DA UEQ ST; JMP PSS
       ADD (IOT PIN; INTDS; STA *+1; 0; INTEN
PSS,   MIN LREG,B; RET

       RCLR DP AD1
              )FILL
       )PCL PINC
"


       OVERX QOV9D
QOV9D=*-ROVER
)9MOVE ROVER VOR VORS
GLOB=VOR
)KILL VOR
VOR=GLOB+VORS
)KILL GLOB
