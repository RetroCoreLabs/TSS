%A = 4 IF NO SUCH USER
%A = 8 IF NO SUCH FILE
%A = 12 IF NO ACCESS

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV14,D1,FDLFI
GLOB=*
BLUES/
