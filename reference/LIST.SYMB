       DATA XTR,5
XTR=ZYX
       )KILL ZYX
ZYX=XTR+5;
       
       DATA XTRX,20
XTRX=ZYX
       )KILL ZYX
ZYX=XTRX+20;
       
       DATA US1,1
US1=ZYX
       )KILL ZYX
ZYX=US1+1;
       
       DATA US2,1
US2=ZYX
       )KILL ZYX
ZYX=US2+1;
       
       DATA CNT,1
CNT=ZYX
       )KILL ZYX
ZYX=CNT+1;
       

T1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; STSET PTR,STR,STRX,40
       SAX STR;
% **** ERROR AT: 032077 **** RANGE EXCEEDED
 RADD DX SB; STX PTR,B; SAT STRX;
       RADD DT SB; SAA 40; SAD SHR 20; JPL I (SETUP
       
       LDT I (CMDLN; LDX PTR,B; SAA 41; JPL I (PCF; JMP TSS
       LDX PTR,B; JPL I (GUNUM; JMP TF4; STA US1,B
       LDX PTR,B; JPL I (STRST
       JPL I (WHUSR; STA US2,B; AAA -1; JAF T5
       LDX PTR,B; LDT I (CMDLN; SAA 42; JPL I (PCF; JMP TSS
       LDX PTR,B; JPL I (GUNUM; JMP TF4; STA US2,B
T5,    LDT I (CMDLN; SAA 43; JPL I (PCF; JMP TSS; STA CNT,B
       JPL I (WHUSR; AAA -1; JAZ T2
       LDA CNT,B; JAN TFF; JMP T3
T2,    LDA US1,B; SUB US2,B; JAZ T4
T3,    LDT US2,B; LDA CNT,B; JPL I (UTRK; JMP TFX
T4,    LDT US1,B; LDA CNT,B; COPY CM2 DA SA; JPL I (UTRK; JMP TFX
TSS,   MIN LREG,B; RET

       RCLR DP AD1
       TFX,   JPL I (ERMSG; JMP TSS
TFF,   RET

       RCLR DP AD1
       TF4,   SAA 4; JMP TFX
       )FILL
       )PCL TRTRK


%LTRKS
%LIST NUMBER OF TRACKS LEFT
%RETURN

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV17,L1,LTRKS
