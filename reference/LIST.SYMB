       STA AREG,B; LDX IPTR,B; JPL I (LEN
       SKP IF DD EQL 0; JMP PF2
P10,   LDX PTR1,B; JPL I (LEN; SKP IF DD UEQ 0; JMP PSS
       LDT PTR1,B; JPL I (TRIM
       LDX PTR1,B; JPL I (GC; AAA -##,; JAF PSS
       LDX PTR1,B; JPL I (GCI; JMP *+1
       LDT PTR1,B; JPL I (TRIM; JMP PSS
P20,   LDX PPTR,B; JPL I (GCI; JMP PF1
       AAA -##[; JAF P20
P11,   LDX PPTR,B; JPL I (GCI; JMP PF1
       SAT ##]; SKP IF DA UEQ ST; JMP P12
       JPL I (TCO; MIN NBLK,B; JMP P11
P12,   LDX PTR2,B; JPL I (STRST; SAA -1; ADD NBLK,B; STA NBLK,B
