%PCFX
%GET A PARAMETER PATTERN STRING
%X = STRING
%A = PARAMETER PATTERN NUMBER
%RETURN
%FAILURE RETURN IF NO SUCH STRING

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV9B,P1,PCFX
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV9B; P1; SAVX
