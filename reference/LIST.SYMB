       LDT I (CMDLN; LDX PTR,B; SAA 1; JPL I (PCF; JMP MSS
       LDX PTR,B; LDA (MTP2; SAT 2; JPL I (OPEN; JMP MF2
       STA FNUM,B; COPY DT SA; SAA 0
       SAX 0; JPL I (GETPG; JMP MF2
       STX OBJ,B; AAX 100; STX CTBL,B
       SAX 17; LDA I OBJ,B,X; SUB (131313; JAF MF1
M2,    LDT I (CMDLN; JPL I (TRIM
       LDX I (CMDLN; JPL I (LEN; SKP IF DD UEQ 0; JMP MSS
       LDT I (CMDLN; SAA 17; JPL I (PCF; JMP MSS
       SHA ZIN SHR 13; LDT (MSTRT; SHT ZIN SHR 13
       RSUB DA ST; JAN MFX; SHA 1; STA II2,B
       LDX CTBL,B; LDA I II2,B,X; BSET ZRO 160 DA
       STA I II2,B,X; JMP M2
MFX,   LDT FNUM,B; JPL I (CFILE; JMP *+1
MFF,   JPL I (UNLOK; RET

       RCLR DP AD1
       MSS,   MIN LREG,B; JMP MFX
MF1,   LDX (MS1; JPL I (MSG; JMP MSS
MF2,   JPL I (ERMSG; JMP MSS
       )FILL
       )PCL MRENT


