%CRUSR
%CREATE USER
%RETURN
%CALLING USER MUST BE 'SYSTEM'

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV7,C1,CRUSR
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV7; C1; SAVX
)KILL BLUES
BLUES=*
GLOB/
CRUSR=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA CSTR,5
CSTR=ZYX
       )KILL ZYX
ZYX=CSTR+5;
       
       DATA CPTR,1
CPTR=ZYX
       )KILL ZYX
ZYX=CPTR+1;
       
       DATA XTR,7
XTR=ZYX
       )KILL ZYX
ZYX=XTR+7;
       
       DATA CNT,1
CNT=ZYX
       )KILL ZYX
ZYX=CNT+1;
       
       DATA OBJ,1
OBJ=ZYX
       )KILL ZYX
ZYX=OBJ+1;
       
MS0,   'USER NUMBER =  '
MS1,   'YOU MAY NOT DO THIS$ '
MS2,   'AMBIGUOUS$ '
MS3,   'ALREADY EXISTS$ '
MS4,   'TOO LONG$ '
MS5,   'NO MORE ROOM$ '

C1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; JPL I (LOCK
       LDA I (CINF; ADD (TTYTB; COPY DX SA
       LDA 0,X; AAA -1; JAF CF1
       SAX XTR; RADD DX SB; SAT 0; SAA 7; JPL I (SETB
       LDX (USRTB; LDT (USRDK; SAA 1; JPL I (XDISK; JMP *-4
       STSET CPTR,CSTR,STR,16
       SAX CSTR; RADD DX SB; STX CPTR,B; SAT STR;
% **** ERROR AT: 031637 **** RANGE EXCEEDED

       RADD DT SB; SAA 16; SAD SHR 20; JPL I (SETUP
       
       LDT I (CMDLN; LDX CPTR,B; SAA 16; JPL I (PCF; JMP CFF+1
C2,    LDX CPTR,B; LDT (USARR; SAA 1; COPY DD SA
       LDA (USRTB; JPL I (ABLKP; JMP *+2; JMP CF3
       AAA 2; JAZ CF2
       RCLR DD; SAX XTR; RADD DX SB; JPL I (CRUSE; JMP CF3
       AAA -1; STA CNT,B; SHA 3; ADD (USRTB; STA OBJ,B
       LDX OBJ,B; SAT 0; SAA 10; JPL I (SETB
       LDX (USRTB; LDT (USRDK; SAA 3; JPL I (XDISK; JMP *-4
       LDX (MS0; JPL I (MSG; LDA CNT,B; AAA 1
       SAT 12; JPL I (IOUT; JPL I (CRLF; JMP CFF+1
CF1,   LDX (MS1; JMP CFF
CF2,   LDX (MS2; JMP CFF
CF3,   LDX (MS3; JMP CFF
CF4,   LDX (MS4; JMP CFF
CF5,   LDX (MS5
CFF,   JPL I (MSG; JPL I (UNLOK; SRET

       LDX I *+3; MIN LREG,X; JPL I *+2
       SPTR; USTK
              )FILL
       )PCL CRUSR


%LUSR
