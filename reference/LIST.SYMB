)WRTM
)WRITE QOV9D
 
:000265        

       )LINE       OVERL OV10
OV10=RQR
       )KILL RQR
RQR=OV10+1
ROVER/
       


%DLUSR
%DELETE USER
%T = USER NUMBER
%A = DEVICE ID
%RETURN
%FAILURE RETURN A
%A = ERROR CODE

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV10,D1,FDLUS
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV10; D1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FDLUS=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA DKAD,1
DKAD=ZYX
       )KILL ZYX
ZYX=DKAD+1;
       
       DATA CNT,1
CNT=ZYX
       )KILL ZYX
ZYX=CNT+1;
       
       DATA CNTX,1
CNTX=ZYX
       )KILL ZYX
ZYX=CNTX+1;
       
       DATA CNT1,1
CNT1=ZYX
       )KILL ZYX
ZYX=CNT1+1;
       
       DATA CNT2,1
CNT2=ZYX
       )KILL ZYX
ZYX=CNT2+1;
       
       DATA INDX,1
INDX=ZYX
       )KILL ZYX
ZYX=INDX+1;
       
       DATA OBJ,1
OBJ=ZYX
       )KILL ZYX
ZYX=OBJ+1;
       
       DATA TCNT,1
TCNT=ZYX
       )KILL ZYX
ZYX=TCNT+1;
       

D1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; JPL I (LOCK; JPL I (KDEV; JPL I (DVERR
       JPL I (UNDK; JMP DF4; STA DKAD,B; STZ TCNT,B
       SAA 1; STA CNT,B; STZ CNTX,B
D2,    LDA DKAD,B; ADD CNT,B; COPY DT SA; LDA AREG,B
       JPL I (RBLOC; JMP *-1
       LDA CNTX,B; SHA 5; ADD (BTEMP; STA OBJ,B
       SAX 1; LDA I OBJ,B,X; JAF *+3; STZ I (BTEMP-4; JMP D2C
       SAX 21; LDA I OBJ,B,X; STA INDX,B; STZ I (BTEMP-4
       SAA -1; STA CNT1,B; STZ CNT2,B; JMP D4C
D3,    LDX (BTEMP; LDT I CNT2,B,X; SKP IF DT UEQ 0; JMP D3C
       LDA AREG,B; JPL I (RTRK; JMP *+1; MIN TCNT,B
       LDX (BTEMP; STZ I CNT2,B,X
D3C,   MIN CNT2,B; LDA CNT2,B; SUB (400; JAN D3
       JPL I (WBLOK; STZ CNT2,B
D4C,   MIN CNT1,B; LDA CNT1,B; AAA -10; JAP D5
       LDA CNT1,B; ADD INDX,B; COPY DT SA; LDA AREG,B
       JPL I (RBLOC; JMP *-1; JMP D3
D5,    LDT INDX,B; LDA AREG,B; JPL I (RTRK; JMP *+1; MIN TCNT,B
D2C,   MIN CNTX,B; LDA CNTX,B; AAA -10; JAN D2; STZ CNTX,B
       MIN CNT,B; LDA CNT,B; AAA -10; JAN D2
       LDA TCNT,B; AAA 1; COPY CM2 DA SA; SAT 1; JPL I (UTRK; JMP *+1
       SAA 0; LDT TREG,B; JPL I (UTRK; JMP *+5
       COPY CM2 DA SA; SAT 1; JPL I (UTRK; JMP *+1
       LDA AREG,B; LDT DKAD,B; JPL I (RTRK; JMP *+1
       LDA TREG,B; AAA -1; RCLR DD; SAD SHR 5; AAA 1
       STA OBJ,B; COPY DT SA; LDA AREG,B; JPL I (RUTBL; JMP *-1
       SAA 0; SAD 10; ADD (USTBL; COPY DX SA
       SAT 0; SAA 10; JPL I (SETB
       LDT OBJ,B; LDA AREG,B; JPL I (WUTBL
       MIN LREG,B; JMP DF4+2
DF4,   SAA 4; STA AREG,B; JPL I (UNLOK; RET

       RCLR DP AD1
              )FILL
       )PCL FDLUS



%CRUSE
%CREATE USER
%D = DEVICE ID
%X = POINTER TO USER NAME
%RETURN A
%A = USER NUMBER
%FAILURE RETURN A
%A = 1 IF NO MORE TRACKS
%A = 2 IF TOO MANY USERS
%A = 3 IF USER ALREADY EXISTS

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV10,C1,FCRUS
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV10; C1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FCRUS=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA CNT,1
CNT=ZYX
       )KILL ZYX
ZYX=CNT+1;
       
       DATA CNTX,1
CNTX=ZYX
       )KILL ZYX
ZYX=CNTX+1;
       
       DATA XCNT,1
XCNT=ZYX
       )KILL ZYX
ZYX=XCNT+1;
       
       DATA XCNTX,1
XCNTX=ZYX
       )KILL ZYX
ZYX=XCNTX+1;
       
       DATA ACNT,1
ACNT=ZYX
       )KILL ZYX
ZYX=ACNT+1;
       
       DATA ACNTX,1
ACNTX=ZYX
       )KILL ZYX
ZYX=ACNTX+1;
       
C1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; JPL I (LOCK; SAA 1; STA CNT,B; STZ XCNT,B
       SAA -1; STA ACNT,B; STA ACNTX,B
       LDA DREG,B; JPL I (KDEV; JPL I (DVERR
C2,    LDA DREG,B; LDT CNT,B; JPL I (RUTBL; JMP *-1
       STZ CNTX,B
C3,    LDA CNTX,B; SHA 3; ADD (USTBL; COPY DT SA
       LDX XREG,B; SAA 7; JPL I (BEQL; JMP *+2; JMP CF3
       COPY DX ST; LDA 0,X; JAF *+7; LDA ACNT,B; JAP *+5
       LDA CNT,B; STA ACNT,B
       LDA CNTX,B; STA ACNTX,B; MIN CNTX,B
       LDA CNTX,B; AAA -40; JAN C3
       LDT CNT,B; LDA DREG,B; JPL I (WUTBL; MIN CNT,B
       LDA CNT,B; AAA -10; JAN C2
       LDA ACNT,B; JAN CF2; COPY DT SA
       LDA DREG,B; JPL I (RUTBL; JMP *-1
       LDA DREG,B; JPL I (GTRK; JMP CF1; COPY DT SA
       LDA ACNTX,B; SHA 3; ADD (USTBL; COPY DX SA
       STT 7,X; COPY DT SX; LDX XREG,B
       SAA 7; JPL I (BCOPY
       LDA ACNT,B; AAA -1; SHA 5; ADD ACNTX,B; AAA 1; STA AREG,B
       LDT ACNT,B; LDA DREG,B; JPL I (WUTBL
       LDT AREG,B; LDA DREG,B; SAX 0
       JPL I (IUSER; JPL I (FTLER
       LDA AREG,B; AAA -1; JAZ *+5
       SAA 1; SAT 1; JPL I (UTRK; JMP CF
       MIN LREG,B; JMP CF+1
CF1,   LDT ACNT,B; LDA DREG,B; JPL I (WUTBL
       SAA 1; JMP CF
CF2,   SAA 2; JMP CF
CF3,   LDT CNT,B; LDA DREG,B; JPL I (WUTBL; SAA 3
CF,    STA AREG,B; JPL I (UNLOK; RET

       RCLR DP AD1
              )FILL
       )PCL FCRUS


%IUSER
%INITIALIZE USER
%A = DEVICE ID
%X = NUMBER OF TRACKS
%T = USER NUMBER
%RETURN
%FAILURE RETURN IF NO SUCH USER

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV10,I1,FIUSE
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV10; I1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FIUSE=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA DKAD,1
DKAD=ZYX
       )KILL ZYX
ZYX=DKAD+1;
       
       DATA CNT,1
CNT=ZYX
       )KILL ZYX
ZYX=CNT+1;
       
I1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; JPL I (LOCK
       JPL I (UNDK; JMP IFF; STA DKAD,B
       LDA AREG,B; LDT DKAD,B; JPL I (RBLOC; JMP *-1
       LDX (BTEMP; STZ 0,X; LDA (731; STA 1,X
       LDA XREG,B; STA 2,X; AAX 3; SAT 0; LDA (400-3
       JPL I (SETB; JPL I (WBLOK; SAA 1; STA CNT,B
I2,    LDA DKAD,B; ADD CNT,B; COPY DT SA; LDA AREG,B
       JPL I (RBLOC; JMP *-1; LDX (BTEMP; SAT 0
       LDA (400; JPL I (SETB; JPL I (WBLOK; MIN CNT,B
       LDA CNT,B; AAA -10; JAN I2; MIN LREG,B
IFF,   JPL I (UNLOK; RET

       RCLR DP AD1
              )FILL
       )PCL FIUSE


%GETUN
%GET USER NUMBER
%D = DEVICE ID
%X = POINTER TO USER NAME
%RETURN A
%A = USER NUMBER
%FAILURE RETURN A
%A = 4 IF NO SUCH USER

       PROGM

       )KILL ZYX
ZYX=1
       
       GOVER OV10,G1,FGETU
GLOB=*
BLUES/
BLOB=*
       STX I *+5; SAX 0; SWAP DP SX; OV10; G1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FGETU=BLOB
)KILL BLOB
)KILL GLOB
       
       DATA CNT,1
CNT=ZYX
       )KILL ZYX
ZYX=CNT+1;
       
       DATA CNTX,1
CNTX=ZYX
       )KILL ZYX
ZYX=CNTX+1;
       
G1,    ENTER

       STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
              COPY DB SX; JPL I (LOCK; SAA 1; STA CNT,B
       LDA DREG,B; JPL I (KDEV; JPL I (DVERR
G2,    LDA DREG,B; LDT CNT,B; JPL I (RUTBL; JMP *-1
       STZ CNTX,B
G3,    LDA CNTX,B; SHA 3; ADD (USTBL; COPY DT SA
       LDX XREG,B; SAA 7; JPL I (BEQL; JMP G4
       STZ I (USTBL-4; LDA CNT,B; AAA -1; SHA 5
       ADD CNTX,B; AAA 1; STA AREG,B; MIN LREG,B; JMP GFF
G4,    MIN CNTX,B; LDA CNTX,B; AAA -40; JAN G3
       STZ I (USTBL-4; MIN CNT,B; LDA CNT,B
       AAA -10; JAN G2; SAA 4; STA AREG,B
GFF,   JPL I (UNLOK; RET

       RCLR DP AD1
              )FILL
       )PCL FGETU


       OVERX QOV10
QOV10=*-ROVER
)9MOVE ROVER VOR VORS
GLOB=VOR
)KILL VOR
VOR=GLOB+VORS
