%MEMORY PROTECT INTERRUPT

"NN10
LEV14, LDX I (RBLOK; LDA 0,X; STA INST; COPY DD SA
       JPL DECOD

%ILLEGAL INSTRUCTION

LILL,  SAA -1; ADD I (RBLOK; STA I (RBLOK
       LDA (TRAP; STA I (UBLOK
       SAA 2; MCL PID; SAA 4; MST PID
LEVX,  LDX I (EXRGP; JXZ LEVX1; STZ I (EXRGP
       LDF I (SAVEX; STF 0,X
LEVX1, WAIT; JMP LEV14
INST,  0

%MONITOR CALL

LMON,  LDA (LEV3; STA I (MBLOK
       LDA INST; AND (377; STA I (MCODE
       SAA -1; ADD I (RBLOK; STA I (RBLOK
       SAA 10; MST PID; JMP LEVX

%DECODE ROUTINE

DECOD, LDX (DECTB
DEC1,  LDA 0,X; JAF DEC2; EXIT
DEC2,  LDA 1,X; RAND DA SD; SUB 0,X; JAZ DEC3
       AAX 3; JMP DEC1
DEC3,  LDX 2,X; MIN I (RBLOK; JMP *+1
       JPL 0,X; JMP LILL; JMP LEVX
       )FILL
       )PCL DECOD

%SIMULATED INSTRUCTION TABLE

DECTB, 161000; 177400; LMON            % MONITOR CALL
       153000; 177400; LMON            % MONITOR CALL
       142200; 177777; LBYTE            % LOAD BYTE
       142600; 177777; SBYTE            % STORE BYTE
       141200; 177700; RGMPY            % REGISTER MULTIPLY
       141600; 177707; RGDIV            % REGISTER DIVIDE
       140600; 177707; EXRG             % EXECUTE REGISTER
       143777; 177777; EXRGF            % EXECUTE REGISTER FINISHED
       160000; 174000; LILL            % IOT GROUP
       150000; 174000; LILL            % MIS GROUP
       0


%LBYTE

LBYTE,  LDA I (XRGR; SHA SHR 1; ADD I (TRGR
       COPY DX SA; LDA 0,X
       BSKP ONE SSM; JMP LBYTE2; AND (377
LBYTE1, STA I (ARGR; EXIT AD1
LBYTE2, SHA ZIN SHR 10; JMP LBYTE1
       )FILL
       )PCL LBYTE


%SBYTE

SBYTE,  LDA I (XRGR; SHA SHR 1; ADD I (TRGR; COPY DX SA
       BSKP ZRO 170 DX; EXIT
       LDA (40000; SKP IF DX GRE SA; EXIT
       BSKP ONE SSM; JMP SBYTE2
       LDA I (ARGR; AND (377; COPY DD SA
       LDA 0,X; AND (177400
SBYTE1, RORA DA SD; STA 0,X; EXIT AD1
SBYTE2, LDA I (ARGR; SHA 10; COPY DD SA
       LDA 0,X; AND (377; JMP SBYTE1
       )FILL
       )PCL LBYTE


%RGMPY

RGMPY,  SAX 7; RAND DX SD; LDX I ,X (REGTB; LDT 0,X
       SHD SHR 3; SAX 7; RAND DX SD; LDX I ,X (REGTB
       LDA 0,X; COPY DD ST
       JAZ RMP4; SKP IF DD UEQ 0; JMP RMP4
       SWAP CLD DT SA; SAX -20; BSET SSM ZRO
RMP1,  BSKP IF SSM ZRO; JMP RMP2
       BSKP IF ZRO DD; RSUB DA ST; JMP RMP3
RMP2,  BSKP IF ONE DD; RADD DA ST
RMP3,  SAD SHR 1; JNC RMP1; JMP RMP5
RMP4,  RCLR DA; RCLR DD
RMP5,  STD I (ARGR; EXIT AD1
       )FILL
       )PCL RGMPY


%RGDIV

RGDIV,  LDT (40040; LDD I (ARGR; JAP RDI1
       COPY CM2 DD SD; COPY CM1 ADC DA SA
       BSET 170 DT ONE; JAN RDI3; JMP RDI2
RDI1,  JAF RDI2; SKP IF DD EQL 0; JMP RDI2
       SAT 0; JMP RDI3
RDI2,  SAD 1; AAT -1; JAP RDI2
RDI3,  STF TEMP1; LDA I (INST; SHA SHR 3
       SAX 7; RAND DX SA; LDX I ,X (REGTB
       LDA 0,X; NLZ 20; STF TEMP2
       LDF TEMP1; FDV TEMP2; STF TEMP4
       BSKP IF 170 DT ZRO; JMP RDI7
       LDF KKP; FSB TEMP4; JMP RDI8
RDI7,  BSET 170 DT ZRO; STF TEMP3
       LDF KKN; FSB TEMP3
RDI8,  BLDA 170 DT; LDA I (SRGR; BORA SSZ DA; BSTA SSZ DA; STA I (SRGR
       LDF TEMP4; BSKP IF 170 DT ONE; JMP RDI4
       BSET 170 DT ZRO; DNZ -20; COPY CM2 DA SA; JMP RDI5
RDI4,  DNZ -20
RDI5,  STA I (ARGR
       NLZ 20; FMU TEMP2; BSET 170 DT BCM; FAD TEMP1
       DNZ -20; STA I (DRGR; EXIT AD1
TEMP1, 0; 0; 0
TEMP2, 0; 0; 0
TEMP3, 0; 0; 0
TEMP4, 0; 0; 0
KKP,   40017; 177776; 0
KKN,   40020; 100000; 0
       )FILL
       )PCL RGDIV


%EXRG

EXRG,   SHD SHR 3; SAX 7; RAND DX SD; LDX I ,X (REGTB
       LDA 0,X; LDT I (INST; SKP IF DA UEQ ST; EXIT
       STA I (INST; AND (177400
       LDT (124000; SKP IF DA UEQ ST; EXIT
       LDT (134000; SKP IF DA UEQ ST; EXIT
       LDT (130000; SKP IF DA UEQ ST; EXIT
       LDA I (INST; AND (174007
       LDT (144002; SKP IF DA UEQ ST; EXIT
       LDT (174002; SKP IF DA UEQ ST; EXIT
       LDA I (INST; COPY DD SA; AND (177707
       LDT (140600; SKP IF DA UEQ ST; JMP EXRG
       LDX I (RBLOK; LDF -1,X; STF I (SAVEX
       LDA I (INST; STA -1,X
       LDA (143777; COPY DD SA; STD 0,X
       AAX -1; STX I (EXRGP
       SAA -1; ADD I (RBLOK; STA I (RBLOK
       JMP I (LEVX1
       )FILL
       )PCL EXRG

%EXRGF

EXRGF,  SAA -1; ADD I (RBLOK; STA I (RBLOK
       JMP I (LEVX
       )FILL

REGTB, (0; DRGR; RBLOK; BRGR
       LRGR; ARGR; TRGR; XRGR
       )FILL
"





%MONITOR CALL TRANSFER VECTOR

MCTBL, LEAVE; INBT; OUTBT; ECHOM; BRKM
       RDISK; WDISK; RPAG; WPAG; RCTIM
       EDIT; CIBUF; COBUF; SETUP; GCI; GCD
       WCI; WCD; GC; LEN; SETR; SETW
       ABLKP; STEQL; STARR; GCMD; MSG
       DIV; NORM; IOUT; CNS; CSN; TRIM
       BCOPY; OPEN; CFILE; GCLIN; DBRK
       GBRK; SBRK; OPIII; BROAD; GUNUM
       GUNAM; PMSG; IMAIL; GMAIL; WHUSR
       ABLKU; GCMD; STARR; SOUT; ERMSG
       QERMS; ISIZE; OSIZE; EXEC; UGNXT
       UDLTR; XDRD; SSTAT; RSTAT; SETBS
       RWACM; TTIM; RKLOK; MDRIV; RDATE
       PDATE; IOCLL; ESCTR; RESUM
       RMAXB; SMAXB; LF; MO113
       REABT; SETBT; SFLOP; ZFLOP
       TMSFL
MCSIZ=*-MCTBL


%LEV3
%MONITOR CALL PROCESSOR

"NN10
LEV3,  LDA I (MCODE
"
       LDT (MCSIZ; SKP IF DA LST ST; JMP LF
       LDX (MCTBL; RADD DX SA; LDA 0,X; JAZ LF; COPY DB SA
"NN10
       LDX I 9RBL1; LDF I 9RBL2
"
       JPL 0,B; JMP *+3; JMP LL2; JMP LL3
"NN10
LL0,   MIN I 9RBL; STX I 9RBL1; STF I 9RBL2
"
LL1,   WAIT; JMP LEV3
"NN10
LL2,   MIN I 9RBL; JMP LL0
"
"NN10
LL3,   SAA 2; ADD I 9RBL; STA I 9RBL; JMP LL1
"
LF,    LDA (TRAP; STA I (UBLOK
       SAA 2; MCL PID
       SAA 4; MST PID; WAIT; JMP LEV3
       )FILL

9RBL1, RBLK1
9RBL2, RBLK2
9RBL,  RBLOK

       )PCL LEV3


%LEAVE
%RETURN TO COMMAND PROCESSOR

LEAVE, LDA (START
"NN10
       STA I (UBLOK
"
       SAA 2; MCL PID; SAA 4; MST PID
       WAIT; JMP LEV3
       )FILL
       )PCL LEAVE


%ESCTR
%SET ESCAPE TRAP ADDRESS

ESCTR, STA I (RUBAD; EXIT
       )FILL


%RESUM
%RESUME EXECUTION FROM RUBPR

RESUM, INTDS; STA RESA; LDA I (RUBPR; AAA -1
"NN10
       STA I (RBLOK
"
       LDA RESA; INTEN; EXIT
RESA,  0
       )FILL
       )PCL RESUM
TMS,   0                     % 0 IF DIABLO, ELSE TMS


% SFLOP - SET FLOPPY DISK FLAG

SFLOP, MIN I (FLOPF; EXIT
       )FILL


% ZFLOP - RESET FLOOPY DISK FLAG

ZFLOP, STZ I (FLOPF; EXIT
       )FILL


%RCTIM
%READ COMPUTE TIME CLOCK

RCTIM, INTDS; STX RCTX; LDX I (PRT; LDD 2,X
       LDX RCTX; INTEN; EXIT
RCTX,  0
       )FILL
       )PCL RCTIM


%EXEC
%SET PROGRAM TO EXEC MODE
%RETURN -1

"NN10
EXEC,  LDA I (CINF; ADD (TTYTB; COPY DX SA
       LDA 0,X; AAA -1; JAF EXECF
       SAA -1; STA I (RBLKX; EXIT AD1
EXECF, SAA 0; EXIT AD1
       )FILL
       )PCL EXEC
"

"K14
MXM=177
"


"NK4 NN10
%SMPR
%SET MPR REGISTER
%RETURN

SMPR,  STA SMPA; STX S