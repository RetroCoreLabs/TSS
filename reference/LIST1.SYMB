       LDX (VCTBL; SAT 0; LDA (NPGS+NPGS; JPL I 9SETB
       STZ I 9RUB; STZ I (XSTOP; STZ I (EXRGP
       STZ I (PESC; STZ I (ELOCK; STZ I (UIBTB; STZ I (ACTLK
       LDA I (PRT; SUB (PRT1; SHA ZIN SHR 3; AAA 1
       STA I 9COF; STA I 9CINF; COPY DT SA
       INTDS; JPL I 9IBUF; INTEN; LDT I 9COF; AAT NTTY
       INTDS; JPL I 9IBUF; INTEN
       LDT I 9CINF; SAA 0; JPL I (SBRKS; JPL I (SECHS
       SAT 1; LDA I 9CINF; ADD (UEKTB; COPY DX SA; STT 0,X
       LDA I 9CINF; ADD (UBRTB; COPY DX SA; STT 0,X
       LDA I 9CINF; AAA -1; SHA 1; ADD (CSTIM; COPY DX SA
       STZ 0,X; STZ 1,X
       JMP I (S5
