%CARD READER DRIVER

CARD1, COPY DA SL; STA CARDL
"NN10
       IOT ACT DCR; LDT (7400; SKP IF DA UEQ ST; JMP C1
"
C0,    LDX PTR; LDT 9CTBE; SKP IF DX LST ST; JPL CF
       STA 0,X; MIN PTR
"NN10
       IOT PIN DCR; JMP I CARDL
"
C1,    LDA PTR; LDT 9CTBE; SKP IF DA EQL ST; JPL CF
       LDX PTR; RDCR DX; LDT 9CTBB; JMP C4
C2,    SKP IF DX GRE ST; JMP C3
       LDA 0,X; JAF C4; RDCR DX; JMP C2
C3,    AAX 1
C4,    STX PTRE; STT PTR
C5,    LDX PTR; LDT PTRE; SKP IF DT GRE SX; JMP C6
       LDA 0,X; JPL CONV; SAT CRDDV; JPL I 9WBUF
       0; JMP CF; MIN PTR; JMP C5
C6,    LDA (215; SAT CRDDV; JPL I 9WBUF; 0; JMP CF
       SAA 12; SAT CRDDV; JPL I 9WBUF; JMP *+2; JMP CF
       LDA 9CTBB; STA PTR
       LDX (BUFTB; AAX CRDDV; LDX 0,X
       LDA -2,X; SHA 1; AAA -122; STA TEMP
       SAT CRDDV; JPL I (SBUF; LDA TEMP
       SKP IF DA GRE SD; JMP C7
"NN10
       IOT PIN ACT DCR+1
"
       SAT CRDDV; JPL I (BUSST; JMP I CARDL
C7,    SAT CRDDV; JPL I (BUSZR; JMP I CARDL
CF,    SAA 25; SAT CRDDV; JPL I 9WBUF; 0; JMP CF
       LDA 9CTBB; STA PTR
"NN10
       JMP C7
"
CARDL, 0
PTRE,  0
TEMP,  0
9WBUF, WBUF
9CTBE, CTBE-1
9CTBB, CTBB
       )FILL
       )PCL CARD1
       )KILL PTR




%CONV
%CONVERT BETWEEN CARD CODE AND ASCII
%RETURN

CONV,  COPY DT SA; SHA ZIN SHR 6; COPY DX SA
       COPY DA ST; AND (77; LDT I CTL1,X
       COPY DX SA; LDA I CTL2,X; RADD DA ST
       SHA ZIN SHR 11; COPY DX SA; LDA I CTL1,X
       AND (377; EXIT
CTL1,  CTB1
CTL2,  CTB2
       )FILL



