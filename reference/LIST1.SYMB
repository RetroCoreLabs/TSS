"





%TTYDI
%TELETYPE INPUT DRIVER
%T = TELETYPE NUMBER
%RETURN

TTYDI, COPY DA SL; STA TTYDL; STT TDEV
       LDX (TDEVI; RADD DX ST
"NN10
       LDX 0,X; LDA (IOT ACT; RORA DA SX; STA *+1; 0
"
       STA TCHH; AND (177; STA TCH
"NN10
       LDA (IOT PIN; RORA DA SX
       STA L1; STA L3; STA L5
"DIAB
       SAA DIABD; SKP IF DA EQL SX; JMP L01
       LDA TCH; AAA -6; JAF L01; STZ I (DIABS; JMP L3
L01,   LDA TCH
"
LYY,   COPY DA ST; AAA -3; JAF LYYY; LDA I (FLOPF; JAZ LYYY
       LDA TCHH; STA TCH; JMP L0
LYYY,  LDA TCH; JPL I (CKPAR; BSET ONE 70 DA; STA TCH
       SAX 33; LDA TCH; AND (177; SKP IF DA EQL SX; JMP L0
LXX,   COPY DA ST; RDCR DA; SHA 3; ADD (PRT1; COPY DX SA
       LDA 4,X; BSET ONE 160 DA; STA 4,X; JMP L5
L0,    JPL I (SBUF; LDA (BUFTB; ADD TDEV; COPY DX SA
       LDX 0,X; LDA -2,X; COPY DT SA; SKP IF DD LST SA; JPL L4

L0B,   LDT TDEV; JPL I (ECFST; JAN *+3; LDA TCH; JMP L0A
       LDA TCH; LDT TDEV
       JPL I (ECHCH; JMP L0B+3
L0A,   JPL I (WBUF; JMP L5; JMP L5
"NN10
L1,    0
"
L2,    LDT TDEV; LDA TCH; JPL I (BRKCH
       JMP I TTYDL
"NN10
L3,    0; JMP I TTYDL
"
L4,    LDA TDEV; AAA -1; SHA 3; ADD (PRT1; COPY DX SA
       LDA 4,X; BSET ZRO 170 DA; BSET ONE 130 DA
       STA 4,X; EXIT
"NN10
L5,    0; JPL L4; JMP L3+1
"
TTYF,  JMP L3

TTYDL, 0
TDEV,  0
TCH,   0
TCHH,  0

       )FILL
       )PCL TTYDI

