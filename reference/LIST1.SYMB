%READ CHARACTER FROM TELETYPE
%T = TELETYPE NUMBER
%FAILURE RETURN IF NO CHARACTER

"NN10
IOXX=IOT PIN
"

RTTY,  COPY DA SL; STA I 9SAVL; STT I 9TDEV; INTDS
       JPL I (XEPTR; STA I (ECHXX
       JPL I 9RBUF; JMP RFF; INTEN; STA I 9TCH
       LDT I 9TDEV; INTDS; JPL I (ECFST; INTEN; JAP RTT1
RTT0,  LDA I 9TCH; AND (177; STA I (LCHR; LDA I 9TCH; JMP I 9EX2
RTT1,  LDA I (ECHXX; JAZ RTT0
RTT2,  LDT I 9TDEV; INTDS; JPL I (REBUF; JMP RTT7
RTT4,  INTEN; STA I 9TCHX; LDT I 9TDEV; JPL I (CKECH; JMP RTT4A
       INTDS; JPL I (ECHCH; JMP RTT8; INTEN
RTT4A, LDA I 9TCHX; LDT I 9TDEV; INTDS
       JPL I (SBRKC; JMP RTT3; INTEN; JMP RTT0
RTT3,  INTEN; JMP RTT2
RTT7,  INTEN; LDT I 9TDEV; SAA -1; INTDS
       JPL I (SECFS; INTEN; JMP RTT0
RTT8,  LDA I 9TDEV; AAA -1; SHA 3; ADD 9PRT1; COPY DX SA
       LDA 4,X; BSET ONE 170 DA; BSET ONE 150 DA
       STA 4,X; INTEN
       SAA 40; MST PID; COPY DA SA
       LDA I 9TCHX; JMP RTT4+2
RFF,   INTEN; LDA (TDEVI; ADD I 9TDEV; COPY DX SA
"NN10
       LDA 0,X; ADD (IOXX; INTDS; STA *+1; 0; INTEN
"
       LDA I 9TDEV; RDCR DA; SHA 3; ADD 9PRT1; COPY DX SA
       INTDS; LDA 4,X; BSET ONE 170 DA; STA 4,X
       LDT I 9TDEV; SAA -1; JPL I (SECFS; INTEN

       SAA 40; MST PID; COPY DA SA
       LDT I 9TDEV; JMP RTTY+3
       )FILL
       )PCL RTTY
       )KILL IOXX



9SAVL, SAVL
9RBUF, RBUF
9TDEV, TDEV
9TCH,  TCH
9PRT1, PRT1
9EX1,  EXIT1
9EX2,  EXIT2
9TCHX, TCHX







%RREA
%READ CHARACTER FROM HIGH SPEED READER
%FAILURE RETURN IF NO CHARACTER

RREA,  COPY DA SL; STA I 9SAVL; INTDS
       SAT READV; JPL I 9RBUF; JMP *+3
       INTEN; JMP I 9EX2
"NN10
       IOT PIN REA
"
RRS,   INTEN; JMP I 9EX1
       )FILL
       )PCL RREA


%RCARD
%READ A CHARACTER FROM THE CARD READER
%RETURN
%FAILURE RETURN IF NO CHARACTER

RCARD, COPY DA SL; STA I 9SAVL; INTDS
       SAT CRDDV; JPL I 9RBUF; JMP *+3
       INTEN; JMP I 9EX2
       SAT CRDDV; JPL I (BUSY; JAN RC1
"NN10
       IOT PIN ACT DCR+1; SAT CRDDV; JPL I (BUSST
"
RC1,   INTEN; JMP I 9EX1
       )FILL

       )KILL 9SAVL 9RBUF 9TDEV 9TCH 9PRT1
       )KILL 9EX1 9EX2 9TCHX

%CKECH
%CHECK IF CHARACTER SHOULD BE SENT TO THE ECHOOOO ROUTINE
%RETURN IF TRUE
%FRETURN IF FALSE

CKECH, INTDS; COPY DA SL; STA CKSVL
       JPL I (USERM; JMP *+3; JPL I (ECHST; JMP *+5
       LDA I (TDEV; ADD (UEKTB; COPY DX SA; LDA 0,X
       AAA -1; JAF CK2; LDA I (LCHR
       SAT 17; SKP IF DA UEQ ST; JMP CK1
       SAT 20; SKP IF DA UEQ ST; JMP CK1
       SAT 26; SKP IF DA UEQ ST; JMP CK1
       SAT 30; SKP IF DA UEQ ST; JMP CK1
       SAT 32; SKP IF DA UEQ ST; JMP CK1
CK2,   MIN CKSVL
CK1,   LDA CKSVL; COPY DL SA; INTEN
       LDA I (TCHX; LDT I (TDEV; EXIT
CKSVL, 0
       )FILL
       )PCL CKECH

9SAVL, SAVL
9BST,  BUSST
9EX1,  EXIT1
9EX2,  EXIT2
9TCH,  TCH
9TDEV, TDEV
9BUSY, BUSY
9WBUF, WBUF
9PRT1, PRT1

%WTTY
%WRITE CHARACTER ON TELETYPE
%A = CHARACTER
%T = TELETYPE NUMBER
%FAILURE RETURN IF BUFFER FULL

WTTYB, COPY DX SL; STX I 9SAVL; STT I 9TDEV
       STA I 9TCH; JMP WTTX1

WTTY,  COPY DX SL; STX I 9SAVL; STT I 9TDEV; STA I 9TCH; AAT NTTY
       INTDS; JPL I 9BUSY; JAN L1
       LDA (TDEVO; ADD I 9TDEV; COPY DX SA
"NN10
L00,   INTEN; LDA 0,X; ADD (IOT SKA; INTDS; STA *+1
       0; JMP *-6; INTEN; LDA 0,X; ADD (IOT PIN ACT; INTDS
       STA *+2; LDA I 9TCH; 0
"
       LDT I 9TDEV; AAT NTTY; JPL I 9BST; INTEN; JMP WTTX
L1,    LDA I 9TCH; LDT I 9TDEV; AAT NTTY; JPL I 9WBUF
       JMP L2; JMP WTF
WTS,   INTEN; JMP WTTX
WTF,   INTEN; LDT I 9TDEV; JMP WTTY+4
L2,    LDA I 9TDEV; RDCR DA; SHA 3; ADD 9PRT1; COPY DX SA
       LDA 4,X; BSET ONE 170 DA
       BSET ONE 150 DA; STA 4,X; INTEN
       SAA 40; MST PID; COPY DA SA
WTTX,  LDA (BUFTB; ADD I 9TDEV; COPY DX SA; LDX 0,X
       LDA 31,X; JAZ WTSS; STA I 9TDEV; COPY DT SA
WTTX1, AAT NTTY; INTDS; JPL I 9BUSY; JAN L11
       LDA (TDEVO; ADD I 9TDEV; COPY DX SA
"NN10
       INTEN; LDA 0,X; ADD (IOT SKA; INTDS; STA *+1
       0; JMP *-6; INTEN; LDA 0,X; ADD (IOT PIN ACT; INTDS
       STA *+2; LDA I 9TCH; 0
"
       LDT I 9TDEV; AAT NTTY; JPL I 9BST; INTEN; JMP I 9EX2
L11,   LDA I 9TCH; LDT I 9TDEV; AAT NTTY; JPL I 9WBUF
       JMP L22; JMP WTFF
WTSS,  INTEN; JMP I 9EX2
WTFF,  INTEN; LDT I 9TDEV; JMP WTTX1
L22,   LDA I 9TDEV; RDCR DA; SHA 3; ADD 9PRT1; COPY DX SA
       LDA 4,X; BSET ONE 170 DA
       BSET ONE 150 DA; STA 4,X; JMP WTSS

       )PCL WTTY

       )KILL 9SAVL 9BST 9EX1 9EX2 9TCH 9TDEV 9BUSY 9WBUF 9PRT1

9SAVL, SAVL
9BST,  BUSST
9EX1,  EXIT1
9EX2,  EXIT2
9TCH,  TCH
9TDEV, TDEV
9BUSY, BUSY
9WBUF, WBUF
9PRT1, PRT1

       )FILL




%WPNCH
%WRITE CHARACTER ON HIGH SPEED PUNCH
%A = CHARACTER
%FAILURE RETURN IF BUFFER FULL

WPNCH, COPY DT SL; STT I 9SAVL; STA I 9TCH; INTDS
       SAT PNCHD; JPL I 9BUSY; JAN L1
"NN10
       INTEN; IOT SKA DFP; JMP *-1; INTDS; LDA I 9TCH
       IOT PIN ACT DFP
"
       SAT PNCHD; JPL I 9BST; JMP WTS
L1,    LDA I 9TCH; SAT PNCHD; JPL I 9WBUF
       JMP WTS; JMP WTF
WTS,   INTEN; JMP I 9EX2
WTF,   INTEN; JMP I 9EX1
       )FILL
       )PCL WPNCH


"NN10
%WSPNC
%WRITE CHARACTER ON SLOW SPEED PUNCH
%A = CHARACTER
%FAILURE RETURN IF BUFFER FULL

WSPNC, COPY DT SL; STT I 9SAVL; STA I 9TCH; INTDS
       SAT SPNCD; JPL I 9BUSY; JAN L1
       INTEN; IOT SKA DSP; JMP *-1; INTDS; LDA I 9TCH
       IOT PIN ACT DSP; SAT SPNCD
       JPL I 9BST;   JMP WTS
L1,    LDA I 9TCH; SAT SPNCD; JPL I 9WBUF
       JMP WTS; JMP WTF
WTS,   INTEN; JMP I 9EX2
WTF,   INTEN; JMP I 9EX1
       )FILL
       )PCL WSPNC

"


%WPRNT
%WRITE A CHARACTER ON THE LINE PRINTER
%A = CHARACTER
%FAILURE RETURN IF BUFFER FULL

WPRNT, COPY DT SL; STT I 9SAVL; SAT 11; SKP DA UEQ ST
       SAA ## ; STA I 9TCH; INTDS

       SAT PNTDV; JPL I 9BUSY; JAN L1
"NN10
       INTEN; IOT SKA DLP; JMP *-1; INTDS; LDA I 9TCH
       IOT PIN ACT DLP
"
L20,   SAT PNTDV; JPL I 9BST; JMP WTS
L1,    LDA I 9TCH; SAT PNTDV; JPL I 9WBUF
       JMP WTS; JMP WTF
WTS,   INTEN; SAA 177; AND I 9TCH; AAA -12; JAF WTS1
"-VERSA
WTS0,  SAA ## ; JMP WPRNT+2
"
WTS1,  AAA -2; JAZ WTS0
WTSS,  JMP I 9EX2
WTF,   INTEN; JMP I 9EX1
       )FILL
       )PCL WPRNT




       )KILL 9SAVL 9EX1 9EX2 9TCH 9TDEV 9BST
       )KILL 9BUSY 9WBUF 9PRT1
       )KILL NU TBI1 TBI2 TBI3 TBI4 TBI5 TBI6
       )KILL TBI7 TBI8 TBI9 TBI10 TBI11 TBI12
       )KILL TBI13 TBI14 TBI15 TBI16 TBI17
       )KILL TBI18 TBI19 TBI20 TBI21 TBI22 TBI23 TBI24
       )KILL TBO1 TBO2 TBO3 TBO4 TBO5 TBO6
       )KILL TBO7 TBO8 TBO9 TBO10 TBO11 TBO12
       )KILL TBO13 TBO14 TBO15 TBO16 TBO17 TBO18
       )KILL TBO19 TBO20 TBO21 TBO22 TBO23 TBO24
       )KILL PPTR PPTP PRNTR CARD
       )KILL BB1 BB2 BB3 BB4 BB5 BB6
       )KILL BB7 BB8 BB9 BB10 BB11 BB12
       )KILL BB17 BB18 BB19 BB20 BB21 BB22
       )KILL BB23 BB24 BB25 BB26 BB27 BB28
       )KILL BB33 BB34 BB35 BB36 BB37
       )KILL BB113 BB114 BB115 BB116 BB117
       )KILL BB118 BB119 BB120 BB129 BB130
       )KILL BB131 BB132 BB133 BB134 BB135
       )KILL BB136 BB137 BB138 BB139 BB140
       )KILL BB121 BB122 BB123 BB124
       )KILL TTY1I TTY2I TTY3I TTY4I TTY5I TTY6I
       )KILL TTY7I TTY8I TTY9I TT10I TT11I TT12I
       )KILL TT13I TT14I TT15I TT16I TT17I
       )KILL TT18I TT19I TT20I TT21I TT22I TT23I TT24I
       )KILL TTY1O TTY2O TTY3O TTY4O TTY5O TTY6O
       )KILL TTY7O TTY8O TTY9O TT10O TT11O TT12O
       )KILL TT13O TT14O TT15O TT16O TT17O
       )KILL TT18O TT19O TT20O TT21O TT22O TT23O TT24O
       )KILL DLP DCR DSP


%LEV0
%TRAPS THE WAIT INSTRUCTION AND SENDS CONTROL
%TO LEVEL 2 (UTILITY)

"NN10
LEV0,  LDA (RINT
       STA I (UBLOK
       SAA 4; MST PID; COPY DA SA
       JMP LEV0
       )FILL

"

%DISK ADDRESSES

DKS
"DKS
DKS=0                        %START OF DISK
"

"CDC
DKBIT=50
"
CORL1=DKBIT+DKS+10           %CORELOAD 1
CORL2=CORL1+200              %CORELOAD 2
ACCTD=CORL2+200              %ACCOUNT DIRECTORY
DKLP=ACCTD-20                %LINE PRINTER BUFFER
DKFP=ACCTD-10                %FAST PUNCH BUFFER
MAILD=ACCTD+200              %MAILBOX
MAILS=200                    %SIZE OF MAILBOX
OVDK1=CORL1+100              %OVERLAY AREA 1
OVDK2=CORL2+100              %OVERLAY AREA 2
USRDK=MAILD+MAILS+400        %USER TABLE
DKA1=USRDK+10                %SWAP AREA 1
DKA2=DKA1+200                %SWAP AREA 2
DKA3=DKA2+200                %SWAP AREA 3
DKA4=DKA3+200                %SWAP AREA 4
DKA5=DKA4+200                %SWAP AREA 5
DKA6=DKA5+200                %SWAP AREA 6
DKA7=DKA6+200                %SWAP AREA 7
DKA8=DKA7+200                %SWAP AREA 8
DKA9=DKA8+200                %SWAP AREA 9
DKA10=DKA9+200               %SWAP AREA 10
DKA11=DKA10+200              %SWAP AREA 11
DKA12=DKA11+200              %SWAP AREA 12
FSYS=DKA12+200               %START OF FILE SYSTEM STORAGE


OVDK=OVDK1
CORLX=CORL1

CORLD=CORLX
)KILL CORLX


%
%PROCESS TABLE (PRT)
%

PRT1,  0     %PDTBL INDEX OF CONTEXT BLOCK
       0     %QUANTUM TIMER
       0; 0  %COMPUTE TIMER
       0     %STATUS         BIT15 = BLOCK BIT
             %               BIT14 = RUBOUT BIT
             %               BIT13 = BLOCK ON OUTPUT
             %               BIT12 = LOGON TIMER INTERRUPT
             %               BIT11 = I/O INTERRUPT
       0     %TTY USAGE:
             %NEGATIVE - TELETYPE SCANNER WILL SCAN THIS
             %               TELETYPE (PROCESS IS DEAD)
             %ZERO - SCHEDULER WILL INITIALIZE THIS PROCESS
             %POSITIVE - TELETYPE IN USE (PROCESS ALIVE)
       0     %FREE WORD
       0     %SAVED PID

PRT2,  BSS NTTY+NTTY+NTTY+NTTY+NTTY+NTTY+NTTY+NTTY-20
*+NTTY+NTTY+NTTY+NTTY+NTTY+NTTY+NTTY+NTTY-20/
       
PRTXX, BSS 10
*+10/
       



PRT,   0     %POINTER TO CURRENT PROCESS
QUANT, -17   %STANDARD QUANTUM (A NEGATIVE NUMBER)
LQUA,  24    %LARGE QUANTUM (SPECIFIES NUMBER OF SMALL QUANTUMS)


%LEV6 - TELETYPE SCANNER
%RUNS EVERY 80 MILLISECONDS

LEV6,  SAT NTTY; COPY CM2 DX ST
L1,    COPY DA ST AD1; RADD DA SX; AAA -DIABT; JAF L1A
       IOT ACT DIABD+2; BSKP ZRO 60 DA; JMP *+3
       LDA (177774; IOT ACT DIABD+3
L1A,   LDA I (LDIAB; JAZ L1B; AAA -DIABT; JAZ L1B
       COPY DA ST AD1; RADD DA SX; AAA -DIABT; JAZ L2
L1B,   COPY DA ST AD1; RADD DA SX
       AAA -3; JAF L1C; LDA I (FLOPF; JAF L2
L1C,   COPY DA ST; RADD DA SX; SHA 3; ADD (PRT1+5
       COPY DB SA; COPY DD SA; LDA 0,B; JAP L10
       COPY DA ST AD1; RADD DA SX; ADD (TDEVI
       COPY DB SA; LDA 0,B
"NN10
       ADD (IOT SKA ACT; STA *+1; 0; JMP L2
"
       AND (177; SUB (33; JAF L2
       COPY DB SD; STZ 0,B
L2,    SAT NTTY; JNC L1
       WAIT; JMP LEV6
L10,   COPY DA ST AD1; RADD DA SX; STA DEVN; ADD (TDEVI
       COPY DB SA; LDA 0,B
"NN10
       ORA (IOT PIN; STA *+1; 0; JMP L2
"
DEVN,  0
       )FILL
       )PCL LEV6


DABLE, 0     %DISABLE PROCESS SWITCHING


%LEV5 - SCHEDULER AND SWAPPER

%SCHEDULER RUNS FIRST:

LEV5,  LDX I 9PRT; STZ FLAG; LDA DABLE; JAN L3A
       LDA 1,X; JAP L0; LDA 4,X; JAP L1
L0,    AAX 10
"NN10
L1,    TRA OPR; LDT (25252; SKP IF DA EQL ST; JMP YY
       IOT SKA ACT RKE; JMP XX; AND (177; SAT 15
       SKP IF DA EQL ST; JMP *+7; LDA VAL
       STA I VALP; STZ VAL; MIN VALP; 0; JMP XX; SAT ##/
       SKP IF DA EQL ST; JMP *+6
       LDA VAL; STA VALP; LDA I VALP; STA VAL; JMP XX
       AAA -60; COPY DD SA; LDA VAL; SHA 3; RADD DA SD; STA VAL
XX,    LDA VAL; COPY DB SA; JMP ZZ
YY,    COPY DB SA; LDA 0,B; COPY DB SA
       LDA I (PRT1+5; JAN *+2; IOT PIN RKE
"
ZZ,    SAA NTTY; SHA 3; ADD 9PRT1
       SKP IF DX LST SA; LDX 9PRT1
       LDA I 9PRT; RSUB DA SX; JAF L2
       LDA FLAG; JAN L10
       SAA -1; STA FLAG
L2,    LDA 5,X; JAZ L5; JAN L0
       LDA 4,X; JAN L0; JAZ L3
       SAA 1; STA 5,X; SAA 0; JMP SWAPR
L3,    LDA FLAG; JAZ L0; MIN 5,X
       LDA 5,X; SUB I (LQUA; JAP L4
L3A,   SAA 0; JMP SWAPR
L4,    SAA 1; STA 5,X; JMP L0
L5,    SAA -1; JMP SWAPR
"NN10
L10,   JMP LEV5
"
VAL,   0
VALP,  0
FLAG,  0
       )FILL
9PRT,  PRT
9PRT1, PRT1
       )PCL LEV5






%*
%* ENTRY TO SWAPPER
%*

%SWAPR:      FLAG:=AREG; PRTX:=XREG;

SWAPR, STA I 9FLAG; STX I 9PRTX

%            PRT[7]:=PID;

       TRA PID; LDX I 9PRT; STA 7,X

%            IF PRT=PRTX DO;
%            GOTO SW1 IF FLAG>=0 ELSE GOTO S10;

       LDA I 9PRTX; SKP IF DA EQL SX; JMP SWP0
       LDA I 9FLAG; JAP SW1; JMP I (S10

%            ENDIF;

%* WRITE OUT CURRENT USERS CONTEXT BLOCK

%            READ'REG'BLOCK();
%            TRSFR(WRITE,@RBLOK,DKA1+(PRT[0] LSH 3)//TRERR);

"NN10
SWP0,  JMP *+1
"
       LDX I 9PRT; LDA 0,X; SHA 3; ADD 9DKA1; COPY DT SA
       LDX 9RBLO; SAA 3; JPL I 9TRSF; JPL I 9TRER

%            GOTO SYY IF FLAG<0;

       LDA I 9FLAG; JAP *+2; JMP I (SYY

%* READ IN NEW USERS CONTEXT BLOCK

%            TRSFR(READ,@RBLOK,DKA1+(PRTX[0] LSH 3)//TRERR);
%            WRITE'REG'BLOCK();

       LDA I PRTX; SHA 3; ADD 9DKA1; COPY DT SA
       LDX 9RBLO; SAA 1; JPL I 9TRSF; JPL I 9TRER


%* WRITE OUT ALL PAGES IN PCTBL WHICH CONFLICT WITH
%* THOSE IN VCTBL AND READ IN THE REQUIRED PAGES
%* OR DELETE THOSE PAGES FOR WHICH VCTBL[I]$X=1
%* AND VCTBL[I]$MD=0

%SW1:        FOR I:=0 TO NPGS-1 DO;

SW1,   STZ II
SWP1,  LDA II; SHA 1; STA II2; AAA 1; STA II2X

%* CONTINUE IF EMPTY VCTBL ENTRY

%            GOTO SWE IF VCTBL[I]$W0=0;

       LDX 9VCTB; LDA I II2,X; JAF *+2; JMP I 9SWE

%* CONTINUE IF VCTBL ENTRY CORRESPONDS TO PCTBL ENTRY

%SW3:        GOTO SWE IF VCTBL[I]$X=0 AND VCTBL[I]$W0=PCTBL[I];

SW3,   LDX 9VCTB; LDA I II2,X; BSKP ZRO 150 DA; JMP SWP2
       LDX 9PCTB; SUB I II,X; JAF SWP2; JMP I 9SWE

%* SEE IF PAGE IS TO BE DELETED

SWP2,  LDA II; JPL I (CKDEL; JMP I 9SWE

%* WRITE OUT PCTBL ENTRY IF IT CONTAINS A READ/WRITE PAGE

%            IF PCTBL[I]$MD=3 DO;

SWP2A, LDX 9PCTB; LDA I II,X; SHA ZIN SHR 16; AAA -3; JAF SWP3

%            TRSFR(WRITE,MSTRT+I*2048,DKA1+(PCTBL[I]$INDX LSH 3)
%                //TRERR);

       LDA I II,X; AND K1777; SHA 3; ADD 9DKA1; COPY DT SA
       LDA II; SHA 13; ADD 9MSTR; COPY DX SA
       SAA 3; JPL I 9TRSF; JPL I 9TRER

%            ENDIF;

%* CLEAR PCTBL ENTRY UNLESS IT CONTAINS A READ ONLY PAGE

%            PCTBL[I]:=0 IF PCTBL[I]$MD#2;

SWP3,  LDX 9PCTB; LDA I II,X; SHA ZIN SHR 16
       AAA -2; JAZ *+2; STZ I II,X

%* READ IN NEW PAGE

%* NEW PAGE IS FOUND IN PDTBL IF VCTBL[I]$X=0

%            GOTO SW4 IF VCTBL[I]$X=1;

       LDX 9VCTB; LDA I II2,X; BSKP ZRO 150 DA; JMP SW4

%            FTLER() IF PDTBL[VCTBL[I]$INDX]$COUNT<=0;

       AND K1777; SHA 1; ADD 9PDTB; COPY DX SA
       LDA 0,X; AND K77; JAF *+2; JPL I 9FTLE

%            TRSFR(READ,MSTRT+I*2048,DKA1+(VCTBL[I]$INDX LSH 3)
%                //TRERR);

       LDX 9VCTB; LDA I II2,X; AND K1777; SHA 3; ADD 9DKA1
       COPY DT SA; LDA II; SHA 13; ADD 9MSTR; COPY DX SA
       SAA 1; JPL I 9TRSF; JPL I 9TRER

%            PCTBL[I]:=VCTBL[I]$W0; GOTO SWE;

       LDX 9VCTB; LDA I II2,X; LDX 9PCTB; STA I II,X; JMP I 9SWE

9PRTX, PRTX
9TRSF, TRSFR
9TRER, TRERR
9FLAG, FLAG
9RBLO, RBLOK
9DKA1, DKA1
9PRT,  PRT
PRTX,  0

       )KILL 9PRTX 9TRSF 9TRER 9FLAG 9RBLO 9DKA1 9PRT
       )FILL

%* FIND A FREE OR UNUSED ENTRY (PREFERABLY FREE) IN PDTBL

%* INITIALIZE IDXA AND IDXB
%* IDXA: FIRST FREE ENTRY OR -1 IF NONE
%* IDXB: FIRST UNUSED ENTRY OR -1 IF NONE

%SW4:        IDXA:=IDXB:=-1; VCTBL[I]$X:=0;

SW4,   SAA -1; STA IDXA; STA IDXB
       LDX 9VCTB; LDA I II2,X; BSET ZRO 150 DA; STA I II2,X

%            FOR J:=0 TO NDPGS-1 DO;

       STZ J
SWP4,  LDA J; SHA 1; STA J2; AAA 1; STA J2X

%* SEE IF REQUIRED PAGE ALREADY EXISTS IF MD=2

%            GOTO SW5 IF VCTBL[I]$MD#2;

       LDX 9VCTB; LDA I II2,X; SHA ZIN SHR 16; AAA -2; JAF SW5

%            IF PDTBL[J]$MD=2 AND PDTBL[J]$W1=VCTBL[I]$W1 DO;

       LDX 9PDTB; LDA I J2,X; SHA ZIN SHR 16; AAA -2; JAF SW5
       LDA I J2X,X; LDX 9VCTB; SUB I II2X,X; JAF SW5

%* INCREMENT USAGE COUNTER IN PDTBL[J]

%            PDTBL[J]$COUNT:=PDTBL[J]$COUNT+1;

       LDX 9PDTB; MIN I J2,X

%            VCTBL[I]$INDX:=J; GOTO SW3;

       LDX 9VCTB; LDA I II2,X; AND K16B4; ADD J
       STA I II2,X; JMP SW3

%LOCAL VARIABLES

FLAG,  0
II,    0
II2,   0
II2X,  0

9TRSF, TRSFR
9TRER, TRERR
9RBLO, RBLOK
9DKA1, DKA1
9VCTB, VCTBL
9PCTB, PCTBL
9PDTB, PDTBL
9SWE,  SWE
K1777, 1777
K77,   77
K16B4, 160000
9FTLE, FTLER
9MSTR, MSTRT
9NDPG, NDPGS

IDX,   0
IDXX,  0
IDXX2, 0
IDXA,  0
IDXB,  0
J,     0
J2,    0
J2X,   0
VDKA,  0

%            ENDIF;

%* UPDATE IDXA AND IDXB

%SW5:        IF IDXA<0 AND PDTBL[J]$W0=0 DO;

SW5,   LDA IDXA; JAP SWP5; LDX 9PDTB; LDA I J2,X; JAF SWP5

%            IDXA:=J; GOTO SW6 IF VCTBL[I]$MD#2;

       LDA J; STA IDXA; LDX 9VCTB; LDA I II2,X
       SHA ZIN SHR 16; AAA -2; JAF SW6

%            ELSEIF IDXB<0 AND PDTBL[J]$COUNT=0 DO;

SWP5,  LDA IDXB; JAP SWP4C; LDX 9PDTB; LDA I J2,X; AND K77; JAF SWP4C

%            IDXB:=J;

       LDA J; STA IDXB

%            ENDIF;

%            ENDFOR;

SWP4C, MIN J; LDA J; SUB 9NDPG; JAN SWP4

%* FATAL ERROR IF NO FREE OR UNUSED ENTRY

%SW6:        FTLER() IF IDXA<0 AND IDXB<0;

SW6,   LDA IDXA; JAP SWP6; LDA IDXB; JAP SWP6; JPL I 9FTLE

%            IDX:=(IDXA IF IDXA>=0 ELSE IDXB);

SWP6,  STA IDX; SHA 1; STA IDXX; AAA 1; STA IDXX2

%* SET UP THE ACQUIRED PDTBL ENTRY AND VCTBL AND PCTBL

%            VCTBL[I]$INDX:=IDX; PCTBL[I]:=VCTBL[I]$W0;

       LDX 9VCTB; LDA I II2,X; AND K16B4; ADD IDX
       STA I II2,X; LDX 9PCTB; STA I II,X

%            PDTBL[IDX]$COUNT:=1; PDTBL[IDX]$MD:=VCTBL[I]$MD;

       AND K16B4; AAA 1; LDX 9PDTB; STA I IDXX,X

%            PDTBL[IDX]$W1:=(VCTBL[I]$W1 IF VCTBL[I]$MD=2 ELSE 0);

       SHA ZIN SHR 16; AAA -2; JAZ *+3; SAA 0; JMP *+3
       LDX 9VCTB; LDA I II2X,X; LDX 9PDTB; STA I IDXX2,X

%* IF A DISK ADDRESS WAS SUPPLIED, READ IN THE REQUIRED PAGE

%            GOTO SWE IF VCTBL[I]$W1=0;

       LDX 9VCTB; LDA I II2X,X; JAZ SWE; STA VDKA

%            TRXX(READ,MSTRT+I+2848,VCTBL[I]$W1//TRERR);

       LDT VDKA; LDA II; SHA 13; ADD 9MSTR; COPY DX SA
       SAA 1; JPL I (TRXX; JPL I 9TRER

%* IF THE NEW PAGE IS A READ ONLY PAGE IT MUST BE WRITTEN OUT

%            IF PDTBL[IDX]$W1#0 DO;

       LDX 9PDTB; LDA I IDXX2,X; JAZ SWE

%            TRSFR(WRITE,MSTRT+I*2048,DKA1+(IDX LSH 3)//TRERR);

       LDA IDX; SHA 3; ADD 9DKA1; COPY DT SA
       LDA II; SHA 13; ADD 9MSTR; COPY DX SA
       SAA 3; JPL I 9TRSF; JPL I 9TRER

%            ENDIF;

%SWE:        ENDFOR;

SWE,   MIN II; LDA II; SUB (NPGS; JAP S4; JMP I (SWP1

       )FILL



