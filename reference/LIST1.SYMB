%* AQCTX
%* ACQUIRE CONTEXT BLOCK
%* RETURN A
%* A = INDEX OF CONTEXT BLOCK IN PDTBL

%            FUNCTION AQCTX();

%* FIND A FREE OR UNUSED ENTRY (PREFERABLY FREE) IN PDTBL

%* INITIALIZE IDXA AND IDXB
%* IDXA: FIRST FREE ENTRY OR -1 IF NONE
%* IDXB: FIRST UNUSED ENTRY OR -1 IF NONE

%            IDXA:=IDXB:=-1;

AQCTX, SAA -1; STA IDXA; STA IDXB

%            FOR J:=0 TO NDPGS-1 DO;

       STZ J

%* UPDATE IDXA AND IDXB

%            IF IDXA<0 AND PDTBL[J]$W0=0 DO;

AQA,   LDA J; SHA 1; STA JJ
       LDA IDXA; JAP AQB; LDX 9PDTB; LDA I JJ,X; JAF AQB

%            IDXA:=J; GOTO AQ1;

       LDA J; STA IDXA; JMP AQ1

%            ELSEIF IDXB<0 AND PDTBL[J]$COUNT=0 DO;

AQB,   LDA IDXB; JAP AQC; LDX 9PDTB; LDA I JJ,X; AND K77; JAF AQC

%            IDXB:=J;

       LDA J; STA IDXB

%            ENDIF;

%            ENDFOR;

AQC,   MIN J; LDA J; SUB 9NDPG; JAN AQA

%* FATAL ERROR IF NO FREE OR UNUSED ENTRY

%AQ1:        FTLER() IF IDXA<0 AND IDXB<0;

AQ1,   LDA IDXA; JAP AQD; LDA IDXB; JAP AQD; JPL I 9FTLE

%            IDX:=(IDXA IF IDXA>=0 ELSE IDXB);

AQD,   SHA 1; STA IDX

%* SET UP THE ACQUIRED PDTBL ENTRY

%            PDTBL[IDX]$COUNT:=1;
%            PDTBL[IDX]$MD:=1;
%            PDTBL[IDX]$W1:=0;

       LDX 9PDTB; RCLR DD; LDA (40001; STD I IDX,X

%            RETURN IDX;

       LDA IDX; SHA SHR 1; EXIT

IDX,   0
IDXA,  0
IDXB,  0
J,     0
JJ,    0

9PDTB, PDTBL
9FTLE, FTLER
9NDPG, NDPGS
K77,   77

       )FILL
       )PCL AQCTX
&L
%* CKDEL
%* SEE IF PAGE SHOULD BE DELETED
%* A = INDEX IN VCTBL
%* RETURN
%* FAILURE RETURN IF PAGE IS TO BE DELETED

%            FUNCTION CKDEL(I);

CKDEL, STA II; SHA 1; STA II2

%            IF VCTBL[I]$X=1 AND VCTBL[I]$MD=0 DO;

       LDX 9VCTB; LDA I II2,X; BSKP ONE 150 DA; JMP CKS
       SHA ZIN SHR 16; JAF CKS

%            PCTBL[I]:=0 IF PCTBL[I]$INDX=VCTBL[I]$INDX;

       LDA I II2,X; AND K1777; COPY DD SA
       LDX 9PCTB; LDA I II,X
       AND K1777; SKP IF DA UEQ SD; STZ I II,X

%            T:=VCTBL[I]$INDX;

CK1,   LDX 9VCTB; LDA I II2,X; AND K1777; SHA 1; STA T

%            PDTBL[T]$COUNT:=PDTBL[T]$COUNT-1;
%            PDTBL[T]:=0 IF PDTBL[T]$COUNT=0;

       LDX 9PDTB; LDA I T,X; AAA -1; COPY DD SA
       AND K77; JAZ CK2; COPY DA SD; JMP CK2+1
CK2,   SAA 0; STA I T,X

%            VCTBL[I]:=0; FRETURN;

CK3,   LDX 9VCTB; RCLR DA; RCLR DD; STD I II2,X; EXIT

%            ENDIF;

%            RETURN;

CKS,   EXIT AD1

II,    0
II2,   0
T,     0
9VCTB, VCTBL
9PCTB, PCTBL
9PDTB, PDTBL
K1777, 1777
K77,   77

       )FILL
       )PCL CKDEL
&L
