NTTY=4
"
NTTY


NTY
"NTY
NTY=4
"

GOOM/
)KILL GOOM

%FTLER
%FATAL ERROR

FTLER, JMP *
TRERR, JMP *
%BSS
)MCDEF BSS $A1
*+$A1 /
       ]

%STSET
%SETUP A STRING (MACRO)
%ARG1: NAME OF STRING
%ARG2: NAME OF STRING DESCRIPTOR
%ARG3: NAME OF STRING LOCATION
%ARG4: SIZE OF STRING

)MCDEF STSET $A1,$A2,$A3,$A4
       SAX $A2 ; RADD DX SB; STX $A1 ,B; SAT $A3 ;
       RADD DT SB; SAA $A4 ; SAD SHR 20; JPL I (SETUP
       ]
)MCDEF PATCH
       ]
15/
DKBAS, 0


16/

KLOK,  0; 0  %GLOBAL CLOCK
&L
"NN10
%SAVE - UNSAVE
%

20/    61; RBLOK; UBLOK; MBLOK; 125; 136; 147; 160
       171; 202; 213; 224; 235; 246; 257; 270

40/

SAVE,  STF 0,X; TRA STS; COPY DT SL; COPY DD SB
       STF 3,X; TRA MPR; STA 6,X; WAIT
UNSAV, LDA 10,X; TRR MPR; LDF 5,X; COPY DL ST
       COPY DB SD; TRR STS; LDF 2,X; LDX 1,X
       JMP I *

"

% SYSTEM POINTERS

72/    BUFTB; CINF
74/
CAERR, JMP *                 % CORE ADDRESS ERROR (BUSS CABLE)


301/
%INIT
%INTERRUPT INITIALIZATION

"NN10
INIT,  IOF
       IOT 6
       LDA (LEV0; STA I (61
       LDA (LEV2; STA I (UBLOK
       LDA (LEV3; STA I (MBLOK
       LDA (LEV5; STA I (136
       LDA (LEV6; STA I (147
       LDA (LEV7; STA I (160
       LDA (LEV9; STA I (202
       LDA (LEV11; STA I (224
       LDA (LEV13; STA I (246
       LDA (LEV14; STA I (257
       SAA -1; STA I (61+10; STA I (UMPR; STA I (MRG
       STA I (136+10; STA I (147+10; STA I (160+10
       STA I (202+10
       STA I (224+10; STA I (246+10; STA I (257+10
"
       LDX (-NBUF; SAT NBUF; RADD DT SX
       JPL I (IBUF; JPL I (ILINK; JNC *-4
       STZ I (LRDR; STZ I (LPNCH; STZ I (LCRD; STZ I (LPNT; STZ I (LMOD
       STZ I (LACM; LDX (TIME0; STZ 0,X; STZ 1,X
       LDA (CTBB; STA I (PTR
       JPL I (FINIT
       LDX (TTYTB; SAT 0; SAA NTTY+1; JPL I 9SETB
       LDX (L7TBL; JPL I 9SETB; LDX (YSTOP; JPL I 9SETB
       LDX (TIMTB; JPL I 9SETB
       LDX (RSTBL; SAT -1; JPL I 9SETB
       RCLR DA; RCLR DD; STD I (RSTIM; STA I (RSNUM
       LDX (PRT1; STX I (PRT; STZ 0,X; STZ AVAIL
       STZ I (KLOK; STZ I (KLOK+1; STZ I (DABLE
       STZ I (MAILK; STZ I (TTYLK; STZ I (ACCLK

       SAA 0; STA 5,X; LDX (PRT2; LDT (PRTXX
       SAA -1; STA 5,X; AAX 10
       SKP IF DT LST SX; JMP *-4
"NN10
       ION GRP1 GRP2 GRP3
"NN10
       SAA -1; MCL PID; MCL PIE; WAIT
"-OLA NN10
       IOT PIN 6
"NN10
       SAA -1; TRR MPR
       LDA ENABL; MST PIE
       SAA 40; MST PID
       JMP I *
"
9SETB, SETB
       )FILL
       )PCL INIT

"NN10
ENABL, 65357                 %INTERRUPT ENABLE MASK
SVEEN, 3717
"
AVAIL, 0     %AVAILABILITY OF THE SYSTEM






%WBUF
%WRITE CHARACTER INTO BUFFER
%A = CHARACTER
%T = DEVICE NUMBER
%RETURN
%FAILURE RETURN 1 IF BUFFER BECOMES FULL
%FAILURE RETURN 2 IF BUFFER IS FULL

WBUF,  AND 9377; COPY DD SA; STA WBUFA; COPY DA SB
       LDX 9BUFT; RADD DX ST; STF WBUFT
       LDT 0,X; COPY DB ST
       LDA 5,B; LDT 0,B; SKP IF DA LST ST; JMP WF; MIN 5,B
       SAA NTTY; LDT WBUFT; SKP IF DA GRE ST; JMP *+3
       MIN 35,B; 0; LDA 4,B; AAA 1; LDT 2,B
       SKP IF DT LST SA; JMP *+3; LDA 1,B; AAA 1
       STA 4,B; BSKP ONE 0 DA; JMP W1
       SHA ZIN SHR 1; COPY DX SA
       LDA 0,X; AND (177400; RADD DA SD; JMP W2
W1,    SHA ZIN SHR 1; COPY DX SA
       LDA 0,X; AND 9377; SWAP DA SD
       SHA 10; RADD DA SD
W2,    STA 0,X

W3,    LDA 5,B; SUB 0,B
       JAZ WFX; RINC DL
WF,    LDA WBUFB; COPY DB SA; LDA WBUFA; EXIT AD1
WFX,   RDCR DL; JMP WF
WBUFT, 0
WBUFB, 0
WBUFA, 0
       )FILL
       )PCL WBUF


%RBUF
%READ CHARACTER FROM BUFFER
%T = DEVICE NUMBER
%RETURN A
%FAILURE RETURN IF BUFFER EMPTY

RBUF,  STX RBUFX; COPY DX SB; STX RBUFB
       LDX 9BUFT; RADD DX ST; LDT 0,X; COPY DB ST
       LDA 5,B; JAZ RF; AAA -1; STA 5,B
       LDA 3,B; AAA 1; LDT 2,B
       SKP DT LST SA; JMP *3; LDA 1,B; AAA 1; STA 3,B
       BSKP ONE DA; JMP R1; SHA ZIN SHR 1; COPY DX SA
       LDA ,X; AND 9377; JMP R2
R1,    SHA ZIN SHR 1; COPY DX SA; LDA ,X; SHA ZIN SHR 10
R2,    RINC DL
RF,    LDX RBUFB; COPY DB SX; LDX RBUFX; EXIT
RBUFB, 0
RBUFX, 0
       )FILL
       )PCL RBUF


9377,  377
9BUFT, BUFTB


%REBUF
%READ CHARACTER FROM ECHO BUFFER
%T = DEVICE NUMBER
%RETURN A
%FAILURE RETURN IF BUFFER IS EMPTY

REBUF, STX RBUFX; COPY DX SB; STX RBUFB
       LDX 9BUFT; RADD DX ST; LDT 0,X; COPY DB ST
       LDA 35,B; JAZ RF; AAA -1; STA 35,B
       LDA 33,B; AAA 1; LDT 2,B
       SKP DT LST SA; JMP *3; LDA 1,B; AAA 1; STA 33,B
       BSKP ONE DA; JMP R1; SHA ZIN SHR 1; COPY DX SA
       LDA ,X; AND 9377; JMP R2
R1,    SHA ZIN SHR 1; COPY DX SA; LDA ,X; SHA ZIN SHR 10
R2,    RINC DL
RF,    LDX RBUFB; COPY DB SX; LDX RBUFX; EXIT
RBUFB, 0
RBUFX, 0
       )FILL
       )PCL REBUF
       )KILL 9BUFT 9377




%IBUF
%INITIALIZE I/O BUFFER
%T = DEVICE NUMBER
%RETURN

IBUF,  STX IBUFX
"NN10
       LDX (DEVTB; RADD DX ST; LDA 0,X; ORA (IOT ACT
       STA *+2; SAA 0; 0
"
IB1,   LDX 9BUFT; RADD DX ST; LDX 0,X
       LDA -1,X; SHA 1; AAA -1; STA 1,X
       LDA -2,X; SHA 1; STA 0,X; ADD 1,X; STA 2,X
       LDA 1,X; STA 3,X; STA 4,X; STZ 5,X; STZ 6,X
       SAA NTTY; SKP IF DA GRE ST; JMP IBUF1
       SAA -1; STA 34,X
IBUF1, LDX IBUFX; EXIT
IBUFX, 0
       )FILL
       )PCL IBUF


%ILINK
%INITIALIZE LINK WORD
%T = DEVICE NUMBER
%RETURN

ILINK, STX IBUFX
       LDX 9BUFT; RADD DX ST; LDX 0,X
       SAA NTTY; SKP IF DA LST ST; STZ 31,X
       LDX IBUFX; EXIT
IBUFX, 0
       )FILL
       )PCL ILINK


%SBUF
%READ NUMBER OF CHARACTERS IN BUFFER
%T = DEVICE NUMBER
%RETURN

SBUF,  LDX 9BUFT; RADD DX ST; LDX 0,X
       LDA 5,X; COPY DD SA
       EXIT
       )FILL


%BUSY
%CHECK IF BUSY
%T = DEVICE NUMBER
%RETURN

BUSY,  LDX 9BUFT; RADD DX ST; LDX 0,X
       LDA 6,X; EXIT
       )FILL


%BUSST
%SET BUSY FLAG
%T = DEVICE NUMBER
%RETURN

BUSST, LDX 9BUFT; RADD DX ST; LDX 0,X
       SAA -1; STA 6,X; EXIT
       )FILL


%BUSZR
%RESET BUSY FLAG
%T = DEVICE NUMBER
%RETURN

BUSZR, LDX 9BUFT; RADD DX ST; LDX 0,X
       STZ 6,X; EXIT
       )FILL


%ECFST
%RETURN ECHO FLAG VALUE
%T = DEVICE NUMBER

ECFST, LDX 9BUFT; RADD DX ST; LDX 0,X
       LDA 34,X; EXIT
       )FILL

9BUFT, BUFTB

%SECFS
%SET ECHO FLAG
%T = DEVICE NUMBER
%A = VALUE

SECFS, LDX 9BUFT; RADD DX ST; LDX 0,X
       STA 34,X; EXIT
       )FILL


%SEPTR
%SET ECHO BUFFER POINTER
%T = DEVICE NUMBER

SEPTR, LDX 9BUFT; RADD DX ST; LDX 0,X
       LDA 4,X; STA 33,X; STZ 35,X; EXIT
       )FILL


%XEPTR
%IS ECHO BUFFER PTR = READER PTR?
%RETURN -1 IF EQUAL ELSE 0

XEPTR, LDX 9BUFT; RADD DX ST; LDX 0,X
       LDA 3,X; SUB 33,X; JAF *+3; SAA -1; JMP *+2
       SAA 0; EXIT
       )FILL


%BRKST
%RETURN BREAK STRATEGY
%T = DEVICE NUMBER

BRKST, LDX 9BUFT; RADD DX ST; LDX 0,X
       LDA 7,X; EXIT
       )FILL

%ECHST
%RETURN ECHO STATUS
%T = DEVICE NUMBER

ECHST, LDX 9BUFT; RADD DX ST; LDX 0,X
       LDA 10,X; EXIT
       )FILL

%SBRKS
%SET BREAK STRATEGY
%T = DEVICE NUMBER
%A = BREAK STRATEGY

SBRKS, LDX 9BUFT; RADD DX ST; LDX 0,X
       STA 7,X; STZ 32,X; EXIT
       )FILL

%SECHS
%SET ECHO STRATEGY
%T = DEVICE NUMBER
%A = ECHO STRATEGY

SECHS, LDX 9BUFT; RADD DX ST; LDX 0,X
       STA 10,X; EXIT
       )FILL

       )KILL 9BUFT

