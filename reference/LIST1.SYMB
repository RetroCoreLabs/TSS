% NORD TIMESHARING SYSTEM  BY BO LEWENDAL
%
% LIBRARY MARKS AND DEFINABLE SYMBOLS IN TSS
%
%                DEFAULT FOR
% NAME       NCR             CDC       DESCRIPTION
%
% NCR        TRUE            FALSE     NCR DISK SYSTEM
% CDC        FALSE           TRUE      CDC DISK SYSTEM
% DRUM       FALSE           FALSE     SWAPPING DRUM
% DEBUG      FALSE           FALSE     VER. A IF FALSE ELSE VER. B
% N10        FALSE           FALSE     NORD-10 VERSION
% 9TTI       50              50        TTY INPUT BUFFER SIZE
% 9TTO       20              20        TTY OUTPUT BUFFER SIZE
% 9PPT       30              30        PAPER TAPE  BUFFER SIZE
% 9FP        600             600       FAST PUNCH BUFFER SIZE
% 9MI        5               5         MODEM INPUT BUFFER SIZE
% 9MO        5               5         MODEM OUTPUT BUFFER SIZE
% 9SP        5               5         SLOW PUNCH BUFFER SIZE
% 8LP        100             100       LINE PRINTER BUFFER SIZE
% 9CR        52              52        CARD READER BUFFER SIZE
% TT1        2               2         TTY1  DEVICE NUMBER
% TT2        4               104       TTY2  DEVICE NUMBER
% TT3        72              120       TTY3  DEVICE NUMBER
% TT4        12              122       TTY4  DEVICE NUMBER
% TT5        152             124       TTY5  DEVICE NUMBER
% TT6        104             126       TTY6  DEVICE NUMBER
% TT7        120             136       TTY7  DEVICE NUMBER
% TT8        0               140       TTY8  DEVICE NUMBER
% TT9        0               146       TTY9  DEVICE NUMBER
% TT10       0               150       TTY10 DEVICE NUMBER
% TT11       0               154       TTY11 DEVICE NUMBER
% TT12       0               156       TTY12 DEVICE NUMBER
% DLP        67              167       LINE PRINTER DEVICE NUMBER
% DCR        42              42        CARD READER DEVICE NUMBER
% DFP        7               7         FAST PUNCH DEVICE NUMBER
% DSP        17              17        SLOW PUNCH DEVICE NUMBER
% MT         134             134       MAG.TAPE DEVICE NUMBER
% DMSI       170             170       MODEM READ STATUS
% SADR       160             160       SET ADDRESS (ACM)
% PLOT       153             153       PLOTTER
% DKS        0               0         START OF DISK
% DCHN       0               100       DISK CHANNEL NUMBER
% ND25       FALSE           FALSE     HALF DUPLEX TELETYPES
% NOPEN      5               5         NUMBER OF OPEN FILES
% DRMSZ      2000            2000      SIZE OF DRUM IN 256 WORD PAGES
% TSBIN      FALSE           FALSE     PRODUCE BINARY TAPE
% K4         FALSE           FALSE     4K MEMORY PROTECT BLOCKS
% MACF       FALSE           FALSE     ASSEMBLY WITH MACF
% 8MDM       FALSE           FALSE     MODEM
% 8ACM       FALSE           FALSE     ACM
% HORT       FALSE           FALSE     ENABLES ONLY GROUP 1
% K12        FALSE           FALSE     12K SYSTEM
% K14        FALSE           FALSE     14K SYSTEM
% K16        TRUE            TRUE      16K SYSTEM
% OLA        FALSE           FALSE     SPECIAL RTC
% HP         FALSE           FALSE     HP MAG.TAPE (ELSE KENNEDY)
% NTY        4               4         NUMBER OF NON-MODEM TERMINALS


&L
0/     JMP I *+3
1/     JMP I *+3
2/     JMP I *+3
3/     GOVX; USTK; STK
6/     MCTBL                 %POINTER TO MONITOR CALL TABLE

%SAVE SYSTEM ON THE DISK

7/     LDT *+3; JMP I *+1; SYSSV; CORLD


)KILL EDIT

GOOM=*
NCR
