%FAILURE RETURN A,T
%A = 12 IF NO ACCESS
%A = 14 IF BAD FILE NUMBER
%A = 15 IF NO SUCH TRACK
%A = 16 IF BAD TRACK NUMBER
%T = LAST TRACK DELETED BY THIS CALL OR -1 IF NONE

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV14,D1,FDLTR
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV14; D1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FDLTR=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA TCNT,1
TCNT=ZYX
   )KILL ZYX
ZYX=TCNT+1;
   
       DATA UNUM,1
UNUM=ZYX
   )KILL ZYX
ZYX=UNUM+1;
   
       DATA LTRK,1
LTRK=ZYX
   )KILL ZYX
ZYX=LTRK+1;
   
       DATA OBJ,1
OBJ=ZYX
   )KILL ZYX
ZYX=OBJ+1;
   
       DATA OFTN,1
OFTN=ZYX
   )KILL ZYX
ZYX=OFTN+1;
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA TNUM,1
TNUM=ZYX
   )KILL ZYX
ZYX=TNUM+1;
   
       DATA TRKAD,1
TRKAD=ZYX
   )KILL ZYX
ZYX=TRKAD+1;
   
D1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; SAA -1; STA LTRK,B
       SAA 1; STA UNUM,B; STZ TCNT,B
       AAT -10; SKP IF DT GRE 0; JMP I (DF14
       SAA NOFT; SKP IF DT LST SA; JMP I (DF14; STT OFTN,B
       LDX (OFT; LDA I OFTN,B,X; JAN *+2; JMP I (DF14
       BSKP ZRO 160 DA; JMP I (DF12; JPL I (OFTX; STA OBJ,B
       SAX 33; LDA I OBJ,B,X; JAP *+2; JMP I (DSS
       SAX 32; LDA I OBJ,B,X; SHA ZIN SHR 10; STA UNUM,B
       LDT (3777; LDA AREG,B; LDX XREG,B; RAND DA ST
       RAND DX ST; JXZ DF16; AAA -1; SKP IF DT GRE SA; JMP DF16
       ENINT; DSINT; LDA I OBJ,B; JAN *-3
       BSET ONE 170 DA; STA I OBJ,B; ENINT; STZ CNT,B; JMP D2
       )FILL
D2,    LDA AREG,B; AND (3777; ADD CNT,B; STA TNUM,B
       AND (3740; SAX 37; LDT I OBJ,B,X
       SKP IF DA UEQ ST; JMP D3
       SAD SHR 10; SAX 21; ADD I OBJ,B,X; COPY DT SA
       SAX 20; LDA I OBJ,B,X; JPL I (RBLOC; JMP *-1
       SAA 0; SAD 10; ADD (BTEMP; COPY DX SA
       LDT OBJ,B; AAT 40; SAA 40; JPL I (BCOPY
       STZ I (BTEMP-4; LDA TNUM,B; AND (3740
       SAX 37; STA I OBJ,B,X
D3,    LDA TNUM,B; AND (37; ADD OBJ,B; AAA 40; STA TRKAD,B
       LDA I TRKAD,B; JAZ DF15; SAX 20; LDT I OBJ,B,X
       SWAP DA ST; JPL I (RTRK; JMP *+1; STZ I TRKAD,B; MIN TCNT,B
       LDA TNUM,B; SAD SHR 10; SAX 21; ADD I OBJ,B,X
       COPY DT SA; SAX 20; LDA I OBJ,B,X; JPL I (RBLOC; JMP *-1
       SAA 0; SAD 10; AND (340; ADD (BTEMP; COPY DT SA
       LDX OBJ,B; AAX 40; SAA 40; JPL I (BCOPY
       LDA TNUM,B; STA LTRK,B; JPL I (WBLOK
       MIN CNT,B; LDA XREG,B; AND (3777
       COPY CM2 DA SA; ADD CNT,B; JAN D2
       LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
DSS,   MIN LREG,B; JMP DFF3
DF12,  SAT 14; JMP DFF2
DF14,  SAT 16; JMP DFF2
DF15,  SAT 17; JMP DFF1
DF16,  SAT 20; JMP DFF1
DFF1,  LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
DFF2,  STT AREG,B; LDA LTRK,B; STA TREG,B
DFF3,  LDA TCNT,B; COPY CM2 DA SA; LDT UNUM,B; JPL I (UTRK; JMP *+1
       JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FDLTR


%RFLEN
%READ FILE LENGTH
%T = FILE NUMBER
%RETURN AD
%AD = FILE LENGTH
%FAILURE RETURN A
%A = 14 IF BAD FILE NUMBER

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV14,R1,FRFLE
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV14; R1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FRFLE=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA OFTN,1
OFTN=ZYX
   )KILL ZYX
ZYX=OFTN+1;
   
       DATA OBJ,1
OBJ=ZYX
   )KILL ZYX
ZYX=OBJ+1;
   
R1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; AAT -10; SKP IF DT GRE 0; JMP RF14
       SAA NOFT; SKP IF DT LST SA; JMP RF14; STT OFTN,B
       LDX (OFT; LDA I OFTN,B,X; JPL I (OFTX; STA OBJ,B
       ENINT; DSINT; LDA I OBJ,B; JAN *-3
       BSET ONE 170 DA; STA I OBJ,B; ENINT
       SAX 22; LDD I OBJ,B,X; STD AREG,B
       LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
       MIN LREG,B; JMP RFF
RF14,  SAA 16; STA AREG,B
RFF,   JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FRFLE

%SFLEN
%SET FILE LENGTH
%T = FILE NUMBER
%AD = LENGTH
%RETURN
%FAILURE RETURN A
%A = 12 IF NO ACCESS
%A = 14 IF BAD FILE NUMBER

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV14,S1,FSFLE
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV14; S1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FSFLE=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA OFTN,1
OFTN=ZYX
   )KILL ZYX
ZYX=OFTN+1;
   
       DATA OBJ,1
OBJ=ZYX
   )KILL ZYX
ZYX=OBJ+1;
   
S1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       AAT -10; SKP IF DT GRE 0; JMP SF14
       SAA NOFT; SKP IF DT LST SA; JMP SF14; STT OFTN,B
       LDX (OFT; LDA I OFTN,B,X; JAP SF14; BSKP ZRO 160 DA; JMP SF12
       JPL I (OFTX; STA OBJ,B
       ENINT; DSINT; LDA I OBJ,B; JAN *-3
       BSET ONE 170 DA; STA I OBJ,B; ENINT
       LDD AREG,B; SAX 22; STD I OBJ,B,X
       LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
       MIN LREG,B; JMP SFF+1
SF12,  SAA 14; JMP SFF
SF14,  SAA 16
SFF,   STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FSFLE

%RDOFT
%READ OFT ENTRY (SIMILAR TO READ ENTRY)
%T = FILE NUMBER
%A = NUMBER OF WORDS
%X = POINTER TO ARRAY
%RETURN
%FAILURE RETURN A
%A = 14 IF BAD FILE NUMBER

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV14,R1,FRDOF
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV14; R1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FRDOF=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA OFTN,1
OFTN=ZYX
   )KILL ZYX
ZYX=OFTN+1;
   
       DATA OBJ,1
OBJ=ZYX
   )KILL ZYX
ZYX=OBJ+1;
   
R1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       AAT -10; SKP IF DT GRE 0; JMP RF14
       SAA NOFT; SKP IF DT LST SA; JMP RF14; STT OFTN,B
       LDX (OFT; LDA I OFTN,B,X; JAP RF14; JPL I (OFTX; STA OBJ,B
       ENINT; DSINT; LDA I OBJ,B; JAN *-3
       BSET ONE 170 DA; STA I OBJ,B; ENINT
       LDA AREG,B; JAP *+2; SAA 40; SAT 40
       SKP IF DT GRE SA; SAA 40
       LDX OBJ,B; LDT XREG,B; JPL I (BCOPY
       LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
       MIN LREG,B; JMP RFF
RF14,  SAA 16; STA AREG,B
RFF,   JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FRDOF


%DLFIL
%DELETE FILE
%A = DEVICE ID
%X = POINTER TO FILE ID (AS IN SFILA)
%RETURN
%FAILURE RETURN A
%A = 4 IF NO SUCH USER
%A = 8 IF NO SUCH FILE
%A = 12 IF NO ACCESS

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV14,D1,FDLFI
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV14; D1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FDLFI=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA TCNT,1
TCNT=ZYX
   )KILL ZYX
ZYX=TCNT+1;
   
       DATA UNUM,1
UNUM=ZYX
   )KILL ZYX
ZYX=UNUM+1;
   
       DATA DKAD,1
DKAD=ZYX
   )KILL ZYX
ZYX=DKAD+1;
   
       DATA DISP,1
DISP=ZYX
   )KILL ZYX
ZYX=DISP+1;
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA CNTX,1
CNTX=ZYX
   )KILL ZYX
ZYX=CNTX+1;
   
       DATA INDXK,1
INDXK=ZYX
   )KILL ZYX
ZYX=INDXK+1;
   
D1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; STZ TCNT,B; LDA I XREG,B; STA UNUM,B
       LDA AREG,B; JPL I (KDEV; JPL I (DVERR
       LDA AREG,B; LDX XREG,B; JPL I (CKOBT; JMP DF27; JPL I (SUIB
       JMP *+2; JMP D2; AAA 1; JAZ DF4; JMP DF8
D2,    STA DISP,B; STT DKAD,B; LDA AREG,B; JPL I (RBLOC; JMP *-1
       LDA AREG,B; COPY DD SA; LDT I XREG,B; LDA (BTEMP
       ADD DISP,B; COPY DX SA; LDA 17,X; AND (777
       SAX 4; JPL I (CKACC; JMP DF12
       SAA 21; ADD DISP,B; ADD (BTEMP; COPY DX SA; LDA 0,X
       STA INDXK,B; LDA (BTEMP; ADD DISP,B; COPY DX SA
       SAT 0; SAA 40; JPL I (SETB; JPL I (WBLOK; STZ CNT,B
D3,    LDA INDXK,B; ADD CNT,B; COPY DT SA
       LDA AREG,B; JPL I (RBLOC; JMP *-1; STZ CNTX,B
D4,    LDX (BTEMP; LDT I CNTX,B,X; SKP IF DT UEQ 0; JMP D5
       LDA AREG,B; JPL I (RTRK; JMP *+1; MIN TCNT,B
D5,    MIN CNTX,B; LDA CNTX,B; SUB (400; JAN D4
       JPL I (WBLOK; MIN CNT,B; LDA CNT,B; AAA -10; JAN D3
       LDT INDXK,B; LDA AREG,B; JPL I (RTRK; JMP *+1; MIN TCNT,B
       MIN LREG,B; JMP DFF+1
DF4,   SAA 4; JMP DFF
DF8,   SAA 10; JMP DFF
DF12,  SAA 14; STZ I (BTEMP-4; JMP DFF
DF27,  SAA 33; JMP DFF
DFF,   STA AREG,B; LDA TCNT,B; COPY CM2 DA SA; LDT UNUM,B
       JPL I (UTRK; JMP *+1; JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FDLFI


%SYSUP
%MAKE SYSTEM AVAILABLE TO NEW USERS
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV14,S1,SYSUP
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV14; S1; SAVX
)KILL BLUES
BLUES=*
GLOB/
SYSUP=BLOB
)KILL BLOB
)KILL GLOB
   

S1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (WHUSR; AAA -1; JAF SFF
       STZ I (AVAIL
SSS,   MIN LREG,B; RET

   RCLR DP AD1
   SFF,   SAA 56; JPL I (ERMSG; JMP SSS
       )FILL
       )PCL SYSUP



%SYSDW
%MAKE SYSTEM UNAVAILABLE TO NEW USERS
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV14,S1,SYSDW
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV14; S1; SAVX
)KILL BLUES
BLUES=*
GLOB/
SYSDW=BLOB
)KILL BLOB
)KILL GLOB
   

S1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (WHUSR; AAA -1; JAF SFF
       SAA -1; STA I (AVAIL
SSS,   MIN LREG,B; RET

   RCLR DP AD1
   SFF,   SAA 56; JPL I (ERMSG; JMP SSS
       )FILL
       )PCL SYSDW


       OVERX QOV14
QOV14=*-ROVER
)9MOVE ROVER VOR VORS
GLOB=VOR
)KILL VOR
VOR=GLOB+VORS
)KILL GLOB
OVLAY/ RQR-1
OVLAX/ RQR-1
SYSOV/ RQR-1
)WRTM
)WRITE QOV14
 
:000713    


       OVERL OV15A
OV15A=RQR
   )KILL RQR
RQR=OV15A+1
ROVER/
   

%ERMS2
%PRINT AN ERROR MESSAGE
%A = MESSAGE NUMBER
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV15A,E1,ERMS2
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV15A; E1; SAVX
)KILL BLUES
BLUES=*
GLOB/
ERMS2=BLOB
)KILL BLOB
)KILL GLOB
   

E1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JAN ESS; JAZ ESS
       SUB (NMSG; JAZ *+2; JAP ESS
       LDA AREG,B; ADD (ERTBL; COPY DX SA
       LDX 0,X; JPL I (MSG
ESS,   RET

   RCLR DP AD1
          )FILL


ERTBL, NMSG; MS33; MS34; MS35; MS36; MS37; MS38; MS39
       MS40; MS41; MS42; MS43; MS44; MS45; MS46; MS47
       MS48; MS49; MS50
NMSG=*-ERTBL-1

MS33,  '$DEVICE ERROR AT \ '
MS34,  '$STACK OVERFLOW\ '
MS35,  '$STACK UNDERFLOW\ '
MS36,  'ILLEGAL ADDRESS$\ '
MS37,  '$DISK ERROR \ '
MS38,  '$$YOUR TWO MINUTES ARE UP$\ '
MS39,  '$USER BREAK AT P = \ '
MS40,  '$ILLEGAL INSTRUCTION AT P = \ '
MS41,  '$BATCH JOB ABORTED\ '
MS42,  '$NORD TSS VERSION 3.0A IS UP$\ '
MS43,  'AMBIGUOUS$\ '
MS44,  '$PARITY ERROR$\ '
MS45,  'I/O ERROR$\ '
MS46,  'YOU MAY NOT DO THIS$\ '
MS47,  'BAD FILENAME$\ '
MS48,  ' TRACKS LEFT$\ '
MS49,  '$NORD TSS VERSION 3.0B IS UP$\ '
MS50,  '$SYSTEM IS UNAVAILABLE\ '
       )PCL ERMS2


%RBLOAD
%LOAD RB RPOGRAM
%RBLOAD FILENAME,STARTADDRESS
%RETURN
%A=START ADDRESS
       PROGM

   )KILL ZYX
ZYX=1
          GOVER OV15A,STAR,RBLOAD
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV15A; STAR; SAVX
)KILL BLUES
BLUES=*
GLOB/
RBLOAD=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA  XTR,5
 XTR=ZYX
   )KILL ZYX
ZYX= XTR+5;
   
       DATA  PTR,1
 PTR=ZYX
   )KILL ZYX
ZYX= PTR+1;
   
       DATA  STRX,20
 STRX=ZYX
   )KILL ZYX
ZYX= STRX+20;
   
       DATA  FNUM,1
 FNUM=ZYX
   )KILL ZYX
ZYX= FNUM+1;
   
       DATA  CLOC,1
 CLOC=ZYX
   )KILL ZYX
ZYX= CLOC+1;
   
       DATA  PRGB,1
 PRGB=ZYX
   )KILL ZYX
ZYX= PRGB+1;
   
       DATA  SOFF,3
 SOFF=ZYX
   )KILL ZYX
ZYX= SOFF+3;
   
       DATA  CORS,1
 CORS=ZYX
   )KILL ZYX
ZYX= CORS+1;
   
MS1,   'PROGRAM OUT OF BOUNDS$\ '
MS2,   'CHECKSUM ERROR$\ '
MS3,   'ILLEGAL CONTROL BYTE$\ '

STAR,  ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; STSET PTR,XTR,STRX,40
       SAX XTR; RADD DX SB; STX PTR,B; SAT STRX;
       RADD DT SB; SAA 40; SAD SHR 20; JPL I (SETUP
       
ST1,   LDT I (CMDLN; LDX PTR,B; SAA 1; JPL I (PCF; JMP I (VEKK
       LDT I (CMDLN; SAA 3; JPL I (PCF; JMP I (VEKK; STA PRGB,B
       AAA -1; STA CLOC,B; LDX PTR,B; LDA (MTP7; SAT 1
       JPL I (OPEN; JMP I (PF3; STA FNUM,B; LDA PRGB,B; LDT (MSTRT
       SKP DA GRE ST; JMP I (PF1; LDA (2000; LDX PRGB,B; RADD SX DA
       COPY SA DT; STT CORS,B; JPL I (CKMEM; JMP I (PF1; LDT FNUM,B
       JPL I (INBT; JMP I (CF; AAA -17; JAF *-4; SAA 17; COPY SA DD
LESN,  LDT FNUM,B; JPL I (INBT; JMP I (CF; RADD SA DD; AAA -1
       JAZ LF; AAA -1; JAZ LR; AAA -4; JAZ AFR; AAA -1; JAZ ARR
       AAA -15; JAZ LNF; AAA 12; JAZ SRL; AAA 2; JAZ SFL; AAA -11
       JAZ END
ERR1,  LDX (MS3; JPL I (MSG; JMP CF
LF,    SAT 1; JMP LNF 2
LR,    LDT CORS,B; SKP DT LST SX; JMP VIDR; LDA (2000; RADD SA DT
       STT CORS,B; JPL I (CKMEM; JMP PF1
VIDR,  JPL LES; ADD CLOC,B; STA ,X; AAX 1; JMP LESN
AFR,   JPL LES; JMP ARR 2
       )FILL
ARR,   JPL LES; ADD CLOC,B; COPY SA DT; JPL LES; ADD CLOC,B
       STX SOFF,B; COPY SA DX; LDA ,X; RADD ST DA; STA ,X
       LDX SOFF,B; JMP LESN
LNF,   JPL LES; COPY SA DT; JPL LES; STT SOFF,B; LDT CORS,B
       SKP DT LST SX; JMP VODR; STA SOFF 1,B; LDA (2000
       RADD SA DT; STT CORS,B; JPL I (CKMEM; JMP PF1; LDA SOFF 1,B
VODR,  LDT SOFF,B; STA ,X; AAX 1; AAT -1; SKP DT EQL 0; JMP LNF 2
       JMP LESN
SRL,   JPL LES; ADD CLOC,B; COPY SA DX; JMP LESN
SFL,   JPL LES; JMP SRL 2
LES,   COPY SL DA; STF SOFF,B; LDT FNUM,B; JPL I (INBT
       JMP CF; SHA ROT SHR 10; COPY SA DD; LDT FNUM,B
       JPL I (INBT; JMP CF; RADD SD DA; LDT SOFF 2,B; COPY ST DD
       RADD SA DD; LDT SOFF,B; JMP I SOFF 1,B
END,   JPL LES; SKP DD EQL 0; JMP ERR5; LDA PRGB,B; STA AREG,B
PS,    LDT FNUM,B; JPL I (CFILE; JMP *+1
VEKK,  MIN LREG,B; RET

   RCLR DP AD1
   PF3,   JPL I (ERMSG; JMP VEKK
PF1,   LDX (MS1; JPL I (MSG
CF,    SAA -1; ADD LREG,B; STA LREG,B; JMP PS
ERR5,  LDX (MS2; JPL I (MSG; JMP CF
       )FILL
       )PCL RBLOAD
       OVERX QO15A
QO15A=*-ROVER
)9MOVE ROVER VOR VORS
GLOB=VOR
)KILL VOR
VOR=GLOB+VORS
)KILL GLOB
OVLAY/ RQR-1
OVLAX/ RQR-1
SYSOV/ RQR-1
)WRTM
)WRITE QO15A
 
:000712    


       OVERL OV15
OV15=RQR
   )KILL RQR
RQR=OV15+1
ROVER/
   


%ERMSG
%PRINT AN ERROR MESSAGE
%A = MESSAGE NUMBER
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV15,E1,FERMS
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV15; E1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FERMS=BLOB
)KILL BLOB
)KILL GLOB
   

E1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; AAA -40; JAZ *+2; JAP E2
       AAA 40; JPL I (ERMS1; JMP ESS
E2,    JPL I (ERMS2
ESS,   RET

   RCLR DP AD1
          )FILL
       )PCL FERMS


%ERMS1
%PRINT AN ERROR MESSAGE ON THE TELETYPE
%A = MESSAGE NUMBER INDEXED FROM ONE
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV15,E1,ERMS1
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV15; E1; SAVX
)KILL BLUES
BLUES=*
GLOB/
ERMS1=BLOB
)KILL BLOB
)KILL GLOB
   

E1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JAN ESS; JAZ ESS
       SUB (NMSG; JAZ *+2; JAP ESS
       LDA AREG,B; ADD (ERTBL; COPY DX SA
       LDX 0,X; JPL I (MSG
ESS,   RET

   RCLR DP AD1
          )FILL


%ERROR MESSAGES

ERTBL, NMSG; MS1; MS2; MS3; MS4; MS5; MS6; MS7
       MS8; MS9; MS10; MS11; MS12; MS13; MS14
       MS15; MS16; MS17; MS18; MS19; MS20
       MS21; MS22; MS23; MS24; MS25; MS26
       MS27; MS28; MS29; MS30; MS31; MS32
NMSG=*-ERTBL-1

MS1,   'NO MORE TRACKS AVAILABLE$\ '
MS2,   'TOO MANY USERS$\ '
MS3,   'USER ALREADY EXISTS$\ '
MS4,   'NO SUCH USER$\ '
MS5,   'USER INDEX BLOCK FULL$\ '
MS6,   'FILE ALREADY EXISTS$\ '
MS7,   'ILLEGAL OBJECT TYPE$\ '
MS8,   'NO SUCH FILE$\ '
MS9,   'OBJECT INDEX OUT OF RANGE$\ '
MS10,  'OBJECT TABLE FILLED$\ '
MS11,  'OPEN FILE TABLE FILLED$\ '
MS12,  'INSUFFICIENT ACCESS$\ '
MS13,  'ALREADY OPEN FOR WRITE$\ '
MS14,  'BAD FILE NUMBER$\ '
MS15,  'NO SUCH TRACK$\ '
MS16,  'BAD TRACK NUMBER$\ '
MS17,  'TRACK ALREADY EXISTS$\ '
MS18,  'NO SUCH PAGE$\ '
MS19,  'FATAL ERROR$\ '
MS20,  'TRANSFER ERROR$\ '
MS21,  'BAD DEVICE TYPE$\ '
MS22,  'DISK AREA ALREADY IN USE$\ '
MS23,  'WRITE NOT PERMITTED$\ '
MS24,  'NOT A SEQUENTIAL FILE$\ '
MS25,  'BAD CORE ADDRESS$\ '
MS26,  'BAD DISK ADDRESS$\ '
MS27,  'FILE MUST BE CLOSED BY EVERYONE$\ '
MS28,  'SPECIFIED USER IS ALREADY A FRIEND$\ '
MS29,  'NO SUCH FRIEND$\ '
MS30,  'NO MORE ROOM IN FRIEND TABLE$\ '
MS31,  'AMBIGUOUS FILENAME$\ '
MS32,  'BAD CHARACTER COUNT$\ '

       )PCL ERMS1


       OVERX QOV15
QOV15=*-ROVER
)9MOVE ROVER VOR VORS
GLOB=VOR
)KILL VOR
VOR=GLOB+VORS
)KILL GLOB
OVLAY/ RQR-1
OVLAX/ RQR-1
SYSOV/ RQR-1
)WRTM
)WRITE QOV15
 
