%GNXTR
%GET NEXT TRACK NUMBER
%T = FILE NUMBER
%A = TRACK NUMBER
%RETURN A
%A = NEXT TRACK NUMBER OR -1 IF NO MORE
%FAILURE RETURN A
%A = 14 IF BAD FILE NUMBER
%A = 16 IF BAD TRACK NUMBER

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV16,G1,FGNXT
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV16; G1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FGNXT=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA OFTN,1
OFTN=ZYX
   )KILL ZYX
ZYX=OFTN+1;
   
       DATA OBJ,1
OBJ=ZYX
   )KILL ZYX
ZYX=OBJ+1;
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA XTRK,1
XTRK=ZYX
   )KILL ZYX
ZYX=XTRK+1;
   
G1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; SAA -1; STA XTRK,B
       AAT -10; SKP IF DT GRE 0; JMP GF14
       SAA NOFT; SKP IF DT LST SA; JMP GF14; STT OFTN,B
       LDX (OFT; LDA I OFTN,B,X; JAP GF14; JPL I (OFTX; STA OBJ,B
       LDA AREG,B; AAA 1; JAZ G1A
       LDA AREG,B; AND (174000; JAF GF16
       ENINT; DSINT; LDA I OBJ,B; JAN *-3
       BSET ONE 170 DA; STA I OBJ,B; ENINT
       LDA AREG,B; AND (3777; AAA 1
G1A,   STA CNT,B; AND (174000
       JAF GSS
G2,    LDA CNT,B; AND (3740; SAX 37; LDT I OBJ,B,X
       SKP IF DA UEQ ST; JMP G3
       SAD SHR 10; SAX 21; ADD I OBJ,B,X; COPY DT SA
       SAX 20; LDA I OBJ,B,X; JPL I (RBLOC; JMP *-1
       SAA 0; SAD 10; ADD (BTEMP; COPY DX SA
       LDT OBJ,B; AAT 40; SAA 40; JPL I (BCOPY; STZ I (BTEMP-4
       LDA CNT,B; AND (3740; SAX 37; STA I OBJ,B,X
G3,    LDA CNT,B; AND (37; ADD OBJ,B; AAA 40; COPY DX SA
       LDA 0,X; JAZ *+4; LDA CNT,B; STA XTRK,B; JMP GSS
       MIN CNT,B; LDA CNT,B; SUB (4000; JAN G2
GSS,   LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
       LDA XTRK,B; STA AREG,B; MIN LREG,B; JMP GFF+1
GF14,  SAA 16; JMP GFF
GF16,  SAA 20
GFF,   STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FGNXT



%AGTRK
%ABSOLUTE GET TRACK
%A = DEVICE ID
%T = TRACK ADDRESS
%RETURN A
%A = DISK ADDRESS OF TRACK
%FAILURE RETURN IF TRACK NOT AVAILABLE

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV16,A1,FAGTR
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV16; A1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FAGTR=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA SIZ,1
SIZ=ZYX
   )KILL ZYX
ZYX=SIZ+1;
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA CNTX,1
CNTX=ZYX
   )KILL ZYX
ZYX=CNTX+1;
   

A1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; JPL I (BSIZ; STA SIZ,B
       LDA AREG,B; JPL I (RBITB; JMP *-1
       LDA TREG,B; RCLR DD; SAD ZIN SHR 4
       LDT SIZ,B; SKP IF DA LST ST; JMP AFF
       COPY DT SD; SHT ZIN SHR 14; STT CNTX,B
       STA CNT,B; LDX (BITBL; LDA I CNT,B,X
       LDX (BITM; LDT I CNTX,B,X; COPY CM1 DT ST; RAND DT SA
       SKP IF DA UEQ ST; JMP AFF; LDX (BITBL; STT I CNT,B,X
       SAA 20; MPY CNT,B; ADD CNTX,B; SHA 3
       COPY DT SA; LDA AREG,B; JPL I (WBITB
       STT AREG,B; MIN LREG,B; JMP AFF+1
AFF,   STZ I (BITBL-3; JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FAGTR


%CRTRK
%CREATE TRACK
%T = FILE NUMBER
%A = TRACK NUMBER
%X = NUMBER OF TRACKS + TYPE OF ALLOCATION (UPPER 2 BITS)
%X(15-14) = 0 IF CYLINDER MODE
%         = 1 IF DYNAMIC MODE
%         = 3 IF ABSOLUTE MODE
%RETURN
%FAILURE RETURN A,T
%A = 1 IF NO MORE TRACKS AVAILABLE
%A = 12 IF NO ACCESS
%A = 14 IF BAD FILE NUMBER
%A = 16 IF BAD TRACK NUMBER
%A = 17 IF TRACK ALREADY EXISTS
%T = LAST TRACK CREATED BY THIS CALL OR -1 IF NONE

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV16,C1,FCRTR
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV16; C1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FCRTR=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA LTRK,1
LTRK=ZYX
   )KILL ZYX
ZYX=LTRK+1;
   
       DATA OBJ,1
OBJ=ZYX
   )KILL ZYX
ZYX=OBJ+1;
   
       DATA OFTN,1
OFTN=ZYX
   )KILL ZYX
ZYX=OFTN+1;
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA TNUM,1
TNUM=ZYX
   )KILL ZYX
ZYX=TNUM+1;
   
       DATA TRKAD,1
TRKAD=ZYX
   )KILL ZYX
ZYX=TRKAD+1;
   
       DATA UNUM,1
UNUM=ZYX
   )KILL ZYX
ZYX=UNUM+1;
   
C1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; SAA -1; STA LTRK,B
       AAT -10; SKP IF DT GRE 0; JMP I (CF14
       SAA NOFT; SKP IF DT LST SA; JMP I (CF14; STT OFTN,B
       LDX (OFT; LDA I OFTN,B,X; JAN *+2; JMP I (CF14
       BSKP ZRO 160 DA; JMP I (CF12; JPL I (OFTX; STA OBJ,B
       SAX 32; LDA I OBJ,B,X; SHA ZIN SHR 10; STA UNUM,B; COPY DT SA
       LDA XREG,B; AND (3777; JPL I (UTRK; JMP I (CFX
       LDA XREG,B; SHA ZIN SHR 16; AAA -3; JAF *+2; JMP I (C4
       LDT (3777; LDA AREG,B; LDX XREG,B; RAND DA ST
       RAND DX ST; JXZ CF16; RADD DA SX; AAA -1
       SKP IF DT GRE SA; JMP CF16
       ENINT; DSINT; LDA I OBJ,B; JAN *-3
       BSET ONE 170 DA; STA I OBJ,B; ENINT; STZ CNT,B
C2,    LDA AREG,B; AND (3777; ADD CNT,B; STA TNUM,B
       AND (3740; SAX 37; LDT I OBJ,B,X
       SKP IF DA UEQ ST; JMP C3
       SAD SHR 10; SAX 21; ADD I OBJ,B,X; COPY DT SA
       SAX 20; LDA I OBJ,B,X; JPL I (RBLOC; JMP *-1
       SAA 0; SAD 10; ADD (BTEMP; COPY DX SA
       LDT OBJ,B; AAT 40; SAA 40; JPL I (BCOPY
       STZ I (BTEMP-4; LDA TNUM,B; AND (3740
       SAX 37; STA I OBJ,B,X; JMP C3
       )FILL
C3,    LDA TNUM,B; AND (37; ADD OBJ,B; AAA 40; STA TRKAD,B
       LDA I TRKAD,B; JAF CF17; SAX 20; LDA I OBJ,B,X; JPL I (GTRK
       JMP CF1; STA I TRKAD,B; LDA TNUM,B; SAD SHR 10
       SAX 21; ADD I OBJ,B,X; COPY DT SA
       SAX 20; LDA I OBJ,B,X; JPL I (RBLOC; JMP *-1
       SAA 0; SAD 10; AND (340; ADD (BTEMP
       COPY DT SA; LDX OBJ,B; AAX 40; SAA 40; JPL I (BCOPY
       LDA TNUM,B; STA LTRK,B; JPL I (WBLOK
       MIN CNT,B; LDA XREG,B; AND (3777
       COPY CM2 DA SA; ADD CNT,B; JAN C2
CSS,   LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
       MIN LREG,B; JMP CFF3
CFX,   COPY DT SA; JMP CFF1
CF1,   SAT 1; JMP CFF1
CF12,  SAT 14; JMP CFF2
CF14,  SAT 16; JMP CFF2
CF16,  SAT 20; JMP CFF1
CF17,  SAT 21; JMP CFF1
CFF1,  LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
CFF2,  LDA AREG,B; STT AREG,B; LDT LTRK,B; STT TREG,B
       COPY DT SA; LDA LTRK,B; JAP *+3
       COPY DA ST; AAA -1; RSUB DT SA; COPY CM2 DT ST; AAT 1
       LDA XREG,B; AND (3777; RSUB DT SA
       COPY DA ST; LDT UNUM,B; JPL I (UTRK; JMP *+1
CFF3,  JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
C4,    ENINT; DSINT; LDA I OBJ,B; JAN *-3
       BSET ONE 170 DA; STA I OBJ,B; ENINT; STZ CNT,B
       SAA -1; SAX 33; STA I OBJ,B,X
C5,    LDA CNT,B; STA TNUM,B
       AND (3740; SAX 37; LDT I OBJ,B,X
       SKP IF DA UEQ ST; JMP C6
       SAD SHR 10; SAX 21; ADD I OBJ,B,X; COPY DT SA
       SAX 20; LDA I OBJ,B,X; JPL I (RBLOC; JMP *-1
       SAA 0; SAD 10; ADD (BTEMP; COPY DX SA
       LDT OBJ,B; AAT 40; SAA 40; JPL I (BCOPY
       STZ I (BTEMP-4; LDA TNUM,B; AND (3740
       SAX 37; STA I OBJ,B,X
C6,    LDA TNUM,B; AND (37; ADD OBJ,B; AAA 40; STA TRKAD,B
       LDA I TRKAD,B; JAF CF22; LDA AREG,B; AND (3777
       ADD CNT,B; COPY DT SA; SAX 20; LDA I OBJ,B,X
       JPL I (AGTRK; JMP CF22
       STA I TRKAD,B; LDA TNUM,B; SAD SHR 10
       SAX 21; ADD I OBJ,B,X; COPY DT SA
       SAX 20; LDA I OBJ,B,X; JPL I (RBLOC; JMP *-1
       SAA 0; SAD 10; AND (340; ADD (BTEMP
       COPY DT SA; LDX OBJ,B; AAX 40; SAA 40; JPL I (BCOPY
       LDA TNUM,B; STA LTRK,B; JPL I (WBLOK
       MIN CNT,B; LDA XREG,B; AND (3777
       COPY CM2 DA SA; ADD CNT,B; JAN C5; JMP I (CSS
CF22,  LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
       LDT TREG,B; LDA XREG,B; AND (3777; COPY DX SA
       SAA 0; JPL I (DLTRK; JMP *+1; SAT 26; JMP I (CFF2
       )FILL
       )PCL FCRTR


       OVERX QOV16
QOV16=*-ROVER
