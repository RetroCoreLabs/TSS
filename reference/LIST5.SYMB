%COMMAND TABLE

CMD,   NCMD; RESET; RECV; DUMP; GOTO; LOAD
       PLACE; MEM; QUIT; HELP; OPFC; CLFC
       LISTF; DELFC; RENAM; REGS; SETX; EXAM
       RESRV; RELSE; WHERE; CLON; CLOFF
       LINKS; BRKLK; CRUSR; PASWD; WHOS
       IACCT; PACCT; LUSR; TUSED; PAUSE
       CONT; DKSP; ALKAT; LOBJ; CRFRC; DLFRC
       LSFRC; SUIBC; SFILC; CMOD; MRENT; DLMEM
       CPASW; RSPT; DELUS; SAVE; GET; PINC
       DDATE; CDATE; RBLOAD; TRTRK; LTRKS; BAKUP
       DEVER; LOADV; SYSUP; SYSDW

%START AND LEVEL 2 ENTRY POINT
%START COMMAND PROCESSOR

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV19,S1,XSTAR
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV19; S1; SAVX
)KILL BLUES
BLUES=*
GLOB/
XSTAR=BLOB
)KILL BLOB
)KILL GLOB
   

%STRING POINTER TO PREVIOUS COMMAND LINE
       DATA OSTR,5
OSTR=ZYX
   )KILL ZYX
ZYX=OSTR+5;
   
%POINTER TO PREVIOUS COMMAND LINE STRING
       DATA OLIN,1
OLIN=ZYX
   )KILL ZYX
ZYX=OLIN+1;
   
%TEMPORARY STRING POINTER
       DATA TSTR,5
TSTR=ZYX
   )KILL ZYX
ZYX=TSTR+5;
   
%POINTER TO TEMPORARY STRING
       DATA TPTR,1
TPTR=ZYX
   )KILL ZYX
ZYX=TPTR+1;
   
%STRING POINTER TO COMMAND STRING
       DATA CSTR,5
CSTR=ZYX
   )KILL ZYX
ZYX=CSTR+5;
   
%POINTER TO CSTR
       DATA CPTR,1
CPTR=ZYX
   )KILL ZYX
ZYX=CPTR+1;
   
%COMMAND STRING
       DATA XTR0,20
XTR0=ZYX
   )KILL ZYX
ZYX=XTR0+20;
   
%STRING TWO
       DATA XTR2,50
XTR2=ZYX
   )KILL ZYX
ZYX=XTR2+50;
   



S1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; SAX TSTR; RADD DX SB; STX TPTR,B
       SAT -1; JPL I (CFILE; JMP *+1
       LDT I (CINF; SAA 0; JPL I (SBRKS; JPL I (SECHS
       SAX OSTR; RADD DX SB; STX OLIN,B
       LDX (7STRD; STX I (CMDLN; LDT (7STRX; SAA 120
       SAD ZIN SHR 20; JPL I (SETUP
       SAX CSTR; RADD DX SB; STX CPTR,B; SAT STR0
       RADD DT SB; SAA 40; SAD ZIN SHR 20; JPL I (SETUP
       SAT STR2; RADD DT SB; SAA 120; LDX OLIN,B
       SAD ZIN SHR 20; JPL I (SETUP; JPL I (CRLF
       LDA I (TIME0+1; JAF CLOOP; SAA 1; STA I (TIME0+1
       LDX (MS1; JPL I (MSG; LDX OLIN,B; LDT I (CMDLN
       JPL I (EDIT; JMP *+1; JPL I (DDATE; JMP CLOOP; JMP CLOOP
       )FILL
CLOOP, SAA ##@; JPL I (TCO; STZ I (ELOCK
       LDX OLIN,B; LDT I (CMDLN; JPL I (EDIT; JMP *+1
       LDX I (CMDLN; LDT TPTR,B; SAA 5; JPL I (BCOPY
       LDX I (CMDLN; LDT CPTR,B; JPL I (GCMD; JMP ERR
       JPL I (RCMD; LDX CPTR,B; LDT (STARR; SAA 1
       COPY DD SA; LDA (SCMD; JPL I (ABLKP
       JMP CERR; ADD (CMD; COPY DX SA; RCLR DA; RCLR DT
       LDX 0,X; JPL 0,X; JMP ERR
S2,    LDT I (CMDLN; LDX OLIN,B; SAA 5; JPL I (BCOPY
       LDX I (CMDLN; RCLR DA ; RCLR DD; JPL I (SETW
       LDT OLIN,B; LDX TPTR,B; SAA 5; JPL I (BCOPY
       JMP CLOOP
ERR,   SAA ##?; JPL I (TCO; JPL I (CRLF; JMP S2
CERR,  AAA 1; JAZ CERR1; AAA 1; JAF ERR
       SAA 53; JPL I (ERMSG; JMP S2
CERR1, LDT I (CMDLN; LDX TPTR,B; SAA 5; JPL I (BCOPY
       JPL I (RECV; JMP ERR; JMP S2
MS1,   '$TYPE IN DATE (DD,MM,YYYY,HH,MM,SS): \ '
       )FILL
       )PCL XSTAR


%DDATE
%DEFINE DATE
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV19,D1,DDATE
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV19; D1; SAVX
)KILL BLUES
BLUES=*
GLOB/
DDATE=BLOB
)KILL BLOB
)KILL GLOB
   

D1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; LDT I (CMDLN
       LDA I (TIME0+1; AAA -1; JAZ D2
       JPL I (WHUSR; AAA -1; JAZ D2
       SAA 56; JPL I (ERMSG; JMP DSS
D2,    SAA 33; JPL I (PCF; JMP D2; STA I (DAY0
D3,    SAA 34; JPL I (PCF; JMP D3; STA I (MONT0
D4,    SAA 35; JPL I (PCF; JMP D4; SUB (3554; STA I (YEAR0
D5,    SAA 36; JPL I (PCF; JMP D5; STA I (HOUR0
D6,    SAA 37; JPL I (PCF; JMP D6; STA I (MIN0
D7,    SAA 40; JPL I (PCF; JMP D7; STA I (SEC0
       LDD I (16; STD I (TIME0
DSS,   MIN LREG,B; RET

   RCLR DP AD1
          )FILL
       )PCL DDATE


%CDATE
%PRINT DATE AND TIME
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV19,C1,CDATE
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV19; C1; SAVX
)KILL BLUES
BLUES=*
GLOB/
CDATE=BLOB
)KILL BLOB
)KILL GLOB
   

C1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; LDX (MS1; JPL I (MSG
       SAT 1; JPL I (PDATE; JMP *+1; JPL I (CRLF
       MIN LREG,B; RET

   RCLR DP AD1
   MS1,   'DATE IS \ '
       )FILL
       )PCL CDATE


%OTIMF
%OUTPUT TIME TO A FILE
%AD = TIME
%T = FILE NUMBER
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV19,O1,FOTIM
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV19; O1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FOTIM=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA T1,1
T1=ZYX
   )KILL ZYX
ZYX=T1+1;
   
       DATA T2,1
T2=ZYX
   )KILL ZYX
ZYX=T2+1;
   
       DATA T3,3
T3=ZYX
   )KILL ZYX
ZYX=T3+3;
   
       DATA T4,3
T4=ZYX
   )KILL ZYX
ZYX=T4+3;
   
       DATA T5,1
T5=ZYX
   )KILL ZYX
ZYX=T5+1;
   
MS1,   ' HOURS \ '
MS2,   ' MINS \ '
MS3,   ' SECS\ '

O1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; LDD AREG,B
       JPL I (NORM; STF T3,B; SAA 62; NLZ 20
       STF T4,B; LDF T3,B; FDV T4,B; STF T3,B
       SAA 74; NLZ 20; STF T4,B; LDF T3,B; FDV T4,B
       DNZ -20; STA T1,B; NLZ 20; FMU T4,B
       STF T4,B; LDF T3,B; FSB T4,B; DNZ -20; STA T2,B
       LDA T1,B; SAT 74; JPL I (DIV; STA T5,B
       COPY DA SD; STA T1,B; LDA T5,B; JAZ O2
       SAT 12; LDX TREG,B; JPL I (IOUTF; JPL I (FTLER
       LDX (MS1; LDT TREG,B; JPL I (MSGF
O2,    LDA T1,B; JAZ O3; SAT 12; LDX TREG,B
       JPL I (IOUTF; JPL I (FTLER; LDX (MS2; LDT TREG,B; JPL I (MSGF
O3,    LDA T2,B; SAT 12; LDX TREG,B; JPL I (IOUTF
       JPL I (FTLER; LDX (MS3; LDT TREG,B; JPL I (MSGF
       RET

   RCLR DP AD1
          )FILL
       )PCL FOTIM


%RSPT
%AVERAGE RESPONSE TIME
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV19,R1,RSPT
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV19; R1; SAVX
)KILL BLUES
BLUES=*
GLOB/
RSPT=BLOB
)KILL BLOB
)KILL GLOB
   
MS1,   'AVERAGE RESPONSE TIME IS \ '
MS2,   ' SECONDS$OVER A PERIOD OF \ '

R1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; LDX (MS1; JPL I (MSG
       LDD I (RSTIM; LDT I (RSNUM; JPL I (XDIV
       SAT 62; JPL I (DIV; SAT 12; JPL I (IOUT
       SAA ##.; JPL I (TCO; COPY DA SD; SAT 5; JPL I (DIV
       SAT 12; JPL I (IOUT; COPY DA SD; SHA 1
       SAT 12; JPL I (IOUT; LDX (MS2; JPL I (MSG
       LDD I (KLOK; SAT 1; JPL I (OTIMF; JPL I (CRLF
       SRET

   LDX I *+3; MIN LREG,X; JPL I *+2
   SPTR; USTK
          )FILL
       )PCL RSPT


       OVERX QOV19
QOV19=*-ROVER
