       OVERL OV10
OV10=RQR
   )KILL RQR
RQR=OV10+1
ROVER/
   


%DLUSR
%DELETE USER
%T = USER NUMBER
%A = DEVICE ID
%RETURN
%FAILURE RETURN A
%A = ERROR CODE

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV10,D1,FDLUS
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV10; D1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FDLUS=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA DKAD,1
DKAD=ZYX
   )KILL ZYX
ZYX=DKAD+1;
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA CNTX,1
CNTX=ZYX
   )KILL ZYX
ZYX=CNTX+1;
   
       DATA CNT1,1
CNT1=ZYX
   )KILL ZYX
ZYX=CNT1+1;
   
       DATA CNT2,1
CNT2=ZYX
   )KILL ZYX
ZYX=CNT2+1;
   
       DATA INDX,1
INDX=ZYX
   )KILL ZYX
ZYX=INDX+1;
   
       DATA OBJ,1
OBJ=ZYX
   )KILL ZYX
ZYX=OBJ+1;
   
       DATA TCNT,1
TCNT=ZYX
   )KILL ZYX
ZYX=TCNT+1;
   

D1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; JPL I (KDEV; JPL I (DVERR
       JPL I (UNDK; JMP DF4; STA DKAD,B; STZ TCNT,B
       SAA 1; STA CNT,B; STZ CNTX,B
D2,    LDA DKAD,B; ADD CNT,B; COPY DT SA; LDA AREG,B
       JPL I (RBLOC; JMP *-1
       LDA CNTX,B; SHA 5; ADD (BTEMP; STA OBJ,B
       SAX 1; LDA I OBJ,B,X; JAF *+3; STZ I (BTEMP-4; JMP D2C
       SAX 21; LDA I OBJ,B,X; STA INDX,B; STZ I (BTEMP-4
       SAA -1; STA CNT1,B; STZ CNT2,B; JMP D4C
D3,    LDX (BTEMP; LDT I CNT2,B,X; SKP IF DT UEQ 0; JMP D3C
       LDA AREG,B; JPL I (RTRK; JMP *+1; MIN TCNT,B
       LDX (BTEMP; STZ I CNT2,B,X
D3C,   MIN CNT2,B; LDA CNT2,B; SUB (400; JAN D3
       JPL I (WBLOK; STZ CNT2,B
D4C,   MIN CNT1,B; LDA CNT1,B; AAA -10; JAP D5
       LDA CNT1,B; ADD INDX,B; COPY DT SA; LDA AREG,B
       JPL I (RBLOC; JMP *-1; JMP D3
D5,    LDT INDX,B; LDA AREG,B; JPL I (RTRK; JMP *+1; MIN TCNT,B
D2C,   MIN CNTX,B; LDA CNTX,B; AAA -10; JAN D2; STZ CNTX,B
       MIN CNT,B; LDA CNT,B; AAA -10; JAN D2
       LDA TCNT,B; AAA 1; COPY CM2 DA SA; SAT 1; JPL I (UTRK; JMP *+1
       SAA 0; LDT TREG,B; JPL I (UTRK; JMP *+5
       COPY CM2 DA SA; SAT 1; JPL I (UTRK; JMP *+1
       LDA AREG,B; LDT DKAD,B; JPL I (RTRK; JMP *+1
       LDA TREG,B; AAA -1; RCLR DD; SAD SHR 5; AAA 1
       STA OBJ,B; COPY DT SA; LDA AREG,B; JPL I (RUTBL; JMP *-1
       SAA 0; SAD 10; ADD (USTBL; COPY DX SA
       SAT 0; SAA 10; JPL I (SETB
       LDT OBJ,B; LDA AREG,B; JPL I (WUTBL
       MIN LREG,B; JMP DF4+2
DF4,   SAA 4; STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FDLUS



%CRUSE
%CREATE USER
%D = DEVICE ID
%X = POINTER TO USER NAME
%RETURN A
%A = USER NUMBER
%FAILURE RETURN A
%A = 1 IF NO MORE TRACKS
%A = 2 IF TOO MANY USERS
%A = 3 IF USER ALREADY EXISTS

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV10,C1,FCRUS
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV10; C1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FCRUS=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA CNTX,1
CNTX=ZYX
   )KILL ZYX
ZYX=CNTX+1;
   
       DATA XCNT,1
XCNT=ZYX
   )KILL ZYX
ZYX=XCNT+1;
   
       DATA XCNTX,1
XCNTX=ZYX
   )KILL ZYX
ZYX=XCNTX+1;
   
       DATA ACNT,1
ACNT=ZYX
   )KILL ZYX
ZYX=ACNT+1;
   
       DATA ACNTX,1
ACNTX=ZYX
   )KILL ZYX
ZYX=ACNTX+1;
   
C1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; SAA 1; STA CNT,B; STZ XCNT,B
       SAA -1; STA ACNT,B; STA ACNTX,B
       LDA DREG,B; JPL I (KDEV; JPL I (DVERR
C2,    LDA DREG,B; LDT CNT,B; JPL I (RUTBL; JMP *-1
       STZ CNTX,B
C3,    LDA CNTX,B; SHA 3; ADD (USTBL; COPY DT SA
       LDX XREG,B; SAA 7; JPL I (BEQL; JMP *+2; JMP CF3
       COPY DX ST; LDA 0,X; JAF *+7; LDA ACNT,B; JAP *+5
       LDA CNT,B; STA ACNT,B
       LDA CNTX,B; STA ACNTX,B; MIN CNTX,B
       LDA CNTX,B; AAA -40; JAN C3
       LDT CNT,B; LDA DREG,B; JPL I (WUTBL; MIN CNT,B
       LDA CNT,B; AAA -10; JAN C2
       LDA ACNT,B; JAN CF2; COPY DT SA
       LDA DREG,B; JPL I (RUTBL; JMP *-1
       LDA DREG,B; JPL I (GTRK; JMP CF1; COPY DT SA
       LDA ACNTX,B; SHA 3; ADD (USTBL; COPY DX SA
       STT 7,X; COPY DT SX; LDX XREG,B
       SAA 7; JPL I (BCOPY
       LDA ACNT,B; AAA -1; SHA 5; ADD ACNTX,B; AAA 1; STA AREG,B
       LDT ACNT,B; LDA DREG,B; JPL I (WUTBL
       LDT AREG,B; LDA DREG,B; SAX 0
       JPL I (IUSER; JPL I (FTLER
       LDA AREG,B; AAA -1; JAZ *+5
       SAA 1; SAT 1; JPL I (UTRK; JMP CF
       MIN LREG,B; JMP CF+1
CF1,   LDT ACNT,B; LDA DREG,B; JPL I (WUTBL
       SAA 1; JMP CF
CF2,   SAA 2; JMP CF
CF3,   LDT CNT,B; LDA DREG,B; JPL I (WUTBL; SAA 3
CF,    STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FCRUS


%IUSER
%INITIALIZE USER
%A = DEVICE ID
%X = NUMBER OF TRACKS
%T = USER NUMBER
%RETURN
%FAILURE RETURN IF NO SUCH USER

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV10,I1,FIUSE
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV10; I1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FIUSE=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA DKAD,1
DKAD=ZYX
   )KILL ZYX
ZYX=DKAD+1;
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
I1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       JPL I (UNDK; JMP IFF; STA DKAD,B
       LDA AREG,B; LDT DKAD,B; JPL I (RBLOC; JMP *-1
       LDX (BTEMP; STZ 0,X; LDA (731; STA 1,X
       LDA XREG,B; STA 2,X; AAX 3; SAT 0; LDA (400-3
       JPL I (SETB; JPL I (WBLOK; SAA 1; STA CNT,B
I2,    LDA DKAD,B; ADD CNT,B; COPY DT SA; LDA AREG,B
       JPL I (RBLOC; JMP *-1; LDX (BTEMP; SAT 0
       LDA (400; JPL I (SETB; JPL I (WBLOK; MIN CNT,B
       LDA CNT,B; AAA -10; JAN I2; MIN LREG,B
IFF,   JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FIUSE


%GETUN
%GET USER NUMBER
%D = DEVICE ID
%X = POINTER TO USER NAME
%RETURN A
%A = USER NUMBER
%FAILURE RETURN A
%A = 4 IF NO SUCH USER

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV10,G1,FGETU
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV10; G1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FGETU=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA CNTX,1
CNTX=ZYX
   )KILL ZYX
ZYX=CNTX+1;
   
G1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; SAA 1; STA CNT,B
       LDA DREG,B; JPL I (KDEV; JPL I (DVERR
G2,    LDA DREG,B; LDT CNT,B; JPL I (RUTBL; JMP *-1
       STZ CNTX,B
G3,    LDA CNTX,B; SHA 3; ADD (USTBL; COPY DT SA
       LDX XREG,B; SAA 7; JPL I (BEQL; JMP G4
       STZ I (USTBL-4; LDA CNT,B; AAA -1; SHA 5
       ADD CNTX,B; AAA 1; STA AREG,B; MIN LREG,B; JMP GFF
G4,    MIN CNTX,B; LDA CNTX,B; AAA -40; JAN G3
       STZ I (USTBL-4; MIN CNT,B; LDA CNT,B
       AAA -10; JAN G2; SAA 4; STA AREG,B
GFF,   JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FGETU


       OVERX QOV10
QOV10=*-ROVER
)9MOVE ROVER VOR VORS
GLOB=VOR
)KILL VOR
VOR=GLOB+VORS
)KILL GLOB
OVLAY/ RQR-1
OVLAX/ RQR-1
SYSOV/ RQR-1
)WRTM
)WRITE QOV10
 
:000561    

       OVERL OV11
OV11=RQR
   )KILL RQR
RQR=OV11+1
ROVER/
   


%SUIB
%SEARCH UIB FOR GIVEN FILE
%A = DEVICE ID
%X = POINTER TO FILE ID
%RETURN A,T IF FILE EXISTS
%T = DISK ADDRESS
%A = DISPLACEMENT
%FAILURE RETURN A,T IF FILE DOES NOT EXIST
%A = -1 IF NO SUCH USER
%A = -2 IF NO MORE ROOM
%T = DISK ADDRESS OF FIRST FREE ENTRY
%X = UIB ACCESS WORD
%D = OBJECT INDEX
%A = DISPLACEMENT

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV11,U1,FSUIB
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV11; U1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FSUIB=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA CNTX,1
CNTX=ZYX
   )KILL ZYX
ZYX=CNTX+1;
   
       DATA ACNT,1
ACNT=ZYX
   )KILL ZYX
ZYX=ACNT+1;
   
       DATA ACNTX,1
ACNTX=ZYX
   )KILL ZYX
ZYX=ACNTX+1;
   
       DATA DKAD,1
DKAD=ZYX
   )KILL ZYX
ZYX=DKAD+1;
   
       DATA ACCWD,1
ACCWD=ZYX
   )KILL ZYX
ZYX=ACCWD+1;
   
U1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; SAA 1; STA CNT,B; STZ ACNT,B
       LDA AREG,B; LDT I XREG,B; JPL I (UNDK; JMP UFF
       STA DKAD,B; COPY DT SA; LDA AREG,B; JPL I (RBLOC; JMP *-1
       LDA I (BTEMP+1; STA ACCWD,B; STZ I (BTEMP-4
U2,    LDA DKAD,B; ADD CNT,B; COPY DT SA; LDA AREG,B
       JPL I (RBLOC; JMP *-1; STZ CNTX,B
U3,    LDA CNTX,B; SHA 5; ADD (BTEMP; COPY DX SA
       LDA 1,X; JAF U4; LDA ACNT,B; JAF U4
       LDA CNT,B; STA ACNT,B; LDA CNTX,B; STA ACNTX,B; JMP U5
U4,    AAX 1; LDT XREG,B; AAT 1; SAA 12
       JPL I (BEQL; JMP U5
       STZ I (BTEMP-4; LDA DKAD,B; ADD CNT,B; STA TREG,B
       LDA CNTX,B; SHA 5; STA AREG,B; MIN LREG,B; JMP UFF+2
U5,    MIN CNTX,B; LDA CNTX,B; AAA -10; JAN U3; STZ I (BTEMP-4
       MIN CNT,B; LDA CNT,B; AAA -10; JAN U2
       LDA ACNT,B; JAF U6; SAA -2; JMP UFF+1
U6,    LDA DKAD,B; ADD ACNT,B; STA TREG,B
       LDA ACNT,B; AAA -1; SHA 3; ADD ACNTX,B; STA DREG,B
       LDT ACCWD,B; STT XREG,B; LDA ACNTX,B; SHA 5; JMP UFF+1
UFF,   SAA -1; STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FSUIB


%CRFIL
%CREATE FILE
%A = DEVICE ID
%X = POINTER TO FILE ID
%    (USER NO., NAME, ED., TYPE, PASSWORD, OBJECT TYPE,
%    LOGICAL BLOCK SIZE, DATE)
%RETURN
%FAILURE RETURN A
%A = 1 IF NO MORE TRACKS AVAILABLE
%A = 4 IF NO SUCH USER
%A = 5 IF NO MORE ROOM IN UIB
%A = 6 IF FILE ALREADY EXISTS
%A = 7 IF ILLEGAL OBJECT TYPE
%A = 12 IF NO ACCESS

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV11,C1,FCRFI
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV11; C1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FCRFI=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA DKA1,1
DKA1=ZYX
   )KILL ZYX
ZYX=DKA1+1;
   
       DATA DKA2,1
DKA2=ZYX
   )KILL ZYX
ZYX=DKA2+1;
   
       DATA DISP,1
DISP=ZYX
   )KILL ZYX
ZYX=DISP+1;
   
       DATA ACCWD,1
ACCWD=ZYX
   )KILL ZYX
ZYX=ACCWD+1;
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA OBJ,1
OBJ=ZYX
   )KILL ZYX
ZYX=OBJ+1;
   
       DATA OBJI,1
OBJI=ZYX
   )KILL ZYX
ZYX=OBJI+1;
   
C1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       LDA AREG,B; JPL I (KDEV; JPL I (DVERR
       SAA 1; LDT I XREG,B; JPL I (UTRK; JMP I (CFF
       LDT I XREG,B; LDA AREG,B; COPY DD SA; BSET ONE 170 DA
       SAX 4; JPL I (CKACC; JMP I (CF12
       LDA AREG,B; LDX XREG,B; JPL I (SUIB
       JMP *+2; JMP I (CF6; JAP C2; AAA 1; JAF *+2; JMP I (CF4
       AAA 1; JAF *+2; JMP I (CF5; JPL I (FTLER
C2,    STT DKA1,B; STA DISP,B; STX ACCWD,B; COPY DA SD; STA OBJI,B
       LDX XREG,B; LDA 17,X; JAZ *+2; JMP I (CF7
       LDA AREG,B; JPL I (GTRK; JMP I (CF1; STA DKA2,B
       LDA AREG,B; LDT DKA1,B; JPL I (RBLOC; JMP *-1
       LDA (BTEMP; ADD DISP,B; STA OBJ,B; JMP C2A
       )FILL
C2A,   STZ I OBJ,B; LDT OBJ,B; AAT 1; LDX XREG,B; AAX 1
       SAA 16; JPL I (BCOPY; SAX 17; LDA I XREG,B,X
       SHA 11; ORA ACCWD,B; SAX 17; STA I OBJ,B,X
       LDA AREG,B; SAX 20; STA I OBJ,B,X
       SAX 33; STZ I OBJ,B,X
       LDA I XREG,B; SHA 10; ADD OBJI,B; SAX 32; STA I OBJ,B,X
       LDA DKA2,B; SAX 21; STA I OBJ,B,X
       RCLR DA; RCLR DD; SAX 22; STD I OBJ,B,X
       SAX 20; LDA I XREG,B,X; SAX 24; STA I OBJ,B,X
       SAA 0; SAT 0; SAX 25; STF I OBJ,B,X
       SAX 21; LDD I XREG,B,X; SAX 30; STD I OBJ,B,X
       JPL I (WBLOK; STZ CNT,B
C3,    LDA DKA2,B; ADD CNT,B; COPY DT SA; LDA AREG,B
       JPL I (RBLOC; JMP *-1; LDX (BTEMP
       SAT 0; LDA (400; JPL I (SETB; JPL I (WBLOK
       MIN CNT,B; LDA CNT,B; AAA -10; JAN C3
       MIN LREG,B; JMP CFF+1
CF1,   SAA 1; JMP CFF
CF4,   SAA 4; JMP CFF
CF5,   SAA 5; JMP CFF
CF6,   SAA 6; JMP CFF
CF7,   SAA 7; JMP CFF
CF12,  SAA 14; JMP CFF
CFF,   STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FCRFI


%SFILA
%SET FILE ACCESS
%A = DEVICE ID
%X = POINTER TO FILE ID
%    (USER NO., NAME, ED.)
%T = ACCESS WORD
%RETURN
%FAILURE RETURN A
%A = 4 IF NO SUCH USER
%A = 8 IF NO SUCH FILE
%A = 12 IF NO ACCESS

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV11,S1,FSFIL
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV11; S1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FSFIL=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA ACCW,1
ACCW=ZYX
   )KILL ZYX
ZYX=ACCW+1;
   
S1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       LDA AREG,B; JPL I (KDEV; JPL I (DVERR
       LDA AREG,B; LDX XREG,B; JPL I (CKOBT; JMP SF27
       JPL I (SUIB; JMP SFF; COPY DD SA; LDA AREG,B
       JPL I (RBLOC; JMP *-1; LDX (BTEMP; RADD DX SD
       LDA TREG,B; AND (777; COPY DD SA
       LDA 17,X; STA ACCW,B; AND (177000; RORA DA SD; STA 17,X
       LDA AREG,B; COPY DD SA; LDT I XREG,B; LDA ACCW,B; AND (777
       SAX 4; JPL I (CKACC; JMP SF12
S2,    JPL I (WBLOK; MIN LREG,B; JMP SFF+4
SFF,   AAA 1; JAF SF8; SAA 4; STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
   SF8,   SAA 10; JMP SFF+3
SF12,  JPL I (WHUSR; SUB I XREG,B; JAZ S2
       LDX (BTEMP-4; SAT 0; SAA 4; JPL I (SETB
       SAA 14; JMP SFF+3
SF27,  SAA 33; JMP SFF+3
       )FILL
       )PCL FSFIL


%SUIBA
%SET UIB ACCESS
%A = DEVICE ID
%X = USER NUMBER
%T = ACCESS WORD
%RETURN
%FAILURE RETURN A
%A = 4 IF NO SUCH USER
%A = 12 IF NO ACCESS

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV11,S1,FSUAB
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV11; S1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FSUAB=BLOB
)KILL BLOB
)KILL GLOB
   
S1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       LDA AREG,B; JPL I (KDEV; JPL I (DVERR
       LDA AREG,B; COPY DD SA; LDT XREG,B; BSET ONE 170 DA
       SAX 4; JPL I (CKACC; JMP SF12; STZ I (UIBTB
S2,    LDA AREG,B; LDT XREG,B; JPL I (UNDK; JMP SF4
       COPY DT SA; LDA AREG,B; JPL I (RBLOC; JMP *-1
       LDA TREG,B; AND (777; STA I (BTEMP+1; JPL I (WBLOK
       MIN LREG,B; JMP SF4+2
SF4,   SAA 4; STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
   SF12,  JPL I (WHUSR; SUB XREG,B; JAZ S2
       SAA 14; JMP SF4+1
       )FILL
       )PCL FSUAB


%CNAME
%CHANGE NAME OF FILE
%X = POINTER TO FILE ID (AS IN SFILA)
%T = POINTER TO NEW FILE ID
%    (NAME, ED., TYPE, PASSWORD)
%A = DEVICE ID
%RETURN
%FAILURE RETURN A
%A = 4 IF NO SUCH USER
%A = 6 IF NEW FILE NAME ALREADY EXISTS
%A = 8 IF NO SUCH FILE
%A = 12 IF NO ACCESS

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV11,C1,FCNAM
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV11; C1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FCNAM=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA BUFF,17
BUFF=ZYX
   )KILL ZYX
ZYX=BUFF+17;
   
       DATA DISP,1
DISP=ZYX
   )KILL ZYX
ZYX=DISP+1;
   
C1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       LDA AREG,B; JPL I (KDEV; JPL I (DVERR
       LDA AREG,B; LDX XREG,B; JPL I (CKOBT; JMP CF27
       SAT BUFF; RADD DT SB AD1
       LDX TREG,B; SAA 16; JPL I (BCOPY
       LDA I XREG,B; STA BUFF,B
       SAX BUFF; RADD DX SB; LDA AREG,B; JPL I (SUIB
       JMP *+2; JMP CF6; AAA 1; JAZ CF4
       LDX XREG,B; LDA AREG,B; JPL I (SUIB; JMP CF8
       STA DISP,B; LDA AREG,B; JPL I (RBLOC; JMP *-1
       LDA AREG,B; COPY DD SA; LDT I XREG,B; LDA (BTEMP
       ADD DISP,B; COPY DX SA; LDA 17,X; AND (777
       SAX 4; JPL I (CKACC; JMP CF12
       LDA (BTEMP; ADD DISP,B; COPY DT SA AD1
       SAX BUFF; RADD DX SB AD1; SAA 16; JPL I (BCOPY
       JPL I (WBLOK; MIN LREG,B; JMP CFF+1
CF4,   SAA 4; JMP CFF
CF6,   SAA 6; JMP CFF
CF8,   SAA 10; JMP CFF
CF12,  SAA 14; STZ I (BTEMP-4; JMP CFF
CF27,  SAA 33; JMP CFF
CFF,   STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL 
       )PCL FCNAM


       OVERX QOV11
QOV11=*-ROVER
)9MOVE ROVER VOR VORS
GLOB=VOR
)KILL VOR
VOR=GLOB+VORS
)KILL GLOB
