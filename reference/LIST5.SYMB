%CRFR
%CREATE FRIEND
%A = DEVICE ID
%T = USER NUMBER
%X = FRIENDS USER NUMBER
%RETURN
%FAILURE RETURN A
%A = 4 IF NO SUCH USER
%A = 12 IF NO ACCESS
%A = 28 IF SPECIFIED USER IS ALREADY A FRIEND
%A = 30 IF NO MORE ROOM IN FRIEND TABLE

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV17,C1,FCRFR
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV17; C1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FCRFR=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   
       DATA ACNT,1
ACNT=ZYX
   )KILL ZYX
ZYX=ACNT+1;
   

C1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       LDA AREG,B; JPL I (KDEV; JPL I (DVERR
       LDA AREG,B; COPY DD SA; LDT TREG,B; BSET ONE 170 DA
       SAX 4; JPL I (CKACC; JMP CF12; SAA -1; STA ACNT,B
       LDA AREG,B; LDT TREG,B; JPL I (UNDK; JMP CF4; STZ I (UIBTB
       COPY DT SA; LDA AREG,B; JPL I (RBLOC; JMP *-1; STZ CNT,B
C2,    LDA CNT,B; SAD SHR 1; ADD (BTEMP+3; COPY DX SA; LDA 0,X
       BSKP ONE 170 DD; SHA ZIN SHR 10; AND (377
       LDT XREG,B; SKP IF DA UEQ ST; JMP CF28; JAF C2C
       LDA ACNT,B; JAP C2C; LDA CNT,B; STA ACNT,B
C2C,   MIN CNT,B; LDA CNT,B; AAA -6; JAN C2
       LDA ACNT,B; JAN CF30; SAD SHR 1; ADD (BTEMP+3; COPY DX SA
       LDA 0,X; LDT XREG,B; BSKP ZRO 170 DD; JMP C3
       SHT 10; AND (377; RORA DA ST; JMP C4
C3,    AND (177400; RORA DA ST
C4,    STA 0,X; JPL I (WBLOK; MIN LREG,B; JMP CFF+1
CFF,   STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
   CF4,   SAA 4; JMP CFF
CF12,  SAA 14; JMP CFF
CF28,  SAA 34; STZ I (BTEMP-4; JMP CFF
CF30,  SAA 36; JMP CF28+1
       )FILL
       )PCL FCRFR


%DLFR
%DELETE FRIEND
%A = DEVICE ID
%T = USER NUMBER
%X = FRIENDS USER NUMBER
%RETURN
%FAILURE RETURN A
%A = 4 IF NO SUCH USER
%A = 12 IF NO ACCESS
%A = 29 IF NO SUCH FRIEND

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV17,D1,FDLFR
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV17; D1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FDLFR=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   

D1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       LDA AREG,B; JPL I (KDEV; JPL I (DVERR
       LDA AREG,B; COPY DD SA; LDT TREG,B; BSET ONE 170 DA
       SAX 4; JPL I (CKACC; JMP DF12; STZ CNT,B; STZ I (UIBTB
       LDA AREG,B; LDT TREG,B; JPL I (UNDK; JMP DF4
       COPY DT SA; LDA AREG,B; JPL I (RBLOC; JMP *-1
D2,    LDA CNT,B; SAD SHR 1; ADD (BTEMP+3; COPY DX SA; LDA 0,X
       BSKP ONE 170 DD; SHA ZIN SHR 10; AND (377
       LDT XREG,B; SKP IF DA UEQ ST; JMP D3
       MIN CNT,B; LDA CNT,B; AAA -6; JAN D2
       SAA 35; STZ I (BTEMP-4; JMP DFF
D3,    LDA 0,X; BSKP ONE 170 DD; JMP *+3
       AND (177400; JMP *+2; AND (377; STA 0,X
       JPL I (WBLOK; MIN LREG,B; JMP DFF+1
DFF,   STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
   DF4,   SAA 4; JMP DFF
DF12,  SAA 14; JMP DFF
       )FILL
       )PCL FDLFR


%LSFR
%LIST FRIENDS
%A = DEVICE ID
%T = USER NUMBER
%X = ARRAY FOR FRIEND LIST (FIRST WORD IS THE COUNTER)
%RETURN
%FAILURE RETURN A
%A = 4 IF NO SUCH USER
%A = 12 IF NO ACCESS

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV17,L1,FLSFR
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV17; L1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FLSFR=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   

L1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       LDA AREG,B; JPL I (KDEV; JPL I (DVERR
       LDA AREG,B; COPY DD SA; LDT TREG,B; BSET ONE 170 DA
       SAX 1; JPL I (CKACC; JMP LF12; STZ CNT,B
       LDA AREG,B; LDT TREG,B; JPL I (UNDK; JMP LF4
       COPY DT SA; LDA AREG,B; JPL I (RBLOC; JMP *-1; STZ I XREG,B
L2,    LDA CNT,B; SAD SHR 1; ADD (BTEMP+3; COPY DX SA; LDA 0,X
       BSKP ONE 170 DD; SHA ZIN SHR 10; AND (377; JAZ L2C
       MIN I XREG,B; LDX I XREG,B; STA I XREG,B,X
L2C,   MIN CNT,B; LDA CNT,B; AAA -6; JAN L2
       STZ I (BTEMP-4; MIN LREG,B; JMP LFF+1
LFF,   STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
   LF4,   SAA 4; JMP LFF
LF12,  SAA 14; JMP LFF
       )FILL
       )PCL FLSFR


%TRTRK
%TRANSFER TRACKS FROM ONE USER TO ANOTHER USER
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV17,T1,TRTRK
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV17; T1; SAVX
)KILL BLUES
BLUES=*
GLOB/
TRTRK=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA PTR,1
PTR=ZYX
   )KILL ZYX
ZYX=PTR+1;
   
       DATA XTR,5
XTR=ZYX
   )KILL ZYX
ZYX=XTR+5;
   
       DATA XTRX,20
XTRX=ZYX
   )KILL ZYX
ZYX=XTRX+20;
   
       DATA US1,1
US1=ZYX
   )KILL ZYX
ZYX=US1+1;
   
       DATA US2,1
US2=ZYX
   )KILL ZYX
ZYX=US2+1;
   
       DATA CNT,1
CNT=ZYX
   )KILL ZYX
ZYX=CNT+1;
   

T1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; STSET PTR,XTR,STRX,40
       SAX XTR; RADD DX SB; STX PTR,B; SAT STRX;
       RADD DT SB; SAA 40; SAD SHR 20; JPL I (SETUP
       
       LDT I (CMDLN; LDX PTR,B; SAA 41; JPL I (PCF; JMP TSS
       LDX PTR,B; JPL I (GUNUM; JMP TF4; STA US1,B
       LDX PTR,B; JPL I (STRST
       JPL I (WHUSR; STA US2,B; AAA -1; JAF T5
       LDX PTR,B; LDT I (CMDLN; SAA 42; JPL I (PCF; JMP TSS
       LDX PTR,B; JPL I (GUNUM; JMP TF4; STA US2,B
T5,    LDT I (CMDLN; SAA 43; JPL I (PCF; JMP TSS; STA CNT,B
       JPL I (WHUSR; AAA -1; JAZ T2
       LDA CNT,B; JAN TFF; JMP T3
T2,    LDA US1,B; SUB US2,B; JAZ T4
T3,    LDT US2,B; LDA CNT,B; JPL I (UTRK; JMP TFX
T4,    LDT US1,B; LDA CNT,B; COPY CM2 DA SA; JPL I (UTRK; JMP TFX
TSS,   MIN LREG,B; RET

   RCLR DP AD1
   TFX,   JPL I (ERMSG; JMP TSS
TFF,   RET

   RCLR DP AD1
   TF4,   SAA 4; JMP TFX
       )FILL
       )PCL TRTRK


%LTRKS
%LIST NUMBER OF TRACKS LEFT
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV17,L1,LTRKS
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV17; L1; SAVX
)KILL BLUES
BLUES=*
GLOB/
LTRKS=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA PTR,1
PTR=ZYX
   )KILL ZYX
ZYX=PTR+1;
   
       DATA XTR,5
XTR=ZYX
   )KILL ZYX
ZYX=XTR+5;
   
       DATA XTRX,20
XTRX=ZYX
   )KILL ZYX
ZYX=XTRX+20;
   

L1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; STSET PTR,XTR,STRX,40
       SAX XTR; RADD DX SB; STX PTR,B; SAT STRX;
       RADD DT SB; SAA 40; SAD SHR 20; JPL I (SETUP
       
       LDT I (CMDLN; LDX PTR,B; SAA 16; JPL I (PCF; JMP XSS
       JPL I (LEN; SKP IF DD EQL 0; JMP L2; JPL I (WHUSR; JMP L2+3
L2,    LDX PTR,B; JPL I (GUNUM; JMP LF4; COPY DT SA
       SAA 0; JPL I (UTRK; JMP LFX
       SAT 12; JPL I (IOUT; SAA 60; JMP LFX
XSS,   MIN LREG,B; RET

   RCLR DP AD1
   LFX,   JPL I (ERMSG; JMP XSS
LF4,   SAA 4; JMP LFX
       )FILL
       )PCL LTRKS


       OVERX QOV17
QOV17=*-ROVER
)9MOVE ROVER VOR VORS
GLOB=VOR
)KILL VOR
VOR=GLOB+VORS
)KILL GLOB
OVLAY/ RQR-1
OVLAX/ RQR-1
SYSOV/ RQR-1
)WRTM
)WRITE QOV17
 
