GLOB/
LOADV=BLOB
)KILL BLOB
)KILL GLOB
   

L1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX
"CDC
       JPL I (WHUSR; AAA -1; JAF LFF
       IOF
"CDC
       SAA -1; MCL PIE; INTEN; INTDS
L2,    SAX 0; SAT 0; SAA 1; JPL I (SDISK
       IOF; RCLR DP
"
XSS,   MIN LREG,B; RET

   RCLR DP AD1
   LFF,   SAA 56; JPL I (ERMSG; JMP XSS
       )FILL
       )PCL LOADV



