%OPENF
%OPEN FILE
%A = DEVICE ID
%X = POINTER TO FILE ID (AS IN SFILA)
%T = READ-ONLY FLAG (NEG. IF READ-ONLY)
%RETURN A
%A = FILE NUMBER
%FAILURE RETURN A
%A = 4 IF NO SUCH USER
%A = 8 IF NO SUCH FILE
%A = 10 IF NO MORE SPACE IN OBT
%A = 11 IF NO MORE OFT ENTRIES
%A = 12 IF NO ACCESS
%A = 13 IF FILE ALREADY OPEN FOR WRITE

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV13,O1,FOPEN
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV13; O1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FOPEN=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA OBJ,1
OBJ=ZYX
   )KILL ZYX
ZYX=OBJ+1;
   
       DATA OFTN,1
OFTN=ZYX
   )KILL ZYX
ZYX=OFTN+1;
   
       DATA DISP,1
DISP=ZYX
   )KILL ZYX
ZYX=DISP+1;
   
O1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK
       LDA AREG,B; JPL I (KDEV; JPL I (DVERR
       JPL I (GOFT; JMP I (OF11; STA OFTN,B
       LDA AREG,B; LDX XREG,B; JPL I (SOBT; JMP *+2; JMP O2
       AAA 1; JAF *+2; JMP I (OF10; AAA -1
       STA OBJ,B; LDX (OFT; SUB (OBT; STA I OFTN,B,X
       LDA AREG,B; LDX XREG,B; JPL I (SUIB; JMP I (OF4
       STA DISP,B; LDA AREG,B; JPL I (RBLOC; JMP *-1
       LDA (BTEMP; ADD DISP,B; COPY DX SA; LDA (100000
       STA 0,X; LDT OBJ,B; SAA 40; JPL I (BCOPY
       STZ I (BTEMP-4; SAX 20; LDA AREG,B; STA I OBJ,B,X; JMP O3
       )FILL
O2,    STA OBJ,B; LDX (OFT; SUB (OBT; STA I OFTN,B,X
O3,    LDA AREG,B; COPY DD SA; LDT I XREG,B
       SAX 17; LDA I OBJ,B,X; AND (777
       LDX TREG,B; JXN *+3; SAX 3; JMP *+2
       SAX 1; JPL I (CKACC; JMP OF12
       LDX (OFT; LDT I OFTN,B,X; LDA TREG,B
       JAP *+3; BSET ONE 160 DT; STT I OFTN,B,X
       JAN *+6; LDA I OBJ,B; BSKP ZRO 160 DA; JMP OF13
       BSET ONE 160 DA; STA I OBJ,B; MIN I OBJ,B
       LDX (OFT; LDA I OFTN,B,X; BSET ONE 170 DA; STA I OFTN,B,X
       SAX 25; MIN I OBJ,B,X; JMP *+1; LDA I OBJ,B
       AND (37777; AAA -1; JAF O4
       SAX 21; LDT I OBJ,B,X; LDA AREG,B; JPL I (RBLOC; JMP *-1
       LDT OBJ,B; AAT 40; LDX (BTEMP; SAA 40; JPL I (BCOPY
       STZ I (BTEMP-4; SAX 37; STZ I OBJ,B,X
O4,    LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
       LDA OFTN,B; AAA 10; STA AREG,B; MIN LREG,B; JMP OFF+1
OF4,   JAP OF8; SAA 4; STZ I OBJ,B; JMP OFF
OF8,   SAA 10; JMP OF4+2
OF10,  SAA 12; JMP OFF
OF11,  SAA 13; JMP OFF
OF12,  SAA 14; JMP OFF1
OF13,  SAA 15; JMP OFF1
OFF,   STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
   OFF1,  LDT I OBJ,B; BSET ZRO 170 DT; STT I OBJ,B; JMP OFF
       )FILL
       )PCL FOPEN


%CLOSE
%CLOSE FILE
%T = FILE NUMBER
%RETURN
%FAILURE RETURN A
%A = 14 IF BAD FILE NUMBER

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV13,C1,FCLOS
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV13; C1; SAVX
)KILL BLUES
BLUES=*
GLOB/
FCLOS=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA OFTN,1
OFTN=ZYX
   )KILL ZYX
ZYX=OFTN+1;
   
       DATA OBJ,1
OBJ=ZYX
   )KILL ZYX
ZYX=OBJ+1;
   
       DATA DKAD,1
DKAD=ZYX
   )KILL ZYX
ZYX=DKAD+1;
   
C1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (LOCK; AAT -10; SKP IF DT GRE 0; JMP CFF
       SAA NOFT; SKP IF DT LST SA; JMP CFF; STT OFTN,B
       LDX (OFT; LDA I OFTN,B,X; JAP CFF; COPY DD SA
       JPL I (OFTX; STA OBJ,B; ENINT; DSINT
       LDA I OBJ,B; JAN *-3; BSET ONE 170 DA
       STA I OBJ,B; ENINT; BSKP ONE 160 DD; BSET ZRO 160 DA
       AAA -1; STA I OBJ,B; AND (37777; JAF C2
       SAX 32; LDA I OBJ,B,X; SAD ZIN SHR 10
       COPY DT SA; SAX 20; LDA I OBJ,B,X
       JPL I (UNDK; JPL I (FTLER; STA DKAD,B
       SAA 0; SAD 5; AAA 1; ADD DKAD,B; COPY DT SA
       SAX 20; LDA I OBJ,B,X; JPL I (RBLOC; JMP *-1
       LDX OBJ,B; LDT (BTEMP; SAA 0
       SAD 3; SHA 5; RADD DT SA
       SAA 40; JPL I (BCOPY; JPL I (WBLOK; STZ I OBJ,B
C2,    LDA I OBJ,B; BSET ZRO 170 DA; STA I OBJ,B
       LDX (OFT; STZ I OFTN,B,X; MIN LREG,B; JMP CFF+2
CFF,   SAA 16; STA AREG,B; JPL I (UNLOK; RET

   RCLR DP AD1
          )FILL
       )PCL FCLOS


%BAKUP
%BACKUP PROGRAM FOR DISK PACKS
%RETURN

       PROGM

   )KILL ZYX
ZYX=1
   
       GOVER OV13,B1,BAKUP
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; OV13; B1; SAVX
)KILL BLUES
BLUES=*
GLOB/
BAKUP=BLOB
)KILL BLOB
)KILL GLOB
   
       DATA DKA,1
DKA=ZYX
   )KILL ZYX
ZYX=DKA+1;
   
       DATA DKL,1
DKL=ZYX
   )KILL ZYX
ZYX=DKL+1;
   

B1,    ENTER

   STA I *+3; SAA 2; SWAP DP SA; SAVA; ZYX-1
          COPY DB SX; JPL I (WHUSR; AAA -1; JAF BF46
"NN10
       JPL I (RESET; LDX (40000; LDT (43777; JPL I (CKMEM; JMP BSSS
       SAA 73; MCL PIE; STZ DKA,B
B2,    LDX (40000; LDT DKA,B; SAA 1; JPL TSF; JPL BFX
       LDX (40000; LDT DKA,B; RADD DT SX
       SAA 3; JPL TSF; JPL BFX
B2C,   LDA DKA,B; AAA 10; STA DKA,B; SUB (40000; JAN B2
B3,    SAA 57; MST PIE; JMP BSSS
BFX,   COPY DT SL; STT DKL,B
       LDX (MS1; JPL I (MSG; SAT 10; JPL I (IOUT
       LDX (MS2; JPL I (MSG; LDA DKA,B; JPL I (IOUT
       JPL I (CRLF; JMP I DKL,B
MS1,   'DISK ERROR \ '
MS2,   ' AT \ '
"
BF46,  SAA 56; JPL I (ERMSG
BSSS,  MIN LREG,B; RET

   RCLR DP AD1
   "NN10
TSF,   STA TRSA; STT TRST; STX TRSX; COPY DA SB; STA TRSB
TR00,  COPY DA SL; STA TRSL
       LDX I (PRT; LDA 4,X; BSKP ZRO 160 DA; JMP B3
       SAT 10; COPY CM2 DX ST
TR1,   COPY DA ST; RADD DA SX; MPY (400; ADD TRSX
       STA TRCOR; LDA (DKTBL; COPY DB SA; LDA TRST
       ADD 0,B,X; STA TRDK; JPL I (DWAIT; JMP TR00+2; IOT RST
       AND (130160; BSET BCM 170 DA; JAF TR2
       LDA TRCOR; IOT LCA
       LDA TRDK; IOT LBA
       LDA TRSA; IOT ACT DISC
       JNC TR1; MIN TRSL; JMP TSFS
TR2,   STA TRSA; SAA 10; IOT ACT DISC
       LDA (CORL2-1; IOT LBA; SAA 0; IOT LCA
       SAA 3; IOT ACT DISC
TSFS,  LDA TRSB; COPY DB SA; LDA TRSA; JMP I TRSL
TRSB,  0
TRSA,  0
TRST,  0
TRSX,  0
TRCOR, 0
TRDK,  0
TRSL,  0
       0; 3; 6; 1; 4; 7; 2; 5
DKTBL, 0
"
       )FILL
       )PCL BAKUP


       OVERX QOV13
QOV13=*-ROVER
)9MOVE ROVER VOR VORS
GLOB=VOR
)KILL VOR
VOR=GLOB+VORS
)KILL GLOB
OVLAY/ RQR-1
