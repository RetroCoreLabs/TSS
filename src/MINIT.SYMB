%MASS STORAGE INITIALIZATION PROGRAM
IOT=160000;ACT=400;SKA=1000;PIN=2000;SNI=0;     % Added by CVS


%
%MAY BE USED FOR CDC DISK AND EITHER NORD-1 OR NORD-10

CDC


NN10
"N10
)KILL NN10
"
*-1/



%TCI
%INPUT CHARACTER FROM TTY
%RETURN A
%A = CHARACTER

TCI,   COPY DA SL; STA TCL; STT TCT
       SAT 1; JPL I (INBT; JAN TCF; BSET ZRO 70 DA
       LDT TCT; JMP I TCL
TCL,   0
TCT,   0
       )FILL
       )PCL TCI



%TCO
%OUTPUT CHARACTER TO TTY
%A = CHARACTER
%RETURN

TCO,   SWAP DA SL; STA TCL; SWAP DA SL; STT TCT
       SAT 1; JPL I (OUTBT; JAN TCF
       LDT TCT; JMP I TCL
TCL,   0
TCT,   0
       )FILL
       )PCL TCO



%CRLF
%OUTPUT CR AND LF TO TTY
%RETURN

CRLF,  STA CRLA; COPY DA SL; STA CRLL
       SAA 15; JPL TCO; SAA 12; JPL TCO
       LDA CRLA; JMP I CRLL
CRLA,  0
CRLL,  0
       )FILL
       )PCL CRLF


%TCF
%I/O ERROR

TCF,   STA TCFA; LDX (TCFS; JPL MSG
       LDA TCFA; JPL I (OCTOT; JPL CRLF
       WAIT; JMP MINIT
TCFA,  0
TCFS,  '$I/O ERROR \ '
       )FILL
       )PCL TCF



%MSG
%OUTPUT MESSAGE TO TTY
%RETURN

MSG,   STA MSGA; STX MSGX
       COPY DA SL; STA MSGL; STZ CNT
MSGLP, LDA CNT; MIN CNT; BSKP ZRO DA; JMP MSG1
       LDA 0,X; SHA ZIN SHR 10; JMP MSG2
MSG1,  LDA 0,X; AAX 1; AND (377
MSG2,  AAA -##\; JAZ MSGS
       AAA ##\-##$; JAZ MSCR
       AAA ##$; JPL TCO; JMP MSGLP
MSCR,  JPL CRLF; JMP MSGLP
MSGS,  LDX MSGX; LDA MSGA; JMP I MSGL
MSGA,  0
MSGX,  0
MSGL,  0
CNT,   0
       )FILL
       )PCL MSG



%OCTIN
%INPUT OCTAL NUMBER
%RETURN A
%A = NUMBER

OCTIN, COPY DA SL; STA OCTL; STT OCTT; SAT 0
OCTLP, JPL TCI; AAA -##0; JAN OCTS
       AAA -10; JAP OCTS; AAA 10
       SHT 3; RADD DT SA; JMP OCTLP
OCTS,  COPY DA ST; LDT OCTT; JMP I OCTL
OCTL,  0
OCTT,  0
       )FILL
       )PCL OCTIN



%OCTOT
%OUTPUT OCTAL NUMBER
%A = NUMBER
%RETURN

OCTOT, STA OCTA; STX OCTX; STT OCTT
       COPY DA SL; STA OCTL
       LDT OCTA; SHT ROT 1
       COPY DA ST; AND (1; AAA ##0; JPL TCO; SAX -5
OCTLP, SHT ROT 3; COPY DA ST; AND (7
       AAA ##0; JPL TCO; JNC OCTLP
       LDA OCTA; LDX OCTX; LDT OCTT; JMP I OCTL
OCTA,  0
OCTX,  0
OCTT,  0
OCTL,  0
       )FILL
       )PCL OCTOT
&L
%MINIT
%INITIALIZE OR UPDATE CDC DISK

MINIT, JPL I (IOINI
       LDX (MS1; JPL I (MSG
       JPL I (OCTIN; AND (77770; STA ADR1; STA ADRI
       LDX (MS2; JPL I (MSG
       JPL I (OCTIN; AND (77770; STA ADRN
       SUB ADR1; JAP *+2; JMP I (ER1; STZ CNT; LDX (MIB
M1,    STZ I CNT,X; MIN CNT
       LDA CNT; SUB (4000; JAN M1
M1A,   LDX (MS3; JPL I (MSG; JPL I (TCI
       AAA -##I; JAF M2; LDX (MS4; JPL I (MSG; JMP MIT
M2,    AAA ##I-##U; JAF M2A; LDX (MS5; JPL I (MSG; JMP I (MUP
M2A,   AAA ##U-##R; JAF M1A; LDX (MS5A; JPL I (MSG; JMP I (REG
MIT,   STZ CNT; LDX (BUFF
M3,    LDA CNT; STZ I CNT,X; AAA 1; STA CNT
       SUB (4000; JAN M3
       LDX (BUFF; LDT ADRI; SAA 7; COPY DD SA
       SAA 1; JPL I (DKTR; JMP MF1
       SAA 0; JPL I (DKTR; JMP MF1
       STZ CNT; LDX (BUFF; JMP M4
       )FILL
TEMP,  0
ADRI,  0
ADR1,  0
ADRN,  0
MIBX,  0
CNT,   0
M4,    LDA I CNT,X; JAF MF2
       MIN CNT; LDA CNT; SUB (4000; JAN M4
       LDA ADRI; SAD SHR 7; ADD (MIB; STA MIBX
       SAA 0; SAD 4; ADD (MASKS; COPY DX SA
       LDA 0,X; ORA I MIBX; STA I MIBX
M5,    LDA ADRI; AAA 10; STA ADRI
       SUB ADRN; JAN MIT
       LDX (MIB; SAT 50; SAA 7; COPY DD SA
       SAA 1; JPL I (DKTR; JMP MF3
MSS,   LDX (MS6; JPL I (MSG; JMP MINIT
MF1,   STA TEMP; LDX (ERM2; JPL I (MSG
       LDA TEMP; JPL I (OCTOT
       LDX (ERM3; JPL I (MSG; LDA ADRI; JPL I (OCTOT
       LDX (ERM4; JPL I (MSG; LDA ADRI
       JPL I (DKADR; SAA -1; JPL I (OCTOT
       LDX (ERM5; JPL I (MSG; JMP M5
MF2,   LDX (ERM6; JPL I (MSG; LDX (ERM3; JPL I (MSG
       LDA ADRI; JPL I (OCTOT; LDX (ERM4; JPL I (MSG
       LDA ADRI; JPL I (DKADR; SAA -1; JPL I (OCTOT
       LDX (ERM5; JPL I (MSG; JMP M5
MF3,   LDX (ERM7; JPL I (MSG; JMP I (MINIT
MUP,   LDX (ERM8; JPL I (MSG; JMP I (MINIT
       )FILL


ER1,   LDX (ERM1; JPL I (MSG; JMP I (MINIT
       )FILL


REG,   LDA I (ADR1; STA I (ADRI
REG1,  LDA I (ADRI; JPL I (DKADR; JMP REG1A
       LDT I (ADRI; SAA 1; JPL I (SBIT
REG1A, LDA I (ADRI; AAA 10; STA I (ADRI
       SUB I (ADRN; JAN REG1; STZ USN
REG2,  LDA USN; SHA ZIN SHR 5; AAA 51; COPY DT SA
       LDX (BUFF; SAA 0; RCLR DD; JPL I (DKOP; JMP REG2
       LDA USN; AND (37; SHA 3; ADD (BUFF; COPY DX SA
       LDA 0,X; JAZ REG2C; LDA 7,X; STA UIB; STZ FIL
       LDT UIB; SAA 0; JPL I (SBIT
REG3,  LDA FIL; SHA ZIN SHR 3; ADD UIB; COPY DT SA AD1
       LDX (BUFF; SAA 0; RCLR DD; JPL I (DKOP; JMP REG3
       LDA FIL; AND (7; SHA 5; ADD (BUFF; COPY DX SA
       LDA 1,X; JAZ REG3C; LDA 21,X; STA IX; STZ TRK
REG4,  LDT IX; SAA 0; JPL I (SBIT
       LDT IX; SAA 7; COPY DD SA; SAA 0
       LDX (BUFF; JPL I (DKTR; JMP REG4
REG5,  LDX (BUFF; LDT I TRK,X; SAA 0; JPL I (SBIT
       MIN TRK; LDA TRK; SUB (4000; JAN REG5
REG3C, MIN FIL; LDA FIL; AAA -70;; JAN REG3
REG2C, MIN USN; LDA USN; SUB (340; JAN REG2
REG6,  LDX (MIB; SAT 50; SAA 1; RCLR DD; JPL I (DKOP; JMP REG6
       JMP I (MSS
USN,   0
UIB,   0
FIL,   0
TRK,   0
IX,    0
       )FILL
       )PCL MINIT


MASKS, 1; 2; 4; 10; 20; 40; 100; 200
       400; 1000; 2000; 4000; 10000; 20000; 40000; 100000


MS1,   '$MASS STORAGE INIT$$FIRST DISK ADDRESS (NCR): \ '
MS2,   '$LAST DISK ADDRESS (NCR): \ '
MS3,   '$INITIALIZE OR UPDATE OR REGENERATE (I OR U OR R): \ '
MS4,   'NITIALIZE$\ '
MS5,   'PDATE$\ '
MS5A,  'EGENERATE$\ '
MS6,   '$FINISHED$\ '

ERM1,  '$ILLEGAL ADDRESSES$\ '
ERM2,  '$DISK ERROR \ '
ERM3,  ' AT NCR(\ '
ERM4,  ') CDC(\ '
ERM5,  ')\ '
ERM6,  '$TRANSFER ERROR\ '
ERM7,  '$UNABLE TO WRITE MIB$\ '
ERM8,  '$NOT IMPLEMENTED$\ '


%SBIT
%SET/RESET BIT IN BIT TABLE
%T = DISK ADDRESS
%A = 0 OR 1
%RETURN

SBIT,  STF SBTAD; STX SBX
       SHT ZIN SHR 3; COPY DA ST
       SAD ZIN SHR 4; ADD (MIB; STA MIBX
       SAA 0; SAD 4; ADD (MASKS; COPY DX SA
       LDA SBTAD+1; JAZ SB1
       LDA 0,X; ORA I MIBX; JMP SB2
SB1,   LDA 0,X; COPY CM1 DA SA; AND I MIBX
SB2,   STA I MIBX; LDF SBTAD; LDX SBX
       EXIT
SBTAD, 0; 0; 0
SBX,   0
MIBX,  0
       )FILL
       )PCL SBIT
&L
DCHN
"DCHN NN10
DCHN=100
"DCHN N10
DCHN=500
"
*-1/

"N10
INTEN=124001
INTDS=124001
"

"CDC NN10

%DISK DEVICE NUMBERS

DISC=DCHN+44
DCT=DCHN+45
LCA=DCT+SNI
LBA=DCT+ACT
LMR=DCT+SKA
RST=DCT+PIN
RCA=DCT+PIN+ACT
RSECT=DCT+PIN+SKA
RDC=DCT+PIN+SKA+ACT
SEEK=DCT+SKA+ACT

"CDC N10
LCA=DCHN+1
LBA=DCHN+3
LMR=DCHN+5
RST=DCHN+4
RCA=DCHN+0
RSECT=DCHN+2
SEEK=DCHN+6
LWC=DCHN+7
"


%DWAIT
%DISK READY TEST
%RETURN IF READY
%FRETURN IF TIMEOUT

DWAIT, STZ DWX
"NN10
DW1,   IOT SKA DISC; JMP *+2; EXIT AD1
"N10
DW1,   IOX RST; BSKP ONE 20 DA; EXIT AD1
"
       MIN DWX; JMP DW1
"CDC NN10
       IOT RDC
"CDC N10
       SAA 20; IOX LMR
"
       EXIT
DWX,   0
       )FILL
       )PCL DWAIT



"CDC

%DKOP
%PERFORM A 256 WORD DISK OPERATION
%X = CORE ADDRESS
%T = NCR DISK ADDRESS
%A = OPERATION
%    0: READ TRANSFER
%    1: WRITE TRANSFER
%    2: PARITY TEST
%    3: COMPARE TEST
%D = UNIT NUMBER (0 TO 3)
%RETURN
%DESTROYS T REGISTER
%FAILURE RETURN A IF ANY ERROR
%A = DISK STATUS REGISTER OR -1 IF ILLEGAL DISK ADDRESS

DKOP,  STF DKSVT; COPY DA SL; STA DKSVL
       COPY DA SD; SHA 6; ADD DKSVA; RCLR DD
       JPL DKTR; JMP DKF
       MIN DKSVL; JMP DKF+1
DKF,   STA DKSVA; LDF DKSVT; JMP I DKSVL

DKSVT, 0
DKSVA, 0
DKSVD, 0
DKSVL, 0

       )FILL
       )PCL DKOP



%DKTR
%DISK TRANSFER ROUTINE
%X = CORE ADDRESS
%T = NCR DISK ADDRESS
%A[1,0] = OPERATION
%         0: READ TRANSFER
%         1: WRITE TRANSFER
%         2: PARITY TEST
%         3: COMPARE TEST
%A[7,6] = UNIT NUMBER
%D = EXTRA 256 WORD BLOCKS (UP TO 3K WORDS)
%RETURN
%FAILURE RETURN A IF ANY ERROR
%A = DISK STATUS REGISTER OR -1 IF ILLEGAL ADDRESS

DKTR,  STF DKSVT; COPY DA SL; STA DKSVL

%WAIT FOR READY CONDITION

       JPL I (DWAIT; JMP *1
"CDC NN10
       IOT RST; JMP *+1; BSKP ONE 160 DA; JMP *-3
"CDC N10
       IOX RST; JMP *+1; BSKP ONE 160 DA; JMP *-3
"CDC

%LOAD DISK REGISTERS

"CDC NN10
       COPY DA SX; IOT LCA
"CDC N10
       COPY DA SX; IOX LCA
"CDC
       COPY DA ST; JPL I (DKADR; JMP DKF1
"CDC NN10
       STA DKTRC; IOT LBA
"CDC N10
       STA DKTRC; IOX LBA
"CDC

%COMPUTE EXTRA BLOCKS

       LDA DKSVD; AAA 1; SHA 1; COPY DD SA
       LDA DKTRC; AND (37; RADD DA SD; AAA -30
       JAN *+3; JAZ *+2; JMP *+2; SAA 0; STA SZ2
       COPY CM2 DA SA; RADD DA SD

%LOAD MODUS REGISTER

"CDC NN10
       AAA -1; SHA 10; ADD DKSVA; IOT LMR
"CDC N10
       SHA 7; IOX LWC; STA DKSWC
       LDA DKSVA; SHA 13; AAA 4; IOX LMR
"CDC

%START TRANSFER

"CDC NN10
       IOT ACT DISC
"CDC

%WAIT FOR COMPLETION

       JPL I (DWAIT; JMP DKF2

%CHECK DISK STATUS

"CDC NN10
       IOT RST; JMP DKF2; BSKP ONE 160 DA; JMP *-3
"CDC N10
       IOX RST; JMP *+1; BSKP ZRO 40 DA; JMP DKF2
       BSKP ONE 160 DA; JMP *-5
"CDC

%TRANSFER NEXT PART IF NECESSARY

       LDA SZ2; JAZ DKSS

%MODIFY CORE ADDRESS IF WRITE TRANSFER
%THIS IS DANGEROUS IF A HIGHER INTERRUPT LEVEL USES THE DISK

"CDC NN10
       LDA DKSVA; BSKP ONE DA; JMP *+5
       INTDS; IOT RCA; AAA -1; IOT LCA
"CDC N10
       LDA DKSWC; RADD DA SX; IOX LCA
"CDC

%LOAD NEW BLOCK ADDRESS

       LDA DKTRC; AND (177740; AAA 40
"CDC NN10
       IOT LBA
"CDC N10
       IOX LBA
"CDC

%LOAD MODUS REGISTER

"CDC NN10
       LDA SZ2; AAA -1; SHA 10; ADD DKSVA; IOT LMR
"CDC N10
       LDA SZ2; SHA 7; IOX LWC
       LDA DKSVA; SHA 13; AAA 4; IOX LMR
"CDC

%START TRANSFER

"CDC NN10
       IOT ACT DISC; INTEN
"CDC N10
       INTEN
"CDC

%WAIT FOR COMPLETION

       JPL I (DWAIT; JMP DKF2

%CHECK DISK STATUS

"CDC NN10
       IOT RST; JMP DKF2
"CDC N10
       IOX RST; JMP *+1; BSKP ZRO 40 DA; JMP DKF2
"CDC

%SUCCESS RETURN

DKSS,  MIN DKSVL
"CDC NN10
       JMP DKF2+2
"CDC N10
       JMP DKF2+3
"CDC

%ERROR RETURNS

DKF1,  INTEN; SAA -1
DKF2,  STA DKSVA
"CDC NN10
       IOT RDC; LDF DKSVT; JMP I DKSVL
"CDC N10
       SAA 20; IOX LMR; LDF DKSVT; JMP I DKSVL
"CDC

DKSWC, 0
DKSVT, 0
DKSVA, 0
DKSVD, 0
DKSVL, 0
DKTRC, 0
SZ2,   0

       )FILL
       )PCL DKTR
"




"CDC
%DKADR
%CONVERT NCR DISK ADDRESS TO CDC DISK ADDRESS
%A = NCR DISK ADDRESS
%RETURN A
%A = CDC DISK ADDRESS
%T AND D REGISTERS ARE DESTROYED
%FAILURE RETURN IF ILLEGAL DISK ADDRESS

DKLIM=626    %NUMBER OF CYLINDERS (313 FOR CDC 9425
             %AND 626 FOR CDC 9427).

DKADR, RCLR DT; BLDA 150 DA; BSTA 170 DT; BLDA 160 DA

%SAVE AWAY THE SIGNIFICANT PART OF THE NCR ADDRESS

       AND (17777; COPY DD SA

%DIVIDE BY 12 (DEC) GIVING FIELD [14,5] OF CDC ADDRESS

"CDC NN10
       COPY CM2 DA SA; MPY 952
       BSKP ONE 160 DA; JMP *+3; ADD (125252; JMP *+3
       BSKP ZRO 170 DA; ADD 952; SHA ZIN SHR 2
"CDC N10
       STF DKTT; SAD ZIN SHR 20; SAT 14
       RDIV ST; COPY DT SA; LDD DKTA
       COPY DA ST; LDT DKTT
"CDC

%INCORPORATE THIS INTO CDC ADDRESS IN T REGISTER

       SHT ZIN SHR 5; RORA DT SA; SHT 5

%INCORPORATE SECTOR COUNT INTO CDC ADDRESS

       MPY (14; RSUB DD SA; RADD DD SD; RADD DT SD

%ADD DISPLACEMENT FOR UNIT

       COPY DD ST; LDA (52600; BSKP ZRO SSK; RADD DT SA

%CHECK FOR LEGAL CDC ADDRESS

       REXO DD ST; BSKP ZRO 170 DD; JMP DKADF
       COPY DA ST; BSET ZRO 170 DA; SHA SHR 6
       SUB (DKLIM; JAP DKADF

%RETURN CDC DISK ADDRESS

       COPY DA ST; EXIT AD1

%ILLEGAL CDC ADDRESS

DKADF, EXIT

DKTT,  0
DKTA,  0
DKTD,  0
       )FILL
952,   52525
       )PCL DKADR
       )KILL DKLIM
"
&L
"N10

%STANDARD INPUT/OUTPUT FOR NORD-10
%
%*=*=*=*=*=*=*=*=*=*=*=*=*=*=* IOXLIB *=*=*=*=*=*=*=*=*=*=*=*=*
%
%ORIGINATOR:  NJL 28/5/73

%CALL: T = FILE-NUMBER
%     (A = DATA)
%
%RETURN: A<0 IF ERROR  A[0-14]=STATUS-WORD OF DEVICE
%
%*N*O*T*E*:  FILE 1 AND 7 ECHOS THE INPUT

INBT,  SAA   7
       RAND  ST DA
       SKP   IF DA EQL ST
       JMP   L356            %WRONG FILE
       RADD  SA DP
       JMP   L356
       JMP   L1
       JMP   L2
       JMP   L356
       JMP   L4
       JMP   L356
       JMP   L356
       JMP   L7


L1,    IOX   302
       BSKP  ZRO 30 DA
       JMP   L11
       SAA   4
       IOX   303

L11,   IOX   302
       BSKP  ZRO 40 DA
       JMP   IERR1
       BSKP  ONE 30 DA
       JMP   L11
       IOX   300
       STA   ASAV
       SAA   4
       IOX   303
       LDA   ASAV
       JMP   OUTBT           %ECHO


L2,    IOX   402             %TAPE READER
       BSKP  ONE 30 DA
       JMP   L2
       IOX   400
       STA   ASAV
       SAA   4
       IOX   403
       LDA   ASAV
       EXIT

L356,  SAA   -1
       EXIT

L4,    JMP   *1              %CARD-READER
       JMP   *1
       JMP   L356


L7,    IOX   312
       BSKP  ZRO 30 DA
       JMP   L71
       SAA   4
       IOX   313

L71,   IOX   312
       BSKP  ZRO 40 DA
       JMP   IERR7
       BSKP  ONE 30 DA
       JMP   L71
       IOX   310
       STA   ASAV
       SAA   4
       IOX   313
       LDA   ASAV
       JMP   OUTBT           %ECHO

IERR1, STA   ASAV
       SAA   20
       IOX   303
       JMP   IERR

IERR7, STA   ASAV
       SAA   20
       IOX   313

IERR,  LDA   ASAV
       BSET  ONE 170 DA
       EXIT

ASAV,  0

)KILL  L1 L11 L2 L356 L4 L7 L71 IERR1 IERR7 IERR ASAV
                             %FF

OUTBT, BSET  ZRO 170 DA
       STA   ASAV
       SAA   7
       RAND  ST DA
       SKP   IF DA EQL ST
       JMP   L246
       RADD  SA DP
       JMP   L0
       JMP   L1
       JMP   L246
       JMP   L3
       JMP   L246
       JMP   L5
       JMP   L246
       JMP   L7

L0,    LDA   ASAV
       EXIT

L1,    IOX   306             %TELETYPE 1
       BSKP  ZRO 40 DA
       JMP   OERR1
       BSKP  ONE 30 DA
       JMP   L1
       LDA   ASAV
       IOX   305
       EXIT

L246,  SAA   -1
       EXIT

L3,    IOX   412             %TAPE PUNCH
       BSKP  ONE 30 DA
       JMP   L3
       LDA   ASAV
       IOX   411
       SAA   4
       IOX   413
       JMP   L0


L5,    IOX   432             %LINE PRINTER
       BSKP  ZRO 40 DA
       JMP   OERR5
       BSKP  ONE 30 DA
       JMP   L5
       LDA   ASAV
       IOX   431
       SAA   4
       IOX   433
       JMP   L0

L7,    IOX   316             %TELETYPE 2
       BSKP  ZRO 40 DA
       JMP   OERR7
       BSKP  ONE 30 DA
       JMP   L1
       LDA   ASAV
       IOX   315
       EXIT

OERR1, STA   ASAV
       SAA   20
       IOX   307
       JMP   OERR

OERR5, STA   ASAV
       SAA   20
       IOX   433
       JMP   OERR

OERR7, STA   ASAV
       SAA   20
       IOX   317

OERR,  LDA   ASAV
       BSET ONE 170 DA
       EXIT

ASAV,  0

)KILL  L0 L1 L246 L3 L5 L7 OERR1 OERR5 OERR7 OERR ASAV
                             %FF

%IOINI
%
%IT IS STRONGLY ADVICED TO INITIALIZE IO-DEVICES WITH A
%CALL TO THIS ROUTINE.
%

IOINI, SAA   20
       IOX   303             %TTY 1
       IOX   313             %TTY 2
       IOX   403             %RDR
       IOX   413             %PNC
       IOX   433             %LPR
       IOX   LMR             %DISK
       SAA   4
       IOX   303
       IOX   313
       IOX   403
       EXIT

                             %FF

"NN10

% NORD-1 I/O

INBT,  IOT ACT SKA RKE; JMP *-1
OUTBT, IOT ACT SKA PNT; JMP *-1
IOINI, EXIT
"

&L
MIB=*
BUFF=MIB+4000
)LINE