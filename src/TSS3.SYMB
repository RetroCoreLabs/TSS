%OVERLAY AREA

ROVER, BSS 1000
ROV4=ROVER+400
VOR=40000
VORS=1000


%GOVER
%GET OVERLAY  (MACRO)
%ARG1: OVERLAY NUMBER
%ARG2: LOCATION TO TRANSFER TO
%ARG3: NAME OF ROUTINE

)MCDEF GOVER $A1,$A2,$A3
GLOB=*
BLUES/
BLOB=*
   STX I *+5; SAX 0; SWAP DP SX; $A1 ; $A2 ; SAVX
)KILL BLUES
BLUES=*
GLOB/
$A3 =BLOB
)KILL BLOB
)KILL GLOB
   ]


%SOVER
%WRITE OVERLAY ONTO DISK
%THE OVERLAY NUMBER IS TAKEN TO BE RQR-1
%RETURNS TO MAC VIA JMP 103,B
%STOPS IN A WAIT 47 IF OVERLAY IS TOO LARGE

"NMACF
30000/
SOVER, LDA OVADR; SUB (ROVER+1000; JAN *+2; WAIT 47
   JPL I (ISTK; LDA I (OVLAY; SHA 1; ADD (OVDK
"TSBIN
   STA I (8DKA; LDA (ROVER; STA I (8CADR
   SUB OVADR; COPY CM2 DA SA; STA I (8NWD
   SAA 1; STA I (8FCN; JMP I (8DUMP
"NMACF
   COPY DT SA; LDX (ROVER; SAA 3; JPL I (XDISK; JMP *-1
   AAT 1; LDX (ROV4; JPL I (XDISK; JMP *-1
   JMP 103,B
OVADR, 0
   )FILL
"


%OVERL
%DEFINE OVERLAY  (MACRO)
%ARG1: SYMBOL WHICH IS TO BE SET TO OVERLAY NUMBER

)MCDEF OVERL $A1
$A1 =RQR
   )KILL RQR
RQR=$A1 +1
ROVER/
   ]


%OVERX
%SAVE OVERLAY ON DISK  (MACRO)

"NMACF
)MCDEF OVERX $A1
GLOB=*
$A1 =*-ROVER
OVADR/ GLOB
)KILL GLOB
OVLAY/ RQR-1
OVLAX/ RQR-1
SYSOV/ RQR-1
   )WRTM
   )WRITE $A1
   )SOVER
   ]
"MACF
)MCDEF OVERX $A1
$A1 =*-ROVER
)9MOVE ROVER VOR VORS
GLOB=VOR
)KILL VOR
VOR=GLOB+VORS
)KILL GLOB
OVLAY/ RQR-1
OVLAX/ RQR-1
SYSOV/ RQR-1
)WRTM
)WRITE $A1
   ]
"


"TSBIN

%HARDWARE BOOTSTRAP

HLOAD, RCLR DD; IOT ACT SKA REA; JMP *-1
   SAD SHR 10; IOT ACT SKA REA; JMP *-1
   RADD DA SD; STA I HCORA; MIN HCORA
   MIN HCNT; LDA HCNT; SUB HSIZ; JAN HLOAD
   JMP I HSTRT
HCNT, 0
HCORA, TBOOT
HSIZ, 8TBE-TBOOT
HSTRT, TBOOT
   )PCL HLOAD
HLDE=*

%TSS LOADER

TBOOT, JPL 8WORD; SUB (125252; JAF TBOOT
TBLP, JPL 8WORD; AAA 1; JAF TB1
   JPL 8WORD; AAA 1; JAF *+2; WAIT
   JPL 8WORD; COPY DX SA; JMP 0,X
TB1,  AAA -1; STA HCORE; STA HCORX
   JPL 8WORD; STA HDKA
   JPL 8WORD; STA HSIZ; STZ HCNT; STZ HCHK
TB2,  JPL 8WORD; STA I HCORE; ADD HCHK; STA HCHK
   MIN HCORE; MIN HCNT; LDA HCNT; SUB HSIZ; JAN TB2
   JPL 8WORD; SUB HCHK; JAZ *+2; WAIT 377
   LDA HDKA; AAA 1; JAZ TBLP
TB3,  LDX HCORX; LDT HDKA; JPL HDKOP; JMP TBLP
HCORE, 0
HCORX, 0
HDKA, 0
HCNT, 0
HCHK, 0
HSIZ, 0
   )FILL
   )PCL TBOOT

8WORD, RCLR DD; IOT ACT SKA REA; JMP *-1; SAD SHR 10
   IOT ACT SKA REA; JMP *-1; RADD DA SD
   EXIT
"

"NCR NMACF
HDKOP, IOT SKA DISC; JMP *-1
HDK1, COPY DA SX; IOT LCA; COPY DA ST; IOT LBA
   SAA 3; IOT ACT DISC; IOT SKA DISC; JMP *-1
   IOT RST; AND (130160; BSET BCM 170 DA; JAF HDK1
HDK2, COPY DA SX; ADD (400; IOT LCA
   COPY DA ST AD1; IOT LBA
   SAA 3; IOT ACT DISC; IOT SKA DISC; JMP *-1
   IOT RST; AND (130160; BSET BCM 170 DA; JAF HDK2; EXIT
   )FILL
   )PCL HDKOP
"

"CDC NMACF
8DKLM=616
HDKOP, IOT SKA DISC; JMP *-1
   COPY DA ST; SAT 0; BLDA 150 DA; BSTA 170 DT
   AND (17777; COPY DD SA; COPY CM2 DA SA; MPY (52525
   BSKP ONE 160 DA; JMP *+3; ADD (125252; JMP *+3
   BSKP ZRO 170 DA; ADD (52525; SHA ZIN SHR 2
   SHT ZIN SHR 5; RORA DT SA; SHT 5
   MPY (14; RSUB DD SA; RADD DD SD; RADD DT SD
   COPY DA ST; BSET ZRO 170 DA; SHA SHR 6
   SUB (8DKLM; JAN *+2; WAIT 37
HDK1, COPY DA ST; IOT LBA; COPY DA SX; IOT LCA
   LDA (1401; IOT LMR; IOT ACT DISC
   IOT SKA DISC; JMP *-1; IOT RST; JMP HDK1
   EXIT
   )FILL
   )PCL HDKOP
"

8TBE=*

"TSBIN

8FCN, 0  %FUNCTION
      %0: PRODUCE HARDWARE BOOTSTRAP AND TSS LOADER
      %1: PRODUCE TSS LOAD BLOCK

8CADR, 0 %-1: TRAILER
      %ELSE CORE ADDRESS OF LOAD BLOCK

8DKA, 0  %-1: IGNORED
      %ELSE DISK ADDRESS OF BINARY LOAD BLOCK
      %OR START ADDRESS

8NWD, 0  %NUMBER OF WORDS IN BINARY BLOCK


%8DUMP
%DUMP ONTO TSS BINARY FORMAT TAPE
%RETURNS TO MAC VIA JMP 103,B

8DUMP, LDA 8FCN; JAF 8D1; SAX -177; SAA 0
   IOT ACT SKA PFA; JMP *-1; JNC *-2
   LDA (HLOAD; JPL 8NOUT
   SAA ##/; IOT ACT SKA PFA; JMP *-1
   LDA (HLOAD; STA 8CORE
8LOOP, LDA I 8CORE; JPL 8NOUT
   SAA 15; IOT ACT SKA PFA; JMP *-1
   SAA 12; IOT ACT SKA PFA; JMP *-1
   MIN 8CORE; LDA 8CORE; SUB (HLDE; JAN 8LOOP
   LDA (HLOAD; JPL 8NOUT
   SAA ##!; IOT ACT SKA PFA; JMP *-1
8LP1, LDA I 8CORE; JPL 8WOUT
   MIN 8CORE; LDA 8CORE; SUB (8TBE; JAN 8LP1
   LDA (125252; JPL 8WOUT; JMP 103,B
8D1,  LDA 8CADR; STA 8CORE; AAA 1; JAF 8D2
   SAA -1; JPL 8WOUT
   LDA 8DKA; JPL 8WOUT; JPL 8WOUT; SAX -177; SAA 0
   IOT ACT SKA PFA; JMP *-1; JNC *-2; JMP 103,B
8D2,  LDA 8CORE; JPL 8WOUT; LDA 8DKA; JPL 8WOUT
   LDA 8NWD; JPL 8WOUT; STZ 8CNT; STZ 8CHK
8LP2, LDA I 8CORE; JPL 8WOUT; ADD 8CHK; STA 8CHK
   MIN 8CORE; MIN 8CNT; LDA 8CNT; SUB 8NWD; JAN 8LP2
   LDA 8CHK; JPL 8WOUT; JMP 103,B

8CORE, 0
8CNT, 0
8CHK, 0

8WOUT, SAD ZIN SHR 10; IOT ACT SKA PFA; JMP *-1
   SAD 10; IOT ACT SKA PFA; JMP *-1; EXIT

8NOUT, COPY DD SA; SAA 0
   SAD 1; AAA ##0; IOT SKA ACT PFA; JMP *-1; SAX -5
   SAA 0; SAD 3; AAA ##0; IOT SKA ACT PFA; JMP *-1
   JNC *-5; EXIT
   )FILL
   )PCL 8DUMP
ARPA=*
8FCN/ 0
   )8DUMP
ARPA/
   )KILL ARPA
"

"CDC NMACF
%
%DISK RESTART ROUTINE
%

DKRST, SAT 2; LDX (RDKOP; JPL RDKOP; JMP I (DBOOT
   )FILL

RDKOP, IOT SKA DISC; JMP *-1
   COPY DA ST; SAT 0; BLDA 150 DA; BSTA 170 DT
   AND (17777; COPY DD SA; COPY CM2 DA SA; MPY (52525
   BSKP ONE 160 DA; JMP *+3; ADD (125252; JMP *+3
   BSKP ZRO 170 DA; ADD (52525; SHA ZIN SHR 2
   SHT ZIN SHR 5; RORA DT SA; SHT 5
   MPY (14; RSUB DD SA; RADD DD SD; RADD DT SD
   COPY DA ST; BSET ZRO 170 DA; SHA SHR 6
   SUB (8DKLM; JAN *+2; WAIT 37
RDK1, COPY DA ST; IOT LBA; COPY DA SX; IOT LCA
   LDA (400; IOT LMR; IOT ACT DISC
   IOT SKA DISC; JMP *-1; IOT RST; JMP RDK1
   EXIT
   )FILL
   )PCL RDKOP

DKRE=*-DKRST

DBOOT, STZ DBCOR; LDA (CORLD; STA DBDKA
DBLOP, LDX DBCOR; LDT DBDKA; JPL RDKOP
   MIN DBDKA; LDA (400; ADD DBCOR; STA DBCOR
   SUB (MSTRT; JAN DBLOP; JMP I (301
DBCOR, 0
DBDKA, 0
   )FILL
   )PCL DBOOT

DBOE=*-RDKOP
"

"TSBIN
CDBIN
"
"NCR
)KILL CDBIN
"

"CDBIN

8FCN/ 1
8CADR/ DKRST
8DKA/ 0
8NWD/ DKRE
   )8DUMP

8FCN/ 1
8CADR/ RDKOP
8DKA/ 2
8NWD/ DBOE
   )8DUMP
"


BLUES=ROVER+1000
&L
   OVERL OV1


%REGS
%LIST THE CONTENTS OF THE REGISTER BLOCK
%RETURN

   PROGM

   GOVER OV1,R1,REGS
   DATA CNT,1
R1,   ENTER
   COPY DB SX; STZ CNT,B
R2,   LDX (REGM; LDX I CNT,B,X; JPL I (MSG
"NN10
   LDX (RBLOK; LDA I CNT,B,X
"N10
   LDA CNT,B; ORA (IRR 10; EXR SA
"
   SAT 10; JPL I (IOUT
   JPL I (CRLF; MIN CNT,B; LDA CNT,B
"NN10
   AAA -11; JAN R2
"N10
   AAA -10; JAN R2
"
   MIN LREG,B; RET
"NN10
REGM, MS1; MS2; MS3; MS4; MS5; MS6; MS7; MS8; MS9
"N10
REGM, MS7; MS5; MS1; MS8; MS6; MS4; MS3; MS2
"
MS1,  'P = \ '
MS2,  'X = \ '
MS3,  'T = \ '
MS4,  'A = \ '
MS5,  'D = \ '
MS6,  'L = \ '
MS7,  'STS = \ '
MS8,  'B = \ '
"NN10
MS9,  'MPR = \ '
"

   )FILL
   )PCL REGS
   PATCH


%SETX
%SET A REGISTER OR LOCATION TO A SPECIFIED VALUE
%RETURN

   PROGM

   GOVER OV1,S1,SETX
   DATA ADR,1
   DATA PTR,1
   DATA XTR,5
   DATA XTRX,10
S1,   ENTER
   COPY DB SX; STSET PTR,XTR,XTRX,20
   LDT I (CMDLN; LDX PTR,B; SAA 4; JPL I (PCF; JMP SSS
   LDX PTR,B; JPL I (GCD; JMP SF
   SAT ##B; SKP IF DA EQL ST; JMP S4
   LDX PTR,B; JPL I (LEN; SKP IF DD EQL 0; JMP *+3
   SAX 7; JMP S10; SAT 10; JMP S5
S4,   SAT ##D; SKP IF DA EQL ST; JMP S4A
   LDX PTR,B; JPL I (LEN; SKP IF DD EQL 0; JMP *+3
   SAX 4; JMP S10; SAT 12; JMP S5
S4A,  LDX PTR,B; JPL I (WCI; JMP SF; SAT 10
S5,   LDX PTR,B; JPL I (CSN; JMP S3; AND (77777
   STA ADR,B; COPY DT SA; COPY DX SA; JPL I (CKMEM; JMP SF
S2,   LDT I (CMDLN; SAA 5; JPL I (PCF; JMP SSS; STA I ADR,B
SSS,  MIN LREG,B; JMP SF
S3,   LDX PTR,B; JPL I (GCI; JMP SF; AND (177; SAX -1
   SAT ##P; SKP IF DA UEQ ST; SAX 0
   SAT ##X; SKP IF DA UEQ ST; SAX 1
   SAT ##T; SKP IF DA UEQ ST; SAX 2
   SAT ##A; SKP IF DA UEQ ST; SAX 3
   SAT ##D; SKP IF DA UEQ ST; SAX 4
   SAT ##L; SKP IF DA UEQ ST; SAX 5
   SAT ##B; SKP IF DA UEQ ST; SAX 7; JXN SF
"NN10
S10,  LDA (RBLOK; RADD DA SX; STA ADR,B; JMP S2
"N10
%FIX, 2026-10-08: THE 1973 TEXT READ THE TABLE WITH "LDA SSXT,X". THAT IS
%THE (X)+D ADDRESSING MODE, WHOSE 8-BIT DISPLACEMENT CANNOT HOLD THE TABLE
%ADDRESS, SO IT LOADED A PAGE-0 WORD (ZERO) AND THE IRW WROTE THE STATUS
%REGISTER (REGISTER FIELD 0) INSTEAD OF THE NAMED ONE: SET-REGISTER A 1234
%GAVE STS=234. THE TABLE ALSO HAD NO STS SLOT AT INDEX 6, SO B (INDEX 7)
%READ PAST ITS END. NOW THE TABLE IS REACHED THROUGH THE POINTER WORD SSXTP
%WITH INDIRECT INDEXED ADDRESSING, ((P)+D)+X, AND HOLDS COMPLETE IRW WORDS
%FOR LEVEL 1 (THE USER PROGRAM), SO THE ORA AND ITS LITERAL ARE GONE. SAME
%WORD COUNT AS THE ORIGINAL BLOCK. THIS N10 BLOCK IS NOT ASSEMBLED BY THE
%1978 NORD-1 (NN10) BUILDS. SEE docs/TSS-COMMAND-VALIDATION.md PART III 4.
S10,  LDA I SSXTP,X; STA ADR,B
   LDT I (CMDLN; SAA 5; JPL I (PCF; JMP SSS
   LDX ADR,B; EXR SX; JMP SSS
SSXTP, SSXT
SSXT, IRW 10 DP; IRW 10 DX; IRW 10 DT; IRW 10 DA
   IRW 10 DD; IRW 10 DL; IRW 10; IRW 10 DB
"
SF,   RET
   )FILL
   )PCL SETX


%CMOD
%CHANGE COMMAND I/O DEVICE NUMBERS
%RETURN

   PROGM

   GOVER OV1,C1,CMOD
   DATA PTR,1
   DATA XTR,5
   DATA XTRX,20
   DATA F1,1

C1,   ENTER
   COPY DB SX; STSET PTR,XTR,XTRX,40
   LDA I (IDEV; COPY DT SA; AAA -100; JAN C1A
   STZ I (IDEV; JPL I (CFILE; JMP *+1; STT I (IDEV
C1A,  LDA I (ODEV; COPY DT SA; AAA -100; JAN C2
   STZ I (ODEV; JPL I (CFILE; JMP *+1; STT I (ODEV
C2,   LDT I (CMDLN; LDX PTR,B; SAA 6; JPL I (PCF; JMP CSS
C3,   LDX PTR,B; SAT 1; LDA (MTP4; JPL I (OPEN; JMP CFX; STA F1,B
   LDX PTR,B; JPL I (STRST
   LDT I (CMDLN; LDX PTR,B; SAA 7; JPL I (PCF; JMP CSS
C5,   LDX PTR,B; SAT 0; LDA (MTP4; JPL I (OPEN; JMP CFX
   STA I (ODEV; LDA F1,B; STA I (IDEV
CSS,  MIN LREG,B
CFF,  RET
CFX,  JPL I (ERMSG; JMP CSS
   )FILL
   )PCL CMOD


%MDRIV
%MAG. TAPE DRIVER MONITOR CALL
%REGISTERS AS SHOWN BELOW
%RETURN A,X
%A,X: AS SHOWN BELOW
%FAILURE RETURN X
%X: AS SHOWN BELOW

   PROGM

   GOVER OV1,M1,MDRIV
   DATA MAREG,1
   DATA MDREG,1
   DATA MTREG,1
   DATA MXREG,1

M1,   ENTER
   COPY DB SX; LDA TREG,B; AAA -10; JAP M2
   LDA AREG,B; COPY DX SA; ADD XREG,B; COPY DT SA
   JPL I (CKMEM; JMP I (TRAP; SAA 40; MCL PIE
M2,   LDA AREG,B; LDX XREG,B; LDT TREG,B
   JPL MAGTP; JMP MFF; JMP *-2
MSS,  MIN LREG,B; STA AREG,B
MFF,  STX XREG,B; SAA 40; MST PIE; RET


"NN10
% M A G . T A P E   T R A N S F E R   R O U T I N E
%
% CALLING SEQUENCE:
%  JPL I (MAGTP
%  JMP   ERROR % ERROR EXIT
%  JMP   FINIS % FINISHED EXIT
%
% CALLED WITH:
%  X - NUMBER OF WORDS OR NUMBER OF FILE MARKS TO SKIP IN HIGH SPEED
%  T - FUNCTION CODE
%  0-READ ONE RECORD
%  1-WRITE ONE RECORD
%     10-ADVANCE TO EOF
%     11-REVERSE TO EOF
%     12-WRITE EOF
%     13-REWIND
%     14-WRITE SKIP
%     15-BACKSPACE ONE RECORD
%     16-HIGH SPEED FORWARD
%     17-HIGH SPEED REVERSE
%     20-READ STATUS
%  A - CORE ADDRESS
%  D - UNIT NUMBER (BIT 1-0) AND PARITY (BIT 2)
%  B - POINTER TO STACK ENTRY
%
% RETURN INFORMATION:
%   ERROR EXIT: X -HARDWARE STATUS
%   BUSY EXIT: THE ROUTINE MUST BE CALLED AGAIN AT ONCE OR AFTER
%	 INTERRUPT WITH X,T,A AND D UNCHANGED
%   FINISHED EXIT: X-HARDWARE STATUS	A-CORE ADDRESS
%
%   B IS NOT USED BY THE ROUTINE
%
% MAG. TAPE INSTRUCTION DISPLACEMENTS:

TC=MT+1
LTCA=SNI+TC % LOAD CORE ADDRESS
LTWC=ACT+TC % LOAD WORD COUNT
RTCA=SKA+TC % READ CORE ADDRESS
RTST=ACT+SKA+TC  % READ STATUS
RSET= ACT+SKA+PIN+TC %RESET CONTROLLER.
XRESE=ACT+SKA+PIN+TC  % RESET CONTROLLER
MSTOP=SKA+PIN+TC

% HDEV,B MUST HOLD THE HARDWARE DEV. NUMBER (THE SNI DEV. NUMBER)

MAGTP, STA  MAREG,B    % SAVE A,T AND X
   STT   MTREG,B
   STX   MXREG,B
MTSK1, IOT  SKA MT   % LAST TRANSFER FINISHED ?
   JMP   MTEST % NO, POSSIBLE ERROR
   JXZ   MTRS1 % YES, NEW TRANSFER ?
   SAA   3  % YES, TEST FOR NEW UNIT
   RAND  SD DA % A: UNIT
   SUB   MDREG,B    % NEW UNIT SELECTED ?
   JAZ   MTRS1 % NO
   ADD   MDREG,B    % YES, SAVE NEW UNIT
   STA   MDREG,B
   SHA   13 % UNIT TO CORRECT PART OF MODUS WORD
MTACT, IOT  ACT MT   % SELECT UNIT
MTCL1, JMP  *+1   % RESET CONTROLLER
"HP NN10
*-1/  IOT RSET
"NN10
MTRS1, IOT  RTST  % READ STATUS
   JMP   *1 % NO SKIP TEST
MTSTA, COPY SA DX % X: STATUS
   BSKP  ONE 160 DX  % NO, FIRST CALL. UNIT READY ?
   EXIT     % NO, ERROR EXIT WITH STATUS IN X
   COPY  ST DA % YES, A:FUNCTION X: STATUS
   JAN   MILLC % ILLEGAL FUNCTION IF A<0
   AAA   -20
   JAZ   MRSTA % READ STATUS IF T=20
   JAP   MILLC % ILLEGAL FUNCTION IF T>20
   AAA   2
   JAP   MHSPE % HIGH SPEED IF T=16,17
   LDA   MXREG,B
   JAZ   MTFIN % FINISHED ?
   SAX   0  % NO
MTMOD, SWAP ST DX
   LDX   I,X (MMOD   % X: HARDWARE FUNCTION
   LDA   MAREG,B
MTLTC, IOT  LTCA  % LOAD CORE ADDRESS
   LDA   MXREG,B
MTLTW, IOT  LTWC  % LOAD WORD COUNT
MTSTR, SAA  7
   RAND  SD DA % A: UNIT & PARITY
   SHA   13 % TO CORRECT PART OF MODUS
   RADD  SX DA % ADD HARWARE FUNCTION
MTACP, IOT  ACT PIN MT  % START TRANSFER
   LDA   MAREG,B
   COPY  ST DX
   LDT   MTREG,B
   EXIT  AD1   % BUST EXIT

% TRANSFER NOT COMPLETED. TEST FOR ERRORS

MTEST, IOT  RTST  % READ STATUS
   JMP   *1 % NO SKIP TEST
MTST1, JMP  *1
"HP NN10
*-1/  IOT MSTOP
"NN10
MTCL2, IOT  RSET         % RESET CONTROLLER
   COPY  SA DX
   EXIT     % ERROR EXIT WITH HARDWARE STATUS IN X

% ILLEGAL CODE

MILLC, SAX  -1
   LDA   MAREG,B
   EXIT     % ERROR EXIT WITH X=0

% TRANSFER FINISHED. READ CORE ADDRESS. X: HARDWARE STATUS

MTFIN, LDA  MVERR
   RAND  SX DA % MASK OUT ERROR BITS
   JAZ   *2
   EXIT     % ERROR EXIT
   SAA   13
   SKP   IF DA EQL ST
   JMP   MTRTC
   BSKP  ONE 100 DX  % REWIND COMPLETED. TEST LOAD POINT BIT
   EXIT     % ERROR EXIT IF NOT SET
MTRTC, IOT  RTCA  % READ CORE ADDRESS
MRSTA, RINC DL
   EXIT  AD1   % FINISHED EXIT

% HIGH SPEED FUNCTIONS (T=16,17)
% CONTINUE SEARCH IF X<0
% STOP TAPE IF X=0
% FINISHED IF X=-1

MHSPE, LDX  MXREG,B
   JXZ   MTST2 % STOP TAPE
   AAX   1
   JXZ   MTRS2 % FINISHED, READ STATUS
   AAX   -2
   JMP   MTMOD % CONTINUE SEARCH

MTST2, IOT  STOP  % STOP TAPE
   RDCR  DX % X=-1
   COPY  SX DT
   SAX   0  % NO FUNCTION
   JMP   MTSTR % WAIT FOR TAPE TO STOP

MTRS2, IOT  RTST  % READ STATUS
   JMP   *1
   JMP   MTFIN

   )FILL

MVERR, 264	  % ERROR BITS

% TABLE WITH HARWARE FUNCTIONS

MMOD, 1     % 0-READ
   2	  % 1- WRITE
   -1	  % 2
   -1	  % 3
   -1	  % 4
   -1	  % 5
   -1	  % 6
   -1	  % 7
   4	  % 10-ADV. TO EOF
   10	  % 11-REV. TO EOF
   20	  % 12-WRITE EOF
   40	  % 13-REWIND
   100      % 14-WRITE SKIP (ERASE)
   200      % 15-BACKSPACE
   400      % 16-HIGH SPEED FORWARD
   1000     % 17-HIGH SPEED REVERSE

   )KILL XRESE MT TC LTCA LTWC RTCA RTST STOP RSET
   )PCL MDRIV
"N10
MAGTP, EXIT AD1
   )PCL MDRIV
"



   OVERX QOV1

   OVERL OV1A


%USARR
%RETURN A STRING DESCRIPTOR TO THE ITH USER NAME
%X = STRING DESCRIPTOR
%A = INDEX (INDEXED FROM ONE)
%FAILURE RETURN IF INDEX IS OUT OF RANGE

   PROGM

   GOVER OV1A,U0,USARR
   DATA LEN1,1
   DATA CNT,1
   DATA CNTX,1
U0,   ENTER
   COPY DB SX; JPL I (LOCK; JAN UFF; JAZ UFF; AAA -101; JAP UFF
   LDA AREG,B; RCLR DD; AAA -1
   SAD SHR 5; AAA 1; STA CNT,B; SAA 0; SAD 5; STA CNTX,B
   SAA 0; LDT CNT,B; JPL I (RUTBL; JMP *-1
   LDA CNTX,B; SHA 3; ADD (USTBL; COPY DX SA
   LDT (USTRG; SAA 7; JPL I (BCOPY; STZ I (USTBL-4
   LDX XREG,B; SAA 16; SAD SHR 20; JPL I (SETUP
   LDX XREG,B; SAA 16; SAD SHR 20; JPL I (SETW
U1,   LDX XREG,B; JPL I (GCD; JMP U2
   SKP IF DA UEQ 0; JMP U1
   LDX XREG,B; JPL I (WCI; JPL I (FTLER
U2,   LDX XREG,B; JPL I (LEN; COPY DT SD; STT LEN1,B
   LDX XREG,B; LDT (USTRG; JPL I (SETUP
   LDA LEN1,B; JAZ USS; SAD SHR 20
   LDX XREG,B; JPL I (SETW
USS,  MIN LREG,B
UFF,  JPL I (UNLOK; RET
   )FILL
   )PCL USARR
   PATCH

%GBARR
%RETURN A STRING DESCRIPTOR TO THE ITH FILE
%X = STRING DESCRIPTOR
%A = INDEX (INDEXED FROM ONE)
%FAILURE RETURN IF INDEX IS OUT OF RANGE

   PROGM

   GOVER OV1A,G1,GBARR
   DATA XTR,5
   DATA PTR,1
   DATA LEN1,1
   DATA MBUF,40

G1,   ENTER
   COPY DB SX; LDA I (TUSNO; STA MBUF,B
   SAT MBUF; RADD DT SB; RCLR DD; LDX AREG,B; AAX -1
   SAA -1; JPL I (ROBJ; JMP GFF
   SAX XTR; RADD DX SB; STX PTR,B; AAT 1
   SAA 20; SAD SHR 20; JPL I (SETUP
   LDX PTR,B; SAA 20; SAD SHR 20; JPL I (SETW
   LDX XREG,B; LDT (USTRG; SAA 25; SAD SHR 20; JPL I (SETUP
G2,   LDX PTR,B; JPL I (GCI; JMP G3; JAZ G3
   LDX XREG,B; JPL I (WCI; JPL I (FTLER; JMP G2
G3,   SAA ##-; LDX XREG,B; JPL I (WCI; JPL I (FTLER
   LDX PTR,B; SAT MBUF+11; RADD DT SB
   SAA 4; SAD SHR 20; JPL I (SETUP
   LDX PTR,B; SAA 4; SAD SHR 20; JPL I (SETW
G4,   LDX PTR,B; JPL I (GCI; JMP GSS; JAZ GSS
   LDX XREG,B; JPL I (WCI; JPL I (FTLER; JMP G4
GSS,  MIN LREG,B; RET
GFF,  JAN GF1; AAA -11; JAZ *+2; JPL I (FTLER; JMP GSS+1
GF1,  LDX XREG,B; LDT (USTRG; SAA 25
   SAD SHR 20; JPL I (SETUP; JMP GSS
   )FILL
   )PCL GBARR


%ABLKP
%ABBREVIATION LOOKUP ROUTINE
%X = GIVEN STRING
%T = STRING ARRAY FUNCTION
%A = POINTER TO STRING ARRAY
%D = INDEX IN ARRAY WHERE SEARCH SHOULD START
%RETURN A
%A = INDEX IN THE STRING ARRAY OF THE MATCH
%WITH THE GIVEN STRING
%FRETURN (A,T)
%A = (-1 IF NO MATCH, -2 IF AMBIGUOUS)
%T = INDEX OF FIRST AMBIGUOUS ENTRY IF A=-2

   PROGM

   GOVER OV1A,A1,ABLKP
   DATA XTR,5
   DATA PTR,1
   DATA FOUND,1
   DATA N,1
   DATA II,1
   DATA QSTR,5
   DATA QPTR,1
   DATA XX,1
   DATA PART,1
   DATA CSTR,5
   DATA CPTR,1
   DATA OSTR,5
   DATA OPTR,1
   DATA CLEN,1
   DATA OLEN,1
   DATA KLUDG,1

A1,   ENTER
   COPY DB SX; SAT XTR; RADD DT SB; STT PTR,B
   LDX XREG,B; SAA 5; JPL I (BCOPY
   SAX QSTR; RADD DX SB; STX QPTR,B
   SAX OSTR; RADD DX SB; STX OPTR,B
   SAX CSTR; RADD DX SB; STX CPTR,B
   STZ FOUND,B; LDA DREG,B; AAA -1; STA II,B
A2,   MIN II,B; LDT AREG,B; LDA II,B; LDX QPTR,B
   JPL I TREG,B; JMP A8
   LDX QPTR,B; JPL I (LEN; SKP IF DD UEQ 0; JMP A7
   LDX PTR,B; LDT QPTR,B; JPL I (STEQL; JMP A3
   SAA 1; STA FOUND,B
   LDA II,B; STA XX,B; JMP A8
A3,   STZ PART,B
A4,   STZ KLUDG,B; MIN PART,B; LDA PART,B; LDT CPTR,B; LDX QPTR,B
   JPL I (GPART; JMP A5; LDT OPTR,B; LDX PTR,B; LDA PART,B
   JPL I (GPART; JMP A6; LDX CPTR,B; JPL I (LEN
   COPY DA SD; STA CLEN,B; LDX OPTR,B; JPL I (LEN
   COPY DA SD; STA OLEN,B; JAZ A4; LDA CLEN,B; JAZ A7
   LDX OPTR,B; LDT CPTR,B; JPL I (SBSTR; JMP A7A; JMP A4
A5,   LDT OPTR,B; LDX PTR,B; LDA PART,B
   JPL I (GPART; JMP A6; JMP A7
A6,   LDA FOUND,B; JAF *+3; LDA II,B; STA XX,B; MIN FOUND,B
A7,   STZ PART,B; JMP A2
A7A,  MIN KLUDG,B; LDA KLUDG,B; ADD PART,B; JMP A4+3
A8,   LDA FOUND,B; JAZ AF1; AAA -1; JAF AMB
   LDA XX,B; STA AREG,B; MIN LREG,B; JMP AFF
AF1,  SAA -1; STA AREG,B; JMP AFF
AMB,  SAA -2; STA AREG,B; LDA XX,B; STA TREG,B
AFF,  RET
   )FILL
   )PCL ABLKP
   PATCH


%GPART
%RETURN THE ITH PART OF THE FIRST STRING IN THE
%SECOND STRING
%FAILURE RETURN IF THE SPECIFIED PART DOES NOT EXIST
%X = FIRST STRING
%T = SECOND STRING
%A = PART

   PROGM

   GOVER OV1A,G1,GPART
   DATA XTR1,5
   DATA PTR1,1
   DATA IPART,1
   DATA XLEN,1
   DATA CLEN,1
   DATA LEN1,1
   DATA CHR,1

SEPCH=##-

G1,   ENTER
   COPY DB SX; SAT XTR1; RADD DT SB; STT PTR1,B
   LDX XREG,B; SAA 5; JPL I (BCOPY
   LDX XREG,B; LDT TREG,B; SAA 5; JPL I (BCOPY
   STZ IPART,B; LDX PTR1,B; JPL I (LEN
   COPY DA SD; STA XLEN,B; STA CLEN,B
G2,   LDX PTR1,B; JPL I (GCI; JMP G3; SAT SEPCH
   SKP IF DA EQL ST; JMP G2; LDX PTR1,B
   JPL I (LEN; COPY DA SD AD1; STA LEN1,B; JMP G4
G3,   STZ LEN1,B
G4,   MIN IPART,B; LDA IPART,B; LDT AREG,B
   SKP IF DA UEQ ST; JMP G5
   LDA LEN1,B; JAZ GFF; AAA -1; STA CLEN,B; JMP G2
G5,   LDA XLEN,B; SUB CLEN,B; SAD ZIN SHR 20
   LDX TREG,B; JPL I (SETR
   LDA XLEN,B; SUB LEN1,B; SAD ZIN SHR 20
   LDX TREG,B; JPL I (SETW; MIN LREG,B
GFF,  RET
   )FILL
   )PCL GPART
   PATCH


%SBSTR
%RETURN IF THE FIRST STRING IS A LEFT JUSTIFIED
%SUBSET OF THE SECOND STRING, ELSE
%FAILURE RETURN
%X = STRING ONE
%T = STRING TWO

   PROGM

   GOVER OV1A,S1,SBSTR
   DATA XTR1,5
   DATA PTR1,1
   DATA XTR2,5
   DATA PTR2,1
   DATA CHR,1

S1,   ENTER
   COPY DB SX; SAT XTR1; RADD DT SB; STT PTR1,B
   LDX XREG,B; SAA 5; JPL I (BCOPY
   SAT XTR2; RADD DT SB; STT PTR2,B
   LDX TREG,B; SAA 5; JPL I (BCOPY
S2,   LDX PTR1,B; JPL I (GCI; JMP SSS; STA CHR,B
   LDX PTR2,B; JPL I (GCI; JMP SFF; SUB CHR,B
   JAF SFF; JMP S2
SSS,  MIN LREG,B
SFF,  RET
   )FILL
   )PCL SBSTR
   PATCH


%STEQL
%RETURN IF THE GIVEN STRINGS ARE THE SAME ELSE
%FAILURE RETURN
%X = FIRST STRING
%T = SECOND STRING

   PROGM

   GOVER OV1A,S1,STEQL
   DATA CHR,1
   DATA XTR1,5
   DATA XTR2,5
   DATA PTR1,1
   DATA PTR2,1
S1,   ENTER
   COPY DB SX; SAT XTR1; RADD DT SB; STT PTR1,B
   LDX XREG,B; SAA 5; JPL I (BCOPY
   SAT XTR2; RADD DT SB; STT PTR2,B
   LDX TREG,B; SAA 5; JPL I (BCOPY
S2,   LDX PTR1,B; JPL I (GCI; JMP S3; STA CHR,B
   LDX PTR2,B; JPL I (GCI; JMP SFF; SUB CHR,B
   JAZ S2
SFF,  RET
S3,   LDX PTR2,B; JPL I (GCI; JMP SSS; JMP SFF
SSS,  MIN LREG,B; JMP SFF
   )FILL
   )PCL STEQL
   PATCH


%STARR
%RETURN A STRING DESCRIPTOR TO THE ITH ELEMENT OF THE
%GIVEN ARRAY
%T = POINTER TO ARRAY
%X = STRING DESCRIPTOR
%A = INDEX (INDEXED FROM ONE)
%FAILURE RETURN IF INDEX IS OUT OF RANGE

   PROGM

   GOVER OV1A,S1,STARR
   DATA XTR,5
   DATA PTR,1
   DATA XTRX,1
   DATA LEN1,1
S1,   ENTER
   COPY DB SX; SAX XTR; RADD DX SB; STX PTR,B
   LDA AREG,B; LDT I TREG,B; JAN SFF; JAZ SFF
   SKP IF DT GRE SA; JMP SFF; ADD TREG,B
   COPY DX SA; LDT 0,X; SAA 40; STT XTRX,B; LDX PTR,B
   SAD ZIN SHR 20; JPL I (SETUP; SAA 40
   SAD ZIN SHR 20; LDX PTR,B; JPL I (SETW
S2,   LDX PTR,B; JPL I (GCI; JMP S3; SAT ##\
   SKP IF DA EQL ST; JMP S2
S3,   LDX PTR,B; JPL I (LEN; RINC DD
   SAA 40; RSUB DA SD; STA LEN1,B; SAD ZIN SHR 20
   LDX XREG,B; LDT XTRX,B; JPL I (SETUP
   LDA LEN1,B; SAD ZIN SHR 20; LDX XREG,B; JPL I (SETW
   MIN LREG,B
SFF,  RET
   )FILL
   )PCL STARR
   PATCH


   OVERX QOV1A


   OVERL OV1B

%CIBUF
%CLEAR INPUT BUFFER
%T = DEVICE NUMBER

   PROGM

   GOVER OV1B,C1,FCIB
C1,   ENTER
   COPY DB SX; LDA I (IDEV; AAA -1; JAZ *+4; AAA 1; SKP IF DA UEQ ST
   JMP CIS; COPY DA ST
   AAA -1; JAZ CI2; AAA -1; JAZ CI1; AAA -2
   JAZ CI0; AAA -2; JAZ CI6; AAA -3; JAZ CI9
   AAA -3; JAZ CI12; JMP CI4
CI6,  STZ I (TLFLG; JMP CIS
CI0,  JPL I (CDEV; JMP CIF
   SAT CRDDV; INTDS; JPL I (IBUF; LDA (CTBB
   STA I (CTBE+1; INTEN; JMP CIS
CI1,  JPL I (CDEV; JMP CIF
   SAT READV; INTDS; JPL I (IBUF; INTEN; JMP CIS
CI9,  JPL I (CDEV; JMP CIF; SAT MODIN; INTDS
   JPL I (IBUF; INTEN; JMP CIS
CI12, JPL I (CDEV; JMP CIF; SAT DIABT; JMP CI2+1
CI2,  LDT I (CINF; INTDS; JPL I (IBUF; INTEN
CIS,  SRET
CIF,  SAA 1; STA AREG,B; RET
CI4,  LDA TREG,B; AAA -100; JAN CIS
   LDT TREG,B; JPL I (CFILE; JMP CIF; JMP CIS
   )FILL
   )PCL FCIB
   PATCH


%COBUF
%CLEAR OUTPUT BUFFER
%T = DEVICE NUMBER

   PROGM

   GOVER OV1B,C1,FCOB
C1,   ENTER
   COPY DB SX; LDA I (ODEV; SKP IF DA UEQ ST
   JMP COS; COPY DA ST; JAZ COS
   AAA -14; JAZ CO12; AAA 14
   AAA -1; JAZ CO1; AAA -2; JAZ CO3; AAA -2
   JAZ CO0; AAA -1; JAZ CO6
   AAA -2; JAZ *3; AAA -1; JAZ CO9
   JPL I (CDEV; JMP COF
   SAT SPNCD; INTDS; JPL I (IBUF; INTEN; JMP COS
CO6,  STZ I (TLFLG; JMP COS
CO0,  JPL I (CDEV; JMP COF
CO0A, SAT PNTDV; INTDS; JPL I (IBUF; INTEN; JMP COS
CO9,  JPL I (CDEV; JMP COF; SAT MODOT; JMP CO0A+1
CO12, JPL I (CDEV; JMP COF; SAT DIABT; JMP CO1+1
CO3,  JPL I (CDEV; JMP COF; SAT PNCHD; JMP CO0A+1
CO1,  LDT I (COUTF; AAT NTTY; INTDS; JPL I (IBUF; INTEN
COS,  SRET
COF,  SAA 1; STA AREG,B; RET
CO4,  LDA TREG,B; AAA -100; JAN COS
   LDT TREG,B; JPL I (CFILE; JMP COF; JMP COS
   )FILL
   )PCL FCOB

%FILE
%SEARCH FOR THE GIVEN FILE NAME
%X = FILE NAME
%D = USER NUMBER
%A = INDEX OF FIRST ENTRY TO BE SEARCHED
%T = BUFFER TO RECEIVE SHORT FILE ID (11 WORDS LONG)
%RETURN A
%A = INDEX OF FILE
%FAILURE RETURN (A,T)
%A = (-1 IF NO MATCH, -2 IF AMBIGUOUS)
%T = INDEX OF FIRST AMBIGUOUS ENTRY IF A=-2

   PROGM

   GOVER OV1B,F1,FFILE
   DATA XTR,5
   DATA PTR,1
   DATA INDX,1
   DATA CSTR,5
   DATA CPTR,1
   DATA XTRX,13

F1,   ENTER
   COPY DB SX; SAT CSTR; RADD DT SB; STT CPTR,B
   LDX XREG,B; SAA 5; JPL I (BCOPY
   SAX XTR; RADD DX SB; STX PTR,B; SAT XTRX
   RADD DT SB; SAA 26; SAD SHR 20; JPL I (SETUP
F2,   LDX CPTR,B; JPL I (GCI; JMP F3
   LDX PTR,B; JPL I (WCI; JMP F3; JMP F2
F3,   LDA DREG,B; STA I (TUSNO; STA I TREG,B; LDX PTR,B
   LDT (GBARR; LDA AREG,B; COPY DD SA
   JPL I (ABLKP; JMP FFF; STA AREG,B; AAA -1
   COPY DX SA; RCLR DD; LDT TREG,B; SAA 13; JPL I (ROBJ; JMP FF3
   LDA DREG,B; STA I TREG,B; JMP FSS
FFF,  AAA 2; JAZ FF1; SAA -1; STA AREG,B; JMP FFR
FF1,  SAA -2; STA AREG,B; STT INDX,B; AAT -1
   COPY DX ST; RCLR DD; LDT TREG,B; SAA 13; JPL I (ROBJ
   JMP FF4; JMP FF4+2
FF2,  LDA DREG,B; STA I TREG,B
FSS,  MIN LREG,B
FFR,  RET
FF3,  LDX TREG,B; STZ 1,X; JMP FF2
FF4,  LDX TREG,B; STZ 1,X; LDA DREG,B; STA I TREG,B
   LDA INDX,B; STA TREG,B; JMP FFR
   )FILL
   )PCL FFILE


%HELP
%LIST AVAILABLE COMMANDS
%RETURN

   PROGM

   GOVER OV1B,H1,HELP
   DATA XTR,5
   DATA PTR,1
H1,   ENTER
   COPY DB SX; JPL I (RCMD
   SAX XTR; RADD DX SB; STX PTR,B; RCLR DD
H2,   RINC DD; LDX PTR,B; LDT (SCMD; COPY DA SD
   JPL I (STARR; JMP HS; LDX PTR,B
   JPL I (SOUT; JPL I (CRLF; JMP H2
HS,   SRET
   )FILL
   )PCL HELP
   PATCH


   OVERX QOV1B



   OVERL OV1C


%EDIT
%EDIT A LINE
%X=POINTER TO OLD LINE
%T=POINTER TO NEW LINE
%RETURN
%FRETURN IF LINE ENDS WITH &L

   PROGM

   GOVER OV1C,E1,EDIT

%POINTER TO OLD LINE STRING POINTER
   DATA OLIN,1
%POINTER TO NEW OLD LINE STRING POINTER
   DATA LN,1
%OLD LINE STRING POINTER
   DATA OSTR,5
%NEW OLD LINE STRING POINTER
   DATA XTR,5
%STATE WORD
   DATA STATE,1
%TYPED CHARACTER
   DATA CHR,1
%POINTER TO TEMPORARY OLD LINE POINTER
   DATA TLIN,1
%TEMPORARY OLD LINE POINTER
   DATA TSTR,5
%TEMPORARY STORAGE
   DATA TEMP,1
%NEW OLD LINE
   DATA XTRX,50
%TEMPORARY STRING
   DATA TSTRX,50

%STATE WORD BITS

INSM=0 %INSERT MODE (&E)

E1,   ENTER
   COPY DB SX; SAX OSTR; RADD DX SB
   STX OLIN,B; SAX TSTR; RADD DX SB; STX TLIN,B
   SAX XTR; RADD DX SB; STX LN,B
   LDT OLIN,B; LDX XREG,B; SAA 5; JPL I (BCOPY
   SAT XTRX; RADD DT SB; SAA 120; SAD SHR 20
   LDX LN,B; JPL I (SETUP; STZ STATE,B
   LDX OLIN,B; JPL I (GCI; JMP *+5
   LDX LN,B; JPL I (WCI; JPL I (TRAP; JMP *-6
   LDX TREG,B; RCLR DA; RCLR DD; JPL I (SETR
   LDX TREG,B; RCLR DA; RCLR DD; JPL I (SETW

Q, JPL I (TCI; SAT 40; STA CHR,B
   SKP IF DA LST ST; JMP *+5
   LDX (CTRL; RADD DX SA; LDX 0,X; JMP 0,X
   SAT 177; SKP IF DA UEQ ST; JMP Q

Q1,   LDX TREG,B; JPL I (WCI; JMP ILL
   LDA STATE,B; BSKP ZRO INSM DA; JMP *+4
   LDX LN,B; JPL I (GCI; JMP *+1; LDA CHR,B
   JMP Q

ILL,  SAA 7; JPL I (TCO; JMP Q
ILLD, LDA CHR,B; LDX LN,B; JPL I (WCD; JPL I (FTLER; JMP ILL

%&D - COPY REST OF OLD LINE AND TERMINATE

CTD,  LDX LN,B; JPL I (GCI; JMP CTD0; STA CHR,B
   LDX TREG,B; JPL I (WCI; JMP I (ILLD
   LDA CHR,B; JPL I (TCO; JMP CTD
CTD0, JPL I (CRLF; SRET

%&M - TERMINATE EDIT

CTM,  JPL I (CRLF
   MIN LREG,B; RET

%&L - TERMINATE APPEND (ACTS LIKE &M DURING AN EDIT)

CTL,  LDX TREG,B; JPL I (LEN; SKP IF DD EQL 0; JMP CTL0
CTL1, RET
CTL0, JPL I (CRLF; JMP CTL1

%&A - BACKSPACE ONE CHARACTER

CTA,  LDX TREG,B; JPL I (GCD; JMP I (ILL
   SAA ##^; JPL I (TCO; JMP I (Q
   )FILL

%&W - DELETE PRECEDING WORD

CTW,  LDX TREG,B; JPL I (GCD; JMP I (ILL; JMP CTWX
CTW0, LDX TREG,B; JPL I (GCD; JMP CTWE
CTWX, SAT ## ; SKP IF DA UEQ ST; JMP CTW0
CTW1, LDX TREG,B; JPL I (GCD; JMP CTWE
   SAT ## ; SKP IF DA EQL ST; JMP CTW1
   LDX TREG,B; JPL I (WCI; JPL I (FTLER
CTWE, SAA ##\; JPL I (TCO; JMP I (Q

%&Q - DELETE LINE

CTQ,  LDX TREG,B; JPL I (LEN; SKP IF DD UEQ 0; JMP I (ILL
   LDX TREG,B; RCLR DA; RCLR DD; JPL I (SETW
   LDX LN,B; RCLR DA; RCLR DD; JPL I (SETR
   SAA 137; JPL I (TCO; JPL I (CRLF; JMP I (Q

%&C - COPY CHARACTER FROM OLD LINE

CTC,  LDX LN,B; JPL I (GCI; JMP I (ILL; STA CHR,B
   LDX TREG,B; JPL I (WCI; JMP I (ILLD; LDA CHR,B
   JPL I (TCO; JMP I (Q

%&H - COPY REST OF OLD LINE

CTH,  LDX LN,B; JPL I (GCI; JMP I (ILL; STA CHR,B; JMP CTH1
CTH0, LDX LN,B; JPL I (GCI; JMP I (Q; STA CHR,B
CTH1, LDX TREG,B; JPL I (WCI; JMP I (ILLD; LDA CHR,B
   JPL I (TCO; JMP CTH0
   )FILL

%&K - ERASE PAGE ON DISPLAY

CTK,  SAA 14; SAT 1; JPL I (OUTBT; JMP *+1; JMP I (Q
&L
%&O - COPY OLD LINE UP TO BUT NOT INCLUDING
%NEXT OCCURRENCE OF THE FOLLOWING CHARACTER

CTO,  JPL I (TCI; STA TEMP,B; LDT LN,B; JPL I (SCHR; JPL I (ILL
CTO0, LDX LN,B; JPL I (GCI; JPL I (FTLER; LDT TEMP,B
   STA CHR,B; SKP IF DA EQL ST; JMP *+5
   LDX LN,B; JPL I (WCD; JPL I (FTLER; JMP I (Q
   LDX TREG,B; JPL I (WCI; JPL I (ILLD
   LDA CHR,B; JPL I (TCO; JMP CTO0

%&Z - COPY OLD LINE UP TO AND INCLUDING
%NEXT OCCURRENCE OF THE FOLLOWING CHARACTER

CTZ,  JPL I (TCI; STA TEMP,B; LDT LN,B; JPL I (SCHR; JPL I (ILL
CTZ0, LDX LN,B; JPL I (GCI; JPL I (FTLER; STA CHR,B
   LDX TREG,B; JPL I (WCI; JMP I (ILLD
   LDA CHR,B; JPL I (TCO; LDT TEMP,B
   SKP IF DA EQL ST; JMP CTZ0; JMP I (Q

%&F - COPY REST OF OLD LINE AND TERMINATE BUT DO NOT TYPE IT

CTF,  LDX LN,B; JPL I (GCI; JMP I (CTD0; STA CHR,B
   LDX TREG,B; JPL I (WCI; JMP I (ILLD; JMP CTF

%&P - SKIP UP TO BUT NOT INCLUDING FOLLOWING CHARACTER

CTP,  JPL I (TCI; STA TEMP,B; LDT LN,B; JPL I (SCHR; JMP I (ILL
CTP0, LDX LN,B; JPL I (GCI; JPL I (FTLER; LDT TEMP,B
   SKP IF DA EQL ST; JMP *+5; LDX LN,B
   JPL I (WCD; JPL I (FTLER; JMP I (Q
   SAA ##%; JPL I (TCO; JMP CTP0

%&X - SKIP UP TO AND INCLUDING FOLLOWING CHARACTER

CTX,  JPL I (TCI; STA TEMP,B; LDT LN,B; JPL I (SCHR; JPL I (ILL
CTX0, LDX LN,B; JPL I (GCI; JPL I (FTLER; STA CHR,B
   SAA ##%; JPL I (TCO; LDA CHR,B; LDT TEMP,B
   SKP IF DA EQL ST; JMP CTX0; JMP I (Q

%&S - SKIP ONE CHARACTER FROM OLD LINE

CTS,  LDX LN,B; JPL I (GCI; JMP I (ILL
   SAA ##%; JPL I (TCO; JMP I (Q
   )FILL

%&V - TAKE NEXT CHARATER LITERALLY

CTV,  JPL I (TCI; STA CHR,B; LDX TREG,B
   JPL I (WCI; JMP I (ILL; LDA CHR,B
   SAT 40; SKP IF DA LST ST; JMP CTV0
   SAA ##&; JPL I (TCO; LDA CHR,B; AAA 100
   JPL I (TCO; AAA -100
CTV0, STA CHR,B
   JMP I (Q1+3

%&E - FLIP INSERT MODE

CTE,  LDA STATE,B; BSET BCM INSM DA; STA STATE,B
   BSKP ONE INSM DA; JMP CTE0
   SAA ##<; JPL I (TCO; JMP I (Q
CTE0, SAA ##>; JPL I (TCO; JMP I (Q

   )FILL

%&R - RETYPE FAST

CTR,  SAA 12; JPL I (TCO; LDX LN,B; JPL I (SOUT; JPL I (CRLF
   LDX TREG,B; JPL I (SOUT; JMP I (Q

%&T - RETYPE ALIGNED

CTT,  JPL I (CRLF; LDX TREG,B; JPL I (LEN
   COPY CM1 DA SD; STA TEMP,B
   MIN TEMP,B; JMP *+2; JMP *+4
   SAA ## ; JPL I (TCO; JMP *-5
   LDX LN,B; JPL I (SOUT; JPL I (CRLF
   LDX TREG,B; JPL I (SOUT; JMP I (Q

%&Y - RE-EDIT (COPY REST OF OLD LINE ONTO NEW LINE
%AND EDIT THE RESULT)

CTY,  LDX TLIN,B; SAT TSTRX; RADD DT SB; SAA 120
   SAD ZIN SHR 20; JPL I (SETUP
   LDX TREG,B; JPL I (GCI; JMP *+5
   LDX TLIN,B; JPL I (WCI; JPL I (FTLER; JMP *-6
   LDX LN,B; JPL I (GCI; JMP *+5
