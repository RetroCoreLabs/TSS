   DATA FTYPE,2
   DATA FMISC,4
   DATA FOBJ,1
   DATA FBLK,1
   DATA FDATE,2

MS1,  '\ '

O1,   ENTER
   COPY DB SX; SAX XTR; RADD DX SB; STX PTR,B; SAT XTRX
   RADD DT SB; SAA 60; SAD SHR 20; JPL I (SETUP
   SAX NSTR; RADD DX SB; STX NPTR,B; SAT NSTRX; RADD DT SB
   SAA 25; SAD SHR 20; JPL I (SETUP
   SAX CSTR; RADD DX SB; STX CPTR,B; SAT CSTRX; RADD DT SB
   SAA 16; SAD SHR 20; JPL I (SETUP
   JPL I (WHUSR; STA I (TUSNO; STZ UFLG,B; STZ TFLG,B
O2,   LDX XREG,B; JXZ O3; JPL I (GCI; JMP O4
   LDX PTR,B; JPL I (WCI; JMP I (OF8; JMP O2
O3,   LDX CPTR,B; LDT PTR,B; JPL I (EDIT; JMP *+1
O4,   LDX PTR,B; LDT (STARR; SAA 1; COPY DD SA
   LDA (PDEVS; JPL I (ABLKP; JMP O4A
   SHA 1; ADD (DDEVS; COPY DX SA
   LDA 0,X; STA AREG,B; JMP I (OSS
O4A,  STZ NEWF,B; LDX PTR,B; JPL I (GCI; JMP I (OF8
   SAT ##"; SKP IF DA EQL ST; JMP O5
   SAT -1; STT NEWF,B
   LDX PTR,B; JPL I (GCI; JMP I (OF8
O5,   SAT ##(; SKP IF DA EQL ST; JMP O10
O6,   LDX PTR,B; JPL I (GCI; JMP I (OF4
   SAT ##); SKP IF DA UEQ ST; JMP O7
   LDX CPTR,B; JPL I (WCI; JMP I (OF4; JMP O6
O7,   LDX CPTR,B; JPL I (LEN; SKP IF DD EQL 0; JMP O7A
   SAA 1; STA I (TUSNO; JMP O7B
O7A,  LDX CPTR,B; LDT (USARR; SAA 1; COPY DD SA
   JPL I (ABLKP; JMP I (OF4; STA I (TUSNO
O7B,  SAA -1; STA UFLG,B
O9,   LDX PTR,B; JPL I (GCI; JMP O16
O10,  SAT ##:; SKP IF DA UEQ ST; JMP O13
O11,  LDX NEWF,B; JXZ O12
   SAT ##"; SKP IF DA UEQ ST; JMP O15
O12,  SAT ## ; SKP IF DA UEQ ST; JMP *+6
   SAT ##,; SKP IF DA UEQ ST; JMP *+3
   LDX NPTR,B; JPL I (WCI; JMP I (OF8; JMP O9
   )FILL
O13,  SAA -1; STA TFLG,B; SAT CSTRX; RADD DT SB
   LDX CPTR,B; SAA 4; SAD SHR 20; JPL I (SETUP
O14,  LDX PTR,B; JPL I (GCI; JMP O16
   SAT ##"; SKP IF DA UEQ ST; JMP O15
   LDX CPTR,B; JPL I (WCI; JMP I (OF8; JMP O14
O15,  LDA NEWF,B; JAZ *+2; JMP O17; JMP I (OF8
O16,  LDA NEWF,B; JAP *+2; JMP I (OF8
O17,  LDX CPTR,B; SAA ##\; JPL I (WCI; JMP *+1
O18,  LDA TFLG,B; JAN O19
   LDA AREG,B; JAF *+2; LDA (MS1; COPY DT SA
   LDX CPTR,B; SAA 4; SAD SHR 20; JPL I (SETUP
   LDX CPTR,B; SAA 4; SAD SHR 20; JPL I (SETW
O19,  LDA NEWF,B; JAZ O30
   LDA I (TUSNO; STA USNO,B; SAX FNAME; RADD DX SB
   SAT 0; SAA 22; JPL I (SETB; LDA (400; STA FBLK,B
   LDX PTR,B; SAT FNAME; RADD DT SB
   SAA 20; SAD SHR 20; JPL I (SETUP
O20,  LDX NPTR,B; JPL I (GCI; JMP O21
   LDX PTR,B; JPL I (WCI; JMP OF8; JMP O20
O21,  LDX PTR,B; SAT FTYPE; RADD DT SB
   SAA 4; SAD SHR 20; JPL I (SETUP
O22,  LDX CPTR,B; JPL I (GCI; JMP O23
   SAT ##\; SKP IF DA UEQ ST; JMP O23
   LDX PTR,B; JPL I (WCI; JMP OF8; JMP O22
O23,  SAX USNO; RADD DX SB; SAA 0
   JPL I (CRFIL; JMP OFF; JMP O40
   )FILL
O30,  LDX NPTR,B; SAA ##-; JPL I (WCI; JMP OF8
O31,  LDX CPTR,B; JPL I (GCI; JMP O32
   SAT ##\; SKP IF DA UEQ ST; JMP O32
   LDX NPTR,B; JPL I (WCI; JMP OF8; JMP O31
O32,  LDA I (TUSNO; COPY DD SA; LDX NPTR,B
   SAA 1; SAT USNO; RADD DT SB
   JPL I (FILE; JMP *+2; JMP O40
   LDX UFLG,B; JXN OFX; STA ENUM,B; SAA -1; STA UFLG,B
   SAA 1; STA I (TUSNO; JMP O32
O40,  SAT -1; LDA TREG,B; BSKP ONE 0 DA; SAT 0
   SAA 0; SAX USNO; RADD DX SB; JPL I (OPENF; JMP OFF
   AAA 70; STA AREG,B; AAA -100; MPY (5
   ADD (OFTU; STA XOFT,B
   SAX 2; RCLR DA; RCLR DD; STD I XOFT,B,X
   LDA TREG,B; SAX 4; STA I XOFT,B,X; JAZ O41
   LDA AREG,B; ADD (OFT-100; COPY DX SA
   LDA 0,X; JPL I (OFTX; COPY DX SA
   LDD 22,X; SAX 2; STD I XOFT,B,X
O41,  SAX 0; RCLR DA; RCLR DD; STD I XOFT,B,X
   LDA AREG,B; ADD (OFTBS-100; COPY DX SA
   LDA (400; STA 0,X
OSS,  MIN LREG,B; JMP OFF+1
OF4,  SAA 4; JMP OFF
OF8,  SAA 57; JMP OFF
OFX,  LDA ENUM,B; AAA 1; JAF *+3; SAA 10; JMP OFF; SAA 37
OFF,  STA AREG,B; RET
   )FILL
   )PCL FFOPE


%CFILE
%CLOSE FILE FROM UTILITY
%T = FILE NUMBER (-1 FOR ALL FILES)
%RETURN
%FAILURE RETURN A
%A = ERROR MESSAGE

   PROGM

   GOVER OV2,C1,FCFIL
   DATA CNT,1
   DATA MCNT,1
   DATA OBJ,1
   DATA OBJX,1
   DATA TNUM,1
   DATA TSIZ,1

C1,   ENTER
   COPY DB SX; JPL I (LOCK
   COPY DA ST; JAN C2; AAA -100; JAN C20
   SAT NOFT; SKP IF DA LST ST; JMP CF14
   STA CNT,B; AAA 1; STA MCNT,B; JMP C3
C2,   SAA 1; STA CNT,B; SAA NOFT; STA MCNT,B
C3,   SAA -1; JPL I (RELPG; JMP CFF
C4,   LDA CNT,B; MPY (5; ADD (OFTU; STA OBJ,B
   LDA CNT,B; ADD (OFT; COPY DX SA; STX OBJX,B
   LDA 0,X; JAP C10
   LDA I (IDEV; AAA -100; SUB CNT,B; JAZ C10
   LDA I (ODEV; AAA -100; SUB CNT,B; JAZ C10
   LDX OBJ,B; LDA 4,X; BSKP ZRO DA; JMP C5
   LDA I OBJX,B; JPL I (OFTX; STA OBJX,B
   SAX 22; LDA I OBJX,B,X; SHA SHR 3; STA TNUM,B
   SAX 2; LDD I OBJ,B,X; SAX 22; STD I OBJX,B,X
   SAX 4; LDT I OBJ,B,X; SKP IF DT EQL 0; JMP C5
   SHA SHR 3; COPY CM2 DA SA; ADD TNUM,B; STA TSIZ,B
   JAN C5; JAZ C5; LDA I OBJ,B; SHA SHR 3; AAA 1
   LDX TSIZ,B; LDT CNT,B; AAT 10; JPL I (DLTRK; JMP CFF
C5,   LDX OBJ,B; SAA 5; SAT 0; JPL I (SETB
   LDT CNT,B; AAT 10; JPL I (CLOSE; JMP CFF
C10,  MIN CNT,B; LDA CNT,B; SUB MCNT,B; JAN C4
CSS,  MIN LREG,B; JMP CFF+1
CFF,  STA AREG,B; JPL I (UNLOK; RET
CF14, SAA 16; JMP CFF
C20,  LDT TREG,B; JPL I (CIBUF; JMP *+2; JMP CSS
   JPL I (COBUF; JMP CF14; JMP CSS
   )FILL
   )PCL FCFIL


%CLFC
%CLOSE FILE COMMAND
%CLOSE-FILE FILE NUMBER
%RETURN

   PROGM

   GOVER OV2,C1,CLFC

C1,   ENTER
   COPY DB SX; LDT I (CMDLN; SAA 2; JPL I (PCF; JMP CSS
   COPY DT SA; JPL I (CFILE; JPL I (ERMSG
CSS,  MIN LREG,B
CFF,  RET
   )FILL
   )PCL CLFC


   OVERX QOV2



   OVERL OV2A


%PLACE
%LOAD BINARY PROGRAM
%RETURN T
%T = START ADDRESS

   PROGM

   GOVER OV2A,P1,PLACE

%POINTER TO TEMPORARY STRING
   DATA XTR,5
%POINTER TO STR
   DATA PTR,1
%TEMPORARY STRING
   DATA XTRX,20
%FILE NUMBER
   DATA FNUM,1
%CHECKSUM
   DATA CSUM,1
%GIVEN CHECKSUM
   DATA GCSUM,1
%CORE LOCATION
   DATA CLOC,1
%FIRST CORE LOCATION
   DATA CORL,1
%NUMBER OF CELLS
   DATA CORS,1
%TEMPORARY
   DATA TEMP,1

MS1,  'PROGRAM OUT OF BOUNDS$\ '
MS2,  'CHECKSUM ERROR$\ '

P1,   ENTER
   COPY DB SX; STSET PTR,XTR,XTRX,40
P1B,  LDT I (CMDLN; LDX PTR,B; SAA 1; JPL I (PCF; JMP I (PFF
   LDX PTR,B; LDA (MTP1; SAT 1; JPL I (OPEN
   JMP I (PF3; STA FNUM,B
P1A,  LDX PTR,B; JPL I (STRST
   LDT FNUM,B; JPL I (INBT; JMP I (PF; JAZ *-3; AND (177
   SAT 12; SKP IF DA EQL ST; JMP *-7
P2,   LDT FNUM,B; JPL I (INBT; JMP I (PF; JAZ P2; AND (177; SAT 15
   SKP IF DA UEQ ST; JMP P3; LDX PTR,B
   JPL I (WCI; JMP I (PF; JMP P2
P3,   LDT FNUM,B; JPL I (INBT; JMP I (PF
   LDX PTR,B; SAT 10; JPL I (CSN; JMP I (PF
   LDT (125001; SKP IF DA UEQ ST; JMP P4
   RCLR DA; RCLR DD; LDX PTR,B; JPL I (SETR
   RCLR DA; RCLR DD; LDX PTR,B; JPL I (SETW
   JMP P2
P4,   RCLR DA; RCLR DD; LDX PTR,B; JPL I (SETR
   RCLR DA; RCLR DD; LDX PTR,B; JPL I (SETW
P5,   LDT FNUM,B; JPL I (INBT; JMP I (PF; AND (177; SAT 15
   SKP IF DA UEQ ST; JMP P6; LDX PTR,B
   JPL I (WCI; JMP I (PF; JMP P5
   )FILL
P6,   LDX PTR,B; SAT 10; JPL I (CSN; JMP PF
   STA TREG,B; LDT FNUM,B; JPL I (INBT; JMP I (PF; AND (177
   SAT ##!; SKP IF DA EQL ST; JMP *-6
   LDT FNUM,B; JPL I (INBT; JMP PF; SHA 10; STA CORL,B
   LDT FNUM,B; JPL I (INBT; JMP PF; ADD CORL,B; STA CORL,B
   LDT FNUM,B; JPL I (INBT; JMP PF; SHA 10; STA CORS,B
   LDT FNUM,B; JPL I (INBT; JMP PF; ADD CORS,B; STA CORS,B
   LDA CORL,B; AND (174000; LDT (MSTRT
   SKP IF DA GRE ST; JMP PF1
   COPY DX SA; LDA CORL,B; ADD CORS,B; AAA -1
   COPY DT SA; JPL I (CKMEM; JMP PF1
   LDA CORL,B; STA CLOC,B
   STZ CSUM,B; LDX CORS,B; COPY CM2 DX SX; JMP P7
   )FILL
P7,   LDT FNUM,B; JPL I (INBT; JMP PF; SHA 10; STA TEMP,B
   LDT FNUM,B; JPL I (INBT; JMP PF; ADD TEMP,B; STA I CLOC,B
   ADD CSUM,B; STA CSUM,B; MIN CLOC,B; JNC P7
   LDT FNUM,B; JPL I (INBT; JMP PF; SHA 10; STA GCSUM,B
   LDT FNUM,B; JPL I (INBT; JMP PF; ADD GCSUM,B; STA GCSUM,B
   LDT CSUM,B; SKP IF DA EQL ST
   JMP PF2; JMP PS
PS,   LDT FNUM,B; JPL I (CFILE; JMP PFF; JMP PSS
PSS,  MIN LREG,B
PFF,  RET
PF,   SAA -1; ADD LREG,B; STA LREG,B; JMP PS
PF1,  LDX (MS1; JPL I (MSG; JMP PF
PF2,  LDX (MS2; JMP PF1+1
PF3,  JPL I (ERMSG; JMP PSS
   )FILL
   )PCL PLACE
   PATCH


%MEM
%SET SIZE OF ADDRESS SPACE
%RETURN

   PROGM

   GOVER OV2A,M1,MEM
   DATA M0,1
   DATA II,1
   DATA II2,1
MS1,  'ILLEGAL ADDRESS SPACE$\ '
MSA,  ': READ ONLY$\ '
MSB,  ': READ/WRITE$\ '
MSC,  ': EMPTY$\ '

M1,   ENTER
   COPY DB SX
   LDT I (CMDLN; SAA 10; JPL I (PCF; JMP MS
   STA M0,B; JAZ M2
   LDT I (CMDLN; SAA 11; JPL I (PCF; JMP MS
   COPY DT SA; LDX M0,B; JPL I (CKMEM; JMP MF1
MS,   MIN LREG,B; JMP MF
M2,   STZ II,B
M3,   LDA II,B; SHA 1; STA II2,B
   SAA 1; COPY DD SA; SAX 6; SAT 10
   LDA II,B; SHA 13; ADD (MSTRT; JPL I (SPACE
   LDX (VCTBL; LDA I II2,B,X; JAZ M3C; SHA ZIN SHR 16
   AAA -2; JAF M3B
M3A,  LDX (MSA; JMP M4
M3B,  LDX (MSB; JMP M4
M3C,  LDX (MSC
M4,   JPL I (MSG
   MIN II,B; LDA II,B; AAA -NPGS; JAN M3
   JMP MS
MF,   RET
MF1,  LDX (MS1; JPL I (MSG; JMP MS
   )FILL
   )PCL MEM


   OVERX QOV2A

   OVERL OV3


%OPFC
