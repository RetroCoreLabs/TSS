%OPEN
%OPEN A FILE
%X = POINTER TO FILE NAME (TELETYPE IF X=0)
%A = ADDRESS OF TYPE NAME (ASSUMED TO BE NULL IF A=0)
%T = MODE (0=SEQUENTIAL WRITE,
%	1=SEQUENTIAL READ,
%	2=RANDOM WRITE,
%	3=RANDOM READ)
%RETURN A
%A = FILE NUMBER (INDEXED FROM 100)
%FAILURE RETURN A
%A = ERROR CODE

   PROGM

   GOVER OV2,O1,FFOPE

   DATA PTR,1
   DATA XTR,5
   DATA CPTR,1
   DATA CSTR,5
   DATA NPTR,1
   DATA NSTR,5
   DATA ENUM,1
   DATA XOFT,1
   DATA NEWF,1
